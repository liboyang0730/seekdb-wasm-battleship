e43852d998b264f550325cd69156056204c21a7d65882898c8f61163197795"},{"path":"assets/engine-webkit-051.bin","bytes":262144,"sha256":"57e1f9ba5dc3f9bfce9758e068c43f9b71a3082329934f240e2c218274b57dd2"},{"path":"assets/engine-webkit-052.bin","bytes":262144,"sha256":"67dc0ca269d0d04d1318523a66ed67a8de536be1189d01fa3155410055b7be14"},{"path":"assets/engine-webkit-053.bin","bytes":262144,"sha256":"b0605dcec51267e9229ffa1ba48ab08a585776987f58da7d0982833eb360801c"},{"path":"assets/engine-webkit-054.bin","bytes":262144,"sha256":"6368f725b3a56bec77094436d0fe96dc1f72655967cd9124f6a914cf071ec9c5"},{"path":"assets/engine-webkit-055.bin","bytes":262144,"sha256":"deccd4bab91c195b676e6939ff9d838b2e3f75d2e0319fe568950b41cb9a22ff"},{"path":"assets/engine-webkit-056.bin","bytes":262144,"sha256":"54062572225e625e81942c60d0f0a31c28078025648ba4ef80208648550bfffd"},{"path":"assets/engine-webkit-057.bin","bytes":262144,"sha256":"c78f01255f13d30c5f3b00dd1619a1e0734c75b8127faf27daea34725a7b1f15"},{"path":"assets/engine-webkit-058.bin","bytes":262144,"sha256":"7e172736557bac4191285207c88744bd71d65ce6a8f7afc61b736a80eb0fdb9e"},{"path":"assets/engine-webkit-059.bin","bytes":262144,"sha256":"078b35a7a7de0aa0d7b4af0b37a03b4602764c7f05deaf054a449c86f43402a9"},{"path":"assets/engine-webkit-060.bin","bytes":262144,"sha256":"3c4d8881c1ace96f48ad8b50d1ec2d266fd3f620830b60617350bbba75ce4e93"},{"path":"assets/engine-webkit-061.bin","bytes":262144,"sha256":"f6b8edeb29aba21afdf48bfc339e330c799dea7bcdc7868dcc77c978f0a89be2"},{"path":"assets/engine-webkit-062.bin","bytes":216251,"sha256":"12b88d16917c9f73bec1c29c54d3e6c8d5495a77212d9a0d7d9653465fa8bd7c"}]},"数据库.mjs":{"kind":"module","parts":["import {Database} from ",{"ref":"engine/database.mjs"},";\n\n// 只使用本地 seekdb WebAssembly 引擎；每条 SQL 在同一会话中依次执行。\nexport class NavalDB {\n  #database;\n  #session;\n  #queue = Promise.resolve();\n  #decoder = new TextDecoder();\n  engineVersion = '';\n  onQuery = null;\n\n  static async open(onProgress = () => {}) {\n    if (!globalThis.crossOriginIsolated || typeof SharedArrayBuffer === 'undefined') {\n      throw new Error('请通过“启动游戏.command”打开游戏，本地服务需要启用 COOP/COEP。');\n    }\n    onProgress('正在加载真实 seekdb WebAssembly 引擎…');\n    const instance = new NavalDB();\n    const moduleURL = new URL(",{"ref":"engine/seekdb_wasm_database.mjs"},", import.meta.url);\n    // 与官方 shell 一致，为 Safari 选择 WebKit 引擎构建。\n    const wasmFile = navigator.vendor === 'Apple Computer, Inc.'\n      ? './engine/seekdb_wasm_database.webkit.wasm' : './engine/seekdb_wasm_database.wasm';\n    const wasmURL = wasmFile === './engine/seekdb_wasm_database.webkit.wasm'\n      ? new URL(",{"ref":"engine/seekdb_wasm_database.webkit.wasm"},", import.meta.url)\n      : new URL(",{"ref":"engine/seekdb_wasm_database.wasm"},", import.meta.url);\n    instance.#database = await Database.open({moduleURL, wasmURL, storage: 'opfs'});\n    onProgress('正在连接浏览器内的 seekdb SQL 会话…');\n    instance.#session = await instance.#database.connect();\n    const version = await instance.query('SELECT VERSION() AS version');\n    instance.engineVersion = version.rows[0]?.version ?? 'seekdb WebAssembly';\n    onProgress(`seekdb ${instance.engineVersion} 已就绪`);\n    return instance;\n  }\n\n  query(sql) {\n    const run = async () => {\n      const started = performance.now();\n      let columns = [];\n      const rows = [];\n      try { for await (const event of this.#session.query(sql)) {\n        if (event.kind === 'columns') {\n          columns = event.columns.map(column => this.#decoder.decode(column.name));\n        } else if (event.kind === 'row') {\n          rows.push(Object.fromEntries(event.values.map((value, index) => [\n            columns[index] ?? String(index), value === null ? null : this.#decoder.decode(value),\n          ])));\n        }\n      }\n      const result = {rows, elapsedMs: performance.now() - started};\n      try { this.onQuery?.({sql, ...result}); } catch { /* 记录失败不能更改SQL结果。 */ }\n      return result;\n      } catch (error) {\n        try { this.onQuery?.({sql, rows: [], elapsedMs: performance.now() - started, error: error.message}); } catch { /* 保留原始SQL异常。 */ }\n        throw error;\n      }\n    };\n    const result = this.#queue.then(run);\n    // 单条 SQL 报错后，后续队列仍可继续；错误原样交给调用方。\n    this.#queue = result.catch(() => {});\n    return result;\n  }\n\n  exec(sql) { return this.query(sql); }\n\n  async close() {\n    await this.#queue;\n    await this.#session.close();\n    await this.#database.close();\n  }\n}\n"],"dependencies":["engine/database.mjs","engine/seekdb_wasm_database.mjs","engine/seekdb_wasm_database.wasm","engine/seekdb_wasm_database.webkit.wasm"]},"assets/branding/seekdb-logo.png":{"kind":"asset","data":"","mime":"image/png"},"像素控件.mjs":{"kind":"module","parts":["/* 像素控件只处理展示与键盘操作，库存和解锁判断由主程序传入。 */\nconst brandImages = new Map();\n\n/** 用原生按钮展示武器，不调用系统下拉菜单。 */\nexport function renderWeaponChoices({ container, options = [], value, onChoose }) {\n  if (!container) throw new TypeError('缺少武器选择容器。');\n  const doc = container.ownerDocument;\n  const focusedValue = container.contains(doc.activeElement)\n    ? doc.activeElement.dataset.weaponId : null;\n  container.setAttribute('role', 'radiogroup');\n  if (!container.hasAttribute('aria-label')) container.setAttribute('aria-label', '选择武器');\n  const buttons = options.map(option => {\n    const button = doc.createElement('button');\n    button.type = 'button';\n    button.className = 'weapon-choice-card';\n    button.dataset.weaponId = String(option.value);\n    button.disabled = Boolean(option.disabled);\n    button.setAttribute('role', 'radio');\n    button.setAttribute('aria-checked', String(String(option.value) === String(value)));\n    button.tabIndex = -1;\n    const icon = doc.createElement('canvas');\n    icon.width = 32;\n    icon.height = 32;\n    icon.dataset.pixelIcon = String(option.icon ?? option.value);\n    icon.setAttribute('aria-hidden', 'true');\n    const label = doc.createElement('span');\n    label.className = 'weapon-choice-label';\n    const valueLabel=String(option.label??option.value),separator=valueLabel.lastIndexOf(' · ');\n    if(separator\u003c0)label.textContent=valueLabel;\n    else {\n      const name=doc.createElement('span'),stock=doc.createElement('span');\n      name.className='weapon-choice-name';name.textContent=valueLabel.slice(0,separator);\n      stock.className='weapon-choice-stock';stock.textContent=valueLabel.slice(separator+3);\n      label.append(name,stock);\n    }\n    button.append(icon, label);\n    button.addEventListener('click', () => {\n      // 同步选中反馈，主程序随后可按真实库存重新渲染。\n      for (const item of buttons) {\n        const selected = item === button;\n        item.setAttribute('aria-checked', String(selected));\n        item.tabIndex = selected ? 0 : -1;\n      }\n      onChoose?.(option.value);\n    });\n    button.addEventListener('keydown', event => {\n      const available = buttons.filter(item => !item.disabled);\n      const index = available.indexOf(button);\n      let next;\n      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % available.length;\n      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + available.length) % available.length;\n      if (event.key === 'Home') next = 0;\n      if (event.key === 'End') next = available.length - 1;\n      if (next === undefined || !available.length) return;\n      // 方向键只移焦点，按 Enter 或空格确认，避免意外换装与页面滚动。\n      event.preventDefault();\n      event.stopPropagation();\n      for (const item of buttons) item.tabIndex = item === available[next] ? 0 : -1;\n      available[next].focus({ preventScroll: true });\n    });\n    return button;\n  });\n  const tabStop = buttons.find(button => !button.disabled && button.getAttribute('aria-checked') === 'true')\n    ?? buttons.find(button => !button.disabled);\n  if (tabStop) tabStop.tabIndex = 0;\n  container.replaceChildren(...buttons);\n  if (focusedValue !== null) {\n    const restored = buttons.find(button => !button.disabled && button.dataset.weaponId === focusedValue) ?? tabStop;\n    if (restored) {\n      for (const item of buttons) item.tabIndex = item === restored ? 0 : -1;\n      restored.focus({ preventScroll: true });\n    }\n  }\n  return buttons;\n}\n\n/** 从用户原始品牌 PNG 生成低分辨率二值像素版，保留品牌蓝点。 */\nexport async function paintPixelBrand(canvas, {\n  source = new URL(",{"ref":"assets/branding/seekdb-logo.png"},", import.meta.url).href,\n  blue = [1, 129, 253],\n} = {}) {\n  if (!canvas) throw new TypeError('缺少品牌画布。');\n  const doc = canvas.ownerDocument;\n  const url = String(source);\n  if (!brandImages.has(url)) {\n    brandImages.set(url, new Promise((resolve, reject) => {\n      const image = new doc.defaultView.Image();\n      image.onload = () => resolve(image);\n      image.onerror = () => reject(new Error('品牌原图载入失败。'));\n      image.src = url;\n    }).catch(error => { brandImages.delete(url); throw error; }));\n  }\n  const image = await brandImages.get(url);\n  canvas.width = 72;\n  canvas.height = 17;\n  const ctx = canvas.getContext('2d', { willReadFrequently: true });\n  ctx.clearRect(0, 0, 72, 17);\n  ctx.imageSmoothingEnabled = true;\n  ctx.imageSmoothingQuality = 'high';\n  const height = image.naturalHeight * 72 / image.naturalWidth;\n  ctx.drawImage(image, 0, (17 - height) / 2, 72, height);\n  const pixels = ctx.getImageData(0, 0, 72, 17);\n  let inkPixels = 0;\n  let bluePixels = 0;\n  for (let index = 0; index \u003c pixels.data.length; index += 4) {\n    const [r, g, b, alpha] = pixels.data.subarray(index, index + 4);\n    if (alpha \u003c 112) {\n      pixels.data.fill(0, index, index + 4);\n      continue;\n    }\n    const isBlue = b > r + 64 && b > g + 32;\n    pixels.data[index] = isBlue ? blue[0] : 0;\n    pixels.data[index + 1] = isBlue ? blue[1] : 0;\n    pixels.data[index + 2] = isBlue ? blue[2] : 0;\n    pixels.data[index + 3] = 255;\n    if (isBlue) bluePixels += 1;\n    else inkPixels += 1;\n  }\n  ctx.putImageData(pixels, 0, 0);\n  ctx.imageSmoothingEnabled = false;\n  return { width: 72, height: 17, inkPixels, bluePixels };\n}\n"],"dependencies":["assets/branding/seekdb-logo.png"]},"战术线索.mjs":{"kind":"module","parts":["/** 开局粗情报。只使用舰体几何，不读取血量、受击记录或轮次。 */\nfunction fixedIndex(seed, label, count) {\n  let hash = 2166136261;\n  for (const char of `${seed}|${label}`) hash = Math.imul(hash ^ char.charCodeAt(0), 16777619);\n  return (hash >>> 0) % count;\n}\n\nconst column = value => String.fromCharCode(65 + value);\nconst key = cell => `${cell.x},${cell.y}`;\nexport const TACTICAL_CLUE_KINDS = Object.freeze(['dense_half', 'full_ship_band', 'empty_patch',\n  'ship_orientation', 'ship_crossline', 'submarine_region']);\nexport function isTacticalClueKind(kind) { return TACTICAL_CLUE_KINDS.includes(kind); }\n\nfunction strip(size, axis, start, width) {\n  return Array.from({ length: size * size }, (_, index) => ({ x: index % size, y: Math.floor(index / size) }))\n    .filter(cell => cell[axis] >= start && cell[axis] \u003c start + width);\n}\n\nfunction stripName(axis, start, width) {\n  return axis === 'x' ? `${column(start)}～${column(start + width - 1)}列` : `${start + 1}～${start + width}行`;\n}\n\n/** cells 使用战术棋盘的0起点坐标；写入SQL观测前，由调用者平移为globalXY。 */\nexport function generateTacticalClues({ fleet, level = 1, seed = 1 } = {}) {\n  const size = fleet?.size;\n  if (!Number.isInteger(size) || size \u003c 4 || size % 2 || !fleet.ships?.length) throw new RangeError('战术线索需要偶数棋盘和完整开局舰队');\n  const ships = fleet.ships.map(ship => ship.cells.map(cell => ({ x: cell.x, y: cell.y })));\n  const occupied = ships.flat();\n  if (occupied.some(cell => !Number.isInteger(cell.x) || !Number.isInteger(cell.y) || cell.x \u003c 0 || cell.y \u003c 0 || cell.x >= size || cell.y >= size)) throw new RangeError('舰队坐标越界');\n  const limit = Math.min(size >= 12 ? 3 : 2, typeof level === 'object' ? level.clueLimit ?? 3 : 3);\n  const halves = ['x', 'y'].flatMap(axis => [0, size / 2].map(start => {\n    const cells = strip(size, axis, start, size / 2);\n    const keys = new Set(cells.map(key));\n    return { axis, start, cells, count: occupied.filter(cell => keys.has(key(cell))).length };\n  }));\n  const max = Math.max(...halves.map(half => half.count));\n  const denseChoices = halves.filter(half => half.count === max);\n  const dense = denseChoices[fixedIndex(seed, 'dense-half', denseChoices.length)];\n  const basis = { axis: dense.axis, area: stripName(dense.axis, dense.start, size / 2),\n    oppositeArea: stripName(dense.axis, dense.start === 0 ? size / 2 : 0, size / 2),\n    count: dense.count, oppositeCount: occupied.length - dense.count, asOf: '开局' };\n  const statistics = basis.count === basis.oppositeCount\n    ? `开局统计：${basis.area}和${basis.oppositeArea}各有${basis.count}个舰格。`\n    : `开局统计：${basis.area}有${basis.count}个舰格，${basis.oppositeArea}有${basis.oppositeCount}个舰格。`;\n  const clues = [{ id: 'dense-half', kind: 'dense_half',\n    text: statistics, cells: dense.cells, basis }];\n  if (limit \u003c= 1) return clues;\n\n  const levelId = typeof level === 'number' ? level : level.id;\n  const occupiedKeys = new Set(occupied.map(key));\n  function fullBand(fallback = false) {\n    const bands = [];\n    for (const axis of ['x', 'y']) for (let start = 0; start \u003c= size / 2; start += 1) {\n      const cells = strip(size, axis, start, size / 2), keys = new Set(cells.map(key));\n      if (ships.some(ship => ship.every(cell => keys.has(key(cell))))) bands.push({ axis, start, cells });\n    }\n    const different = bands.filter(band => band.axis !== dense.axis || band.start !== dense.start);\n    const choices = different.length ? different : bands;\n    if (!choices.length) return null;\n    const band = choices[fixedIndex(seed, 'full-ship-band', choices.length)];\n    return { id: 'full-ship-band', kind: 'full_ship_band',\n      text: `开局观测：${stripName(band.axis, band.start, size / 2)}内至少有一艘完整舰。`, cells: band.cells,\n      ...(fallback ? { proof: { asOf: '开局', fallback: true } } : {}) };\n  }\n  function emptyPatch(span, preferred = []) {\n    const preferredKeys = new Set(preferred.map(key)), patches = [];\n    for (let y = 0; y \u003c= size - span; y += 1) for (let x = 0; x \u003c= size - span; x += 1) {\n      const cells = Array.from({ length: span * span }, (_, i) => ({ x: x + i % span, y: y + Math.floor(i / span) }));\n      if (cells.every(cell => !occupiedKeys.has(key(cell)))) {\n        patches.push({ x, y, cells, overlap: cells.filter(cell => preferredKeys.has(key(cell))).length });\n      }\n    }\n    if (!patches.length) return null;\n    const maxOverlap = Math.max(...patches.map(patch => patch.overlap));\n    const choices = patches.filter(patch => patch.overlap === maxOverlap);\n    const patch = choices[fixedIndex(seed, `empty-patch-${span}`, choices.length)];\n    return { id: `empty-patch-${span}`, kind: 'empty_patch',\n      text: `开局观测：${column(patch.x)}～${column(patch.x + span - 1)}列、${patch.y + 1}～${patch.y + span}行的${span}×${span}区域全部是空海，可以排除。`,\n      cells: patch.cells, proof: { asOf: '开局', span, emptyCellCount: patch.cells.length, fallback: false } };\n  }\n  function orientation() {\n    const length = Math.max(...ships.map(ship => ship.length));\n    const longest = ships.filter(ship => ship.length === length);\n    const ship = longest[fixedIndex(seed, 'longest-orientation', longest.length)];\n    const horizontal = length === 1 || ship[0].y === ship[1].y;\n    return { id: 'longest-orientation', kind: 'ship_orientation',\n      text: `开局观测：最长舰为${length}格，其中至少一艘${horizontal ? '横向' : '竖向'}布置，位置未明。`,\n      proof: { asOf: '开局', length, orientation: horizontal ? 'horizontal' : 'vertical',\n        candidatePlacementCount: size * (size - length + 1), quantifier: 'at_least_one' } };\n  }\n  function crossline() {\n    const lengths = [...new Set(ships.filter(ship => ship.length >= 4).map(ship => ship.length))];\n    const choices = [];\n    for (const axis of ['x', 'y']) for (let boundary = 1; boundary \u003c size; boundary += 1) {\n      const crosses = ship => Math.min(...ship.map(cell => cell[axis])) \u003c boundary && Math.max(...ship.map(cell => cell[axis])) >= boundary;\n      if (!ships.some(ship => ship.length >= 4 && crosses(ship))) continue;\n      const candidates = new Map(); let placements = 0;\n      for (const length of lengths) for (let line = 0; line \u003c size; line += 1) for (let start = 0; start \u003c= size - length; start += 1) {\n        const cells = Array.from({ length }, (_, i) => axis === 'x' ? { x: start + i, y: line } : { x: line, y: start + i });\n        if (crosses(cells)) { placements += 1; for (const cell of cells) candidates.set(key(cell), cell); }\n      }\n      if (candidates.size >= Math.ceil(size * size / 3) && placements >= Math.ceil(size * size / 3)) {\n        choices.push({ axis, boundary, cells: [...candidates.values()], placements, centrality: Math.abs(boundary - size / 2) });\n      }\n    }\n    if (!choices.length) return null;\n    const closest = Math.min(...choices.map(choice => choice.centrality));\n    const central = choices.filter(choice => choice.centrality === closest);\n    const choice = central[fixedIndex(seed, 'ship-crossline', central.length)];\n    const boundaryName = choice.axis === 'x' ? `${column(choice.boundary - 1)}/${column(choice.boundary)}列` : `第${choice.boundary}/${choice.boundary + 1}行`;\n    return { id: 'long-ship-crossline', kind: 'ship_crossline',\n      text: `开局观测：至少一艘长≥4格的舰跨过${boundaryName}分界，同一艘舰在分界两侧都有舰格。`,\n      cells: choice.cells, proof: { asOf: '开局', axis: choice.axis, boundaries: [choice.boundary], minLength: 4,\n        quantifier: 'at_least_one', candidateCellCount: choice.cells.length, candidatePlacementCount: choice.placements } };\n  }\n  function submarineRegion(width) {\n    const submarines = ships.filter(ship => ship.length === 1), choices = [];\n    if (!submarines.length) return null;\n    for (const axis of ['x', 'y']) {\n      const starts = width === size / 2 ? [0, size - width] : Array.from({ length: size - width + 1 }, (_, i) => i);\n      for (const start of starts) if (submarines.some(ship => ship[0][axis] >= start && ship[0][axis] \u003c start + width)) {\n        choices.push({ axis, start, cells: strip(size, axis, start, width) });\n      }\n    }\n    const region = choices[fixedIndex(seed, 'submarine-region', choices.length)];\n    return { id: 'submarine-region', kind: 'submarine_region',\n      text: `开局观测：至少一艘1格潜艇在${stripName(region.axis, region.start, width)}内，仍需逐格确认；这条线索只描述潜艇。`,\n      cells: region.cells, proof: { asOf: '开局', axis: region.axis, width, targetLength: 1,\n        quantifier: 'at_least_one', regionCellCount: region.cells.length, candidateCellCount: region.cells.length } };\n  }\n  if (levelId === 2) clues.push(emptyPatch(2) ?? fullBand(true));\n  else if (levelId === 3) clues.push(orientation());\n  else if (levelId === 4) clues.push(crossline() ?? fullBand(true));\n  else if (levelId >= 5) {\n    const region = submarineRegion(levelId === 5 ? size / 2 : Math.min(size - 1, Math.ceil(size / 3) + 1));\n    if (!region) clues.push(fullBand(true));\n    else {\n      const patch = emptyPatch(levelId === 5 ? 2 : 3, region.cells);\n      const excluded = new Set((patch?.cells ?? []).map(key));\n      region.proof.candidateCellCount = region.cells.filter(cell => !excluded.has(key(cell))).length;\n      clues.push(region, patch ?? fullBand(true));\n    }\n  } else clues.push(fullBand());\n  return clues.filter(Boolean).slice(0, limit);\n}\n"],"dependencies":[]},"情报剧本.mjs":{"kind":"module","parts":["/** 题面与人工回波特征；不接收舰位，不生成任何战术真值。 */\nexport const SIGNAL_FEATURES = Object.freeze(['军用识别', '发动机低频', '航速', '舰体尺度', '雷达强度', '热源', '金属回波', '编队规律']);\nconst ECHO_SOURCES = ['沿岸声呐站', '外海军用校验浮标', '舰队机舱监听席', '联合采样船', '海军声纹档案室', '值班回波校验台'];\nconst LISTEN_SOURCES = ['港务无线电抄件', '巡航日志附件', '岸台值更簿', '护航队短报', '信号旗转译单', '联合监听签收单'];\n\nconst THEMES = [\n  { echoLabel: '整舰低频样本', listenLabel: '完整舰体附件', vector: [0.95, 0.88, 0.70, 0.92, 0.82, 0.70, 0.96, 0.83],\n    variants: [\n      ['整舰登记簿', 'KEEL', '推进器低频连续，舰体回声完整。录音末尾的咳嗽来自值班员。', '这份附件按完整舰体归档，船长的身高不在统计范围。'],\n      ['泊位签收单', 'MOORING', '军用推进器和金属回声相互吻合，泊位广播已剔除。', '签收员确认有整舰记录，盖章次数不代表舰船数量。'],\n      ['尾流备忘录', 'WAKE', '低频尾流保持连续，符合军舰的成段回波。', '尾流报告收在整舰目录里，水花照片另存，别串页。'],\n      ['缆绳旁的短报', 'BERTH', '军用机组节律稳定，不像港内装卸机械的断续声。', '码头只代收完整舰体报告，没有附送敌舰门牌号。'],\n      ['船壳回声复核', 'HULL', '舰体尺度和金属回声同时偏强，符合完整军舰样本。', '复核表说的是船壳范围，涂装颜色那一栏尚未填写。'],\n      ['锚泊班的交接', 'ANCHOR', '发动机低频和编队节律清晰，可用于匹配整舰观测。', '夜班已交接整舰附件，咖啡杯印不算第二个信源。'],\n    ],\n    archives: ['旧缆绳领用表，只有签名没有敌情。', '上月泊位保养单，检修的是防撞轮。', '值班室钥匙交接记录，最后一把仍未归还。', '旧船壳涂装报价，不能据此推算舰位。', '去年码头灯泡验收单，验收员写了三遍合格。', '作废的拖轮排班，日期早于本次行动。'] },\n  { echoLabel: '巡检器校验回波', listenLabel: '空海复核记录', vector: [0.92, 0.35, 0.20, 0.28, 0.95, 0.22, 0.81, 0.40],\n    variants: [\n      ['空海也要签字', 'CLEAR', '这是军用巡检器的校验样本，用来识别报告设备，不表示空区内有军舰。', '空区复核已经签字，记录不是丢了，是没船。'],\n      ['安静的录音带', 'SILENT', '校验脉冲规律清楚，背景里没有民船广播。', '安静记录仍然有用，值班员打盹的声音已经剪掉。'],\n      ['留白验收单', 'BLANK', '巡检底图和设备回波一致，空白页并非扫描故障。', '验收单说明哪片海可以排除，空白不需要补写一艘船。'],\n      ['静海复测', 'QUIET', '设备校验信号稳定，可与空海复测文件核对。', '复测目录已经整理好，请勿把无回波改成未提交。'],\n      ['底噪清点', 'CALM', '军用扫描器的参考回波可辨，海况杂讯另列。', '底噪报告附了空区记录，纸张数量不代表扫描次数。'],\n      ['无人泊位旁', 'VACANT', '巡检器自检正常，参考特征与气象浮标不同。', '没有船也要归档，港务员终于同意不给空海收泊位费。'],\n    ],\n    archives: ['过期清扫排班，负责擦地板而非扫海图。', '旧空白表格申领单，已经盖上作废章。', '巡检器纸盒回收记录，里面没有备用敌舰。', '去年录音带编号表，与当前扫描无关。', '静音耳机采购单，宣传页不能当空海证明。', '旧泊位收费说明，修订日期早于本次行动。'] },\n  { echoLabel: '长舰连续声纹', listenLabel: '最长舰航向短报', vector: [0.94, 0.91, 0.45, 0.96, 0.55, 0.72, 0.94, 0.52],\n    variants: [\n      ['横竖登记处', 'HEADING', '长舰的低频和舰体尺度明显，适合匹配最长舰记录。', '附件记录最长舰朝向，不负责告诉你具体停在哪一行。'],\n      ['指南针值更簿', 'COMPASS', '连续金属回声来自长舰，校验员已排除渡轮样本。', '方向记在最长舰目录中，指南针并没有替人点格。'],\n      ['方位抄件', 'BEARING', '长船壳回声稳定，发动机节拍与军用样本吻合。', '抄件只确认长舰方向，地图上那枚回形针没有定位意义。'],\n      ['航向复核单', 'COURSE', '舰体尺度偏大且低频稳定，属于长舰参考声纹。', '复核员把最长舰的方向写清了，字迹端正不代表坐标精确。'],\n      ['轴线说明书', 'AXIS', '长舰低频成段延展，可区别于民船和浮标杂讯。', '先查最长舰朝向，说明书里的装订线不是航线。'],\n      ['舵手的便笺', 'RUDDER', '机组节拍与长舰回声一致，采样时已消除甲板脚步声。', '便笺归在最长舰附件，舵手没有顺手画出整张布阵。'],\n    ],\n    archives: ['旧指南针电池发票，没有当前航向。', '过期航海教材借阅单，附图并非敌舰。', '去年舵轮保养记录，只更换了把手。', '作废的方向标牌，箭头曾被贴反。', '制图室直尺借用单，长度单位并非舰格。', '旧航向作业批改表，不属于当前编队。'] },\n  { echoLabel: '跨线长舰回波', listenLabel: '分界通行记录', vector: [0.96, 0.70, 0.86, 0.80, 0.97, 0.93, 0.88, 0.91],\n    variants: [\n      ['过线请留痕', 'CROSSING', '较长军舰的推进和雷达特征一致，可对照跨线报告。', '报告说的是同一艘舰跨线，不是两艘船排队合影。'],\n      ['分界值班单', 'DIVIDE', '军用长舰在连续采样中保持一致特征。', '分界记录两侧属于同一舰体，值班表的折痕不算分界。'],\n      ['横跨回声', 'SPAN', '长舰金属回声连续，热源和航速特征吻合。', '跨线附件已经归档，不代表整条分界线上都是船。'],\n      ['海图接缝处', 'BRIDGE', '回波连续性与军用长舰吻合，可排除港内机械声。', '接缝两边的记录描述同一艘舰，胶带不提供额外坐标。'],\n      ['骑缝章复核', 'SEAM', '高雷达特征和长舰声纹同时出现，来源可复核。', '骑缝章只是防串页，真正要核对的是跨线长舰。'],\n      ['通行抄报', 'TRANSIT', '长舰推进节律在分界两侧连续，没有切成两段回波。', '通行文件确认跨线关系，不能读成两艘舰各占一边。'],\n    ],\n    archives: ['旧边线油漆领用表，油漆工未参加本次监听。', '过期通行证空白册，没有当前舰体记录。', '去年骑缝章维修单，印章卡过一次纸。', '海图胶带采购记录，不包含战术分界。', '制图室拼接练习，练习船没有出海。', '作废的跨页目录，页码不能当坐标。'] },\n  { echoLabel: '水下低频样本', listenLabel: '潜艇活动附件', vector: [0.96, 0.98, 0.24, 0.12, 0.08, 0.18, 0.90, 0.16],\n    variants: [\n      ['潜艇不爱露脸', 'DEEP', '低频推进明显，雷达和热源较弱，符合潜艇类人工特征。', '附件只给潜艇粗区域，潜望镜并没有寄来自拍。'],\n      ['下潜便笺', 'DIVE', '水下推进声稳定，不能拿渡轮广播来匹配。', '先查潜艇活动范围，再读空区复核，别把整片海当船壳。'],\n      ['声呐班的短报', 'SONAR', '低雷达特征配合稳定金属回声，可区别于水面民船。', '短报记载单格潜艇范围，声呐员没有在海图上画一个必中点。'],\n      ['潜望镜目录', 'PERISCOPE', '小舰体尺度与水下低频相符，杂讯已另外归档。', '目录里有潜艇区域和空海附件，镜头盖保修单请略过。'],\n      ['压载舱回声', 'BALLAST', '推进低频偏强，热源与编队特征偏低，适合核对潜艇记录。', '压载记录对应潜艇粗区域，水桶领用单不是第二份敌情。'],\n      ['水下签收', 'SEAL', '军用识别与水下推进声相符，气象浮标特征明显不同。', '签收员只确认区域，没有把潜艇钉在纸上。'],\n    ],\n    archives: ['潜水社旧活动通知，参与者并非敌方潜艇。', '过期耳机泡棉领用单，不含水下回波。', '潜望镜镜头盖保修单，镜头盖目前无战斗力。', '去年压载泵检修票据，与本次监听无关。', '旧保温杯密封测试，不能拿来识别潜艇。', '声呐教材借阅表，书还没归还。'] },\n  { echoLabel: '双站交叉校验样本', listenLabel: '终战联合附件', vector: [0.98, 0.70, 0.32, 0.18, 0.35, 0.26, 0.96, 0.90],\n    variants: [\n      ['最后一轮对账', 'VERIFY', '双站校验记录同时保留军用低频和金属特征，用于匹配联合附件。', '附件包含潜艇宽带与空区，双份打印不算两个独立信源。'],\n      ['两站签收单', 'CONSENSUS', '联合监听的军用特征一致，不能把民船转述混进来。', '两站记录已经归档，宽带与空区应分别读清对象。'],\n      ['独立见证', 'WITNESS', '交叉校验信号稳定，军用识别和编队记录可以相互核对。', '独立站点共同签收，签名潦草也不影响记录归属。'],\n      ['终战复核簿', 'CONFIRM', '军用金属回声与联合采样节律一致，来源可追溯。', '复核结论仍是粗区域，终战并不附送精准坐标。'],\n      ['配对监听', 'PAIRED', '两站校验样本保留共同特征，天气杂讯另列。', '配对目录含两种战术观测，订在一起不代表它们描述同一艘船。'],\n      ['再查一遍', 'RECHECK', '联合样本中的军用识别稳定，可与当前任务记录匹配。', '重新核对宽带和空区即可，值班员已经把旧版本装进档案盒。'],\n    ],\n    archives: ['旧版本对账表，最后一列已经作废。', '双份打印申请单，复印件不构成独立来源。', '联合值班椅保修单，与战场数据无关。', '去年监听站联络册，号码已经更换。', '过期签收回执，任务编号不属于本次行动。', '旧档案盒采购单，盒子里没有新增线索。'] },\n];\n\nfunction hashSeed(seed) {\n  let value = 2166136261;\n  for (const char of String(seed)) value = Math.imul(value ^ char.charCodeAt(0), 16777619);\n  value = Math.imul(value ^ value >>> 16, 0x85ebca6b);\n  value = Math.imul(value ^ value >>> 13, 0xc2b2ae35);\n  return (value ^ value >>> 16) >>> 0;\n}\n\n/** 每关六套内容，再组合独立采样/监听渠道；Fork用同seed返回完全相同对象。 */\nexport function createSignalStory({ level = 1, seed = 1 } = {}) {\n  const levelId = typeof level === 'number' ? level : level?.id;\n  if (!Number.isInteger(levelId) || levelId \u003c 1 || levelId > 6) throw new RangeError('情报剧本关卡无效');\n  const theme = THEMES[levelId - 1];\n  const [title, keyword, echoText, listenText] = theme.variants[hashSeed(`${seed}|variant|${levelId}`) % 6];\n  const echoSource = ECHO_SOURCES[hashSeed(`${seed}|echo-source|${levelId}`) % ECHO_SOURCES.length];\n  const listenSource = LISTEN_SOURCES[hashSeed(`${seed}|listen-source|${levelId}`) % LISTEN_SOURCES.length];\n  const vector = theme.vector.map((value, i) => Number(Math.max(0, Math.min(1,\n    value + (hashSeed(`${seed}|feature|${levelId}|${i}`) % 31 - 15) / 1000)).toFixed(3)));\n  const rotation = hashSeed(`${seed}|archive|${levelId}`) % theme.archives.length;\n  return {\n    id: `signal-l${levelId}-${hashSeed(seed).toString(16)}`, title,\n    echo: { name: 'warship', label: theme.echoLabel, source: echoSource, text: echoText, vector, features: [...SIGNAL_FEATURES] },\n    listen: { keyword, label: theme.listenLabel, source: listenSource, text: `${listenText} 本次有效目录词：${keyword}。` },\n    feedback: { empty: `“${title}”还没匹配到记录，请核对当前任务与这份监听。`,\n      wrongArea: `这份“${title}”属于别的海区，当前会合点还没有对上。` },\n    archiveLines: Array.from({ length: 6 }, (_, i) => `${listenSource}旧档：${theme.archives[(rotation + i) % theme.archives.length]}`),\n  };\n}\n"],"dependencies":[]},"细节检索.mjs":{"kind":"module","parts":["/** 细节资料与定位资料分表；只投影开局已有粗线索，不接收fleet或实时舰位。 */\nimport { isTacticalClueKind } from ",{"ref":"战术线索.mjs"},";\nimport { createSignalStory } from ",{"ref":"情报剧本.mjs"},";\nexport { isTacticalClueKind, TACTICAL_CLUE_KINDS } from ",{"ref":"战术线索.mjs"},";\nconst SAMPLE_DEFINITIONS = [\n  { name: 'civil', label: '民船运输回波', vector: [0.12, 0.42, 0.36, 0.82, 0.28, 0.54, 0.64, 0.08] },\n  { name: 'noise', label: '气象浮标杂讯', vector: [0.06, 0.04, 0.01, 0.08, 0.45, 0.03, 0.18, 0.02] },\n];\nconst KEYWORDS = [\n  { keyword: 'ANCHOR', label: '锚泊监听' },\n  { keyword: 'BEACON', label: '航标监听' },\n  { keyword: 'COMPASS', label: '航向监听' },\n  { keyword: 'TIDE', label: '潮汐监听' },\n  { keyword: 'CORAL', label: '礁区监听' },\n];\n\nfunction hashSeed(seed) {\n  let hash = 2166136261;\n  for (const char of String(seed)) hash = Math.imul(hash ^ char.charCodeAt(0), 16777619);\n  return hash >>> 0;\n}\n\nfunction sqlLiteral(value) {\n  return `'${String(value).replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"''\").replaceAll('\\0', '')}'`;\n}\n\nconst PUBLIC_PROOF_KEYS = new Set(['asOf', 'fallback', 'span', 'emptyCellCount', 'length', 'orientation',\n  'candidatePlacementCount', 'quantifier', 'axis', 'boundaries', 'minLength', 'candidateCellCount',\n  'width', 'targetLength', 'regionCellCount']);\n\nfunction publicClue(clue, windowCells) {\n  const minX = Math.min(...windowCells.map(cell => cell.x)), minY = Math.min(...windowCells.map(cell => cell.y));\n  const keys = new Set(windowCells.map(cell => `${cell.x},${cell.y}`));\n  const rawCells = clue.cells ?? [];\n  if (!Array.isArray(rawCells) || rawCells.some(cell => !Number.isInteger(cell?.x) || !Number.isInteger(cell?.y)\n    || !keys.has(`${cell.x},${cell.y}`))) throw new RangeError('额外线索的粗区域越出定位海区');\n  const proof = Object.fromEntries(Object.entries(clue.proof ?? {}).filter(([key]) => PUBLIC_PROOF_KEYS.has(key)));\n  return { kind: clue.kind, cells: rawCells.map(cell => ({ x: cell.x - minX, y: cell.y - minY })),\n    ...(Object.keys(proof).length ? { proof: JSON.parse(JSON.stringify(proof)) } : {}) };\n}\n\nfunction supportProtocol(level, extras) {\n  const protocol = { id: `level-${level}-support`, code: ['radar_recommend', 'safe_mark', 'relay_target',\n    'radar_sweep', 'radar_filter', 'pattern_plan'][level - 1], description: [\n    '用本次粗线索推荐雷达扫描窗口，扫描仍消耗原有雷达库存和一次行动。',\n    '把本次确认的空海区域加入避空标记，不视为已经投过炸弹。',\n    '最长舰承担副炮中继；击沉这类目标后，停止后续周期双炮。',\n    '扫频雷达可在敌方双炮轮压制副炮，本轮最多反击一发，仍消耗一次雷达行动。',\n    '校准后可读取受扰雷达的有效回波；尚未解码的受扰格应保持未知。',\n    '比较现有多点武器覆盖尚未排除候选格的数量；覆盖分数不等于真实命中。',\n  ][level - 1] };\n  if (level === 3) {\n    const length = extras.find(clue => clue.kind === 'ship_orientation')?.proof?.length;\n    if (!Number.isInteger(length) || length \u003c 1) throw new RangeError('额外观测缺少公开的最长舰长度');\n    Object.assign(protocol, { target_length: length, period: 4 });\n  }\n  if (level === 4) Object.assign(protocol, { enemy_period: 3, max_enemy_shots: 1 });\n  return protocol;\n}\n\n/** 返回的embedding为八维人工领域特征，不是通用语义模型的嵌入。 */\nexport function createDetailEvidence({ evidence, level = 1, seed = 1 } = {}) {\n  const levelId = typeof level === 'number' ? level : level?.id;\n  if (!Number.isInteger(levelId) || levelId \u003c 1 || levelId > 6) throw new RangeError('细节资料关卡无效');\n  if (!evidence || !Array.isArray(evidence.rows) || typeof evidence.missionId !== 'string' || !evidence.missionId) throw new RangeError('缺少开局资料');\n  const reliableIds = new Set(evidence.truth?.reliableRowIds ?? []);\n  const reliable = evidence.rows.filter(row => reliableIds.has(row.id)).sort((a, b) => a.id.localeCompare(b.id));\n  if (!reliable.length) throw new RangeError('开局资料没有已确认的可靠观测行');\n  const original = reliable[0];\n  if (!/^S(?:[1-9]|1[0-6])$/.test(original.sector_id) || original.mission_id !== evidence.missionId) throw new RangeError('可靠资料的任务或海区不一致');\n  let clues;\n  try { clues = typeof original.tactical_clues === 'string' ? JSON.parse(original.tactical_clues) : original.tactical_clues; }\n  catch { throw new RangeError('可靠资料的战术线索不是有效JSON'); }\n  if (!Array.isArray(clues)) throw new RangeError('可靠资料缺少开局战术线索');\n  const extras = clues.slice(1).filter(clue => clue?.kind !== 'dense_half' && isTacticalClueKind(clue?.kind)).slice(0, levelId >= 5 ? 2 : 1);\n  if (!extras.length || extras.some(clue => ![clue.id, clue.kind, clue.text].every(value => typeof value === 'string' && value.length))) {\n    throw new RangeError('可靠资料缺少既有额外线索；请在截取定位线索之前创建细节资料');\n  }\n  let windowCells;\n  try { windowCells = typeof original.cells === 'string' ? JSON.parse(original.cells) : original.cells; }\n  catch { throw new RangeError('定位海区不是有效JSON'); }\n  if (!Array.isArray(windowCells) || !windowCells.length || windowCells.some(cell => !Number.isInteger(cell?.x) || !Number.isInteger(cell?.y))) {\n    throw new RangeError('缺少有效定位海区坐标');\n  }\n  const protocol = supportProtocol(levelId, extras);\n  const signalStory = createSignalStory({ level: levelId, seed });\n  const samples = [{ name: 'warship', label: signalStory.echo.label, vector: [...signalStory.echo.vector] },\n    ...SAMPLE_DEFINITIONS.map(sample => ({ ...sample, vector: [...sample.vector] }))];\n  const forbidden = new Set([evidence.callSign, ...evidence.rows.map(row => row.call_sign)].filter(Boolean).map(value => String(value).toUpperCase()));\n  const candidates = KEYWORDS.filter(option => !forbidden.has(option.keyword) && option.keyword !== signalStory.listen.keyword);\n  if (candidates.length \u003c 2) throw new RangeError('没有足够的独立详情关键词');\n  const start = hashSeed(`${seed}|detail-keyword|${levelId}`) % candidates.length;\n  const selected = [{ keyword: signalStory.listen.keyword, label: signalStory.listen.label },\n    ...Array.from({ length: 2 }, (_, index) => ({ ...candidates[(start + index) % candidates.length] }))];\n  const keyword = selected[0].keyword;\n  const rotation = hashSeed(`${seed}|detail-options|${levelId}`) % selected.length;\n  const keywordOptions = [...selected.slice(rotation), ...selected.slice(0, rotation)];\n  const prefix = `detail-l${levelId}-${hashSeed(`${seed}|${evidence.missionId}`).toString(16)}`;\n  const rows = [];\n  function add({ suffix, clueId = `detail-noise-${suffix}`, kind = 'non_tactical', text,\n    token = keyword, vector = samples[0].vector, sector = original.sector_id,\n    mission = evidence.missionId, observedRound = 1, source = '信号校准站', details = '', payload = null }) {\n    rows.push({ id: `${prefix}-${suffix}`, sector_id: sector, mission_id: mission,\n      observed_round: observedRound, clue_id: clueId, kind, clue_text: text,\n      body: `${source} ${token} DETAIL : ${details}${text}`, source, embedding: [...vector], payload_json: JSON.stringify(payload ?? {}) });\n  }\n  // 每条开局extra只存一行，不把两个可靠站点的同一结论重复发给玩家。\n  extras.forEach((clue, index) => add({ suffix: `extra-${index + 1}`, clueId: clue.id,\n    kind: clue.kind, text: clue.text, source: reliable[index % reliable.length].source,\n    details: `资料渠道：回波来自${signalStory.echo.source}。${signalStory.echo.text} 监听来自${signalStory.listen.source}。${signalStory.listen.text} 协议说明：${protocol.description} 观测结论：`,\n    payload: { clue: publicClue(clue, windowCells), protocol } }));\n  // 正交干扰使真实SQL的每个谓词都有作用，不在JS里硬判错或伪造结果。\n  add({ suffix: 'word-a', token: selected[1].keyword, text: '这是其他监听目录的军用回波，只记录设备校准，没有本任务舰队布阵结论。' });\n  add({ suffix: 'word-b', token: selected[2].keyword, text: '这是另一监听目录的军用回波，只记录港口通联，没有本任务舰队布阵结论。' });\n  add({ suffix: 'civil', vector: samples[1].vector, source: '民船电台', text: '民船装卸记录：回波对应运输船，不是本任务敌舰的战术线索。' });\n  add({ suffix: 'noise', vector: samples[2].vector, source: '气象浮标', text: '气象浮标记录：海面杂讯不能解释为敌舰布阵。' });\n  add({ suffix: 'old-mission', mission: `${evidence.missionId}-archive`, source: '历史档案', text: '上一任务的军用设备档案，任务编号不属于本次行动。' });\n  const otherSector = `S${Number(original.sector_id.slice(1)) % 16 + 1}`;\n  add({ suffix: 'other-sector', sector: otherSector, source: '岸基观察站', text: '其他战术海区的设备校准记录，不是当前已定位海区的线索。' });\n  add({ suffix: 'expired', observedRound: 0, source: '历史档案', text: '出航前第0轮旧档案，不能当作当前行动线索。' });\n  return { rows, keyword, samples, keywordOptions, signalStory };\n}\n\n/** 只构造SQL；执行和结果展示交给真实seekdb，不在此返回猜测的命中行。 */\nexport function buildDetailQuery(input = {}) {\n  const invalid = error => ({ valid: false, sql: '', error, description: '' });\n  if (!input || typeof input !== 'object' || Array.isArray(input)) return invalid('详情检索输入格式不正确');\n  const { sectorId, missionId, vector, keyword, mode = 'hybrid' } = input;\n  if (!['hybrid', 'vector', 'fulltext'].includes(mode)) return invalid('请选择全文、向量或混合检索');\n  const useVector = mode !== 'fulltext', useText = mode !== 'vector';\n  if (typeof sectorId !== 'string' || !/^S(?:[1-9]|1[0-6])$/.test(sectorId)) return invalid('请选择已定位的有效海区');\n  if (typeof missionId !== 'string' || !missionId.trim()) return invalid('缺少当前任务编号');\n  if (useText && (typeof keyword !== 'string' || !keyword.trim())) return invalid('请选择详情监听关键词');\n  if (useVector && (!Array.isArray(vector) || vector.length !== 8 || Array.from({ length: 8 }, (_, i) => vector[i]).some(value => !Number.isFinite(value)))) {\n    return invalid('请选择有效的八维回波样本');\n  }\n  const encoded = useVector ? sqlLiteral(JSON.stringify(vector)) : null;\n  const distance = useVector ? `l2_distance(embedding, ${encoded})` : 'NULL';\n  const sql = [\n    'SELECT clue_id, kind, clue_text, source, body, payload_json,',\n    `  ${distance} AS distance`,\n    'FROM tactical_observations',\n    `WHERE mission_id = ${sqlLiteral(missionId)}`,\n    `  AND sector_id = ${sqlLiteral(sectorId)}`,\n    '  AND observed_round >= 1',\n    ...(useText ? [`  AND MATCH(body) AGAINST (${sqlLiteral(keyword.trim())} IN NATURAL LANGUAGE MODE)`] : []),\n    ...(useVector ? [`  AND ${distance} \u003c= 0.42`] : []),\n    'ORDER BY distance, id',\n    'LIMIT 6',\n  ].join('\\n');\n  return { valid: true, sql, error: null,\n    description: mode === 'hybrid' ? '组合监听关键词与八维人工回波，读取当前任务、当前海区的固定额外线索。'\n      : mode === 'vector' ? '仅比对回波相似度，同类信号的其他目录也可能返回；尚未使用监听关键词。'\n        : '仅按监听关键词查目录，民船和天气记录也可能同词；尚未比对回波。' };\n}\n"],"dependencies":["情报剧本.mjs","战术线索.mjs"]},"情报组合.mjs":{"kind":"module","parts":["/** 只编排可点击的两套资料；成败仍由真实SQL结果及流程裁判判断。 */\nimport { createDetailEvidence } from ",{"ref":"细节检索.mjs"},";\n\nconst METHODS = [\n  { ability: 'range', kind: 'range' }, { ability: 'fulltext', kind: 'keyword' },\n  { ability: 'vector', kind: 'vector' }, { ability: 'filter', kind: 'filter' },\n];\nconst RELIABLE_SOURCES = new Set(['岸基观察站', '舰载雷达站', 'COAST', 'RADAR']);\nconst TITLES = ['岸台整理稿', '巡航抄录稿', '值更台联单', '航海图附件', '联合监听单', '护航队备忘'];\nconst clone = value => JSON.parse(JSON.stringify(value));\nconst finiteVector = vector => Array.isArray(vector) && vector.length === 8\n  && Array.from({ length: 8 }, (_, i) => vector[i]).every(Number.isFinite);\nconst distance = (a, b) => Math.sqrt(a.reduce((sum, value, i) => sum + (value - b[i]) ** 2, 0));\n\nfunction hash(value) {\n  let n = 2166136261;\n  for (const char of String(value)) n = Math.imul(n ^ char.charCodeAt(0), 16777619);\n  n = Math.imul(n ^ n >>> 16, 0x85ebca6b);\n  return (n ^ n >>> 13) >>> 0;\n}\n\nfunction levelId(level) {\n  const id = typeof level === 'number' ? level : level?.id;\n  if (!Number.isInteger(id) || id \u003c 1 || id > 6) throw new RangeError('资料组合关卡无效');\n  return id;\n}\n\nfunction orderedPair(items, seed) {\n  const pair = hash(`${seed}|order`) % 2 ? [...items].reverse() : [...items];\n  const firstTitle = hash(`${seed}|titles`) % TITLES.length;\n  return pair.map((item, index) => ({ ...item, title: TITLES[(firstTitle + index) % TITLES.length] }));\n}\n\nfunction currentFilter(payload, missionId, level) {\n  return payload?.missionId === missionId && payload.minConfidence >= 85 && Array.isArray(payload.sources)\n    && payload.sources.length > 0 && payload.sources.every(source => RELIABLE_SOURCES.has(source))\n    && payload.minSources >= (level >= 6 ? 2 : 1);\n}\n\nfunction reconDescription(cards, deal, military) {\n  const pieces = [];\n  for (const card of cards) {\n    const p = card.payload;\n    if (card.kind === 'range') pieces.push(`时间：第${p.minRound}～${p.maxRound}轮`);\n    if (card.kind === 'keyword') pieces.push(`口令：${p.keyword}`);\n    if (card.kind === 'vector') pieces.push(`回波：${distance(p.vector, military) \u003c= 0.42 ? '军用推进器' : '民船运输样本'}`);\n    if (card.kind === 'filter') pieces.push(`任务：${p.missionId === deal.missionId ? '本次行动' : '历史行动'}；来源：${p.sources.join('＋')}`);\n  }\n  return pieces.join('；') + '。';\n}\n\n/** 每关提供两套完整资料，只让其中一套替换一个语义条件；不标记正误。 */\nexport function createReconChoices({ deal, level = 1 } = {}) {\n  const id = levelId(level);\n  if (!deal || !Array.isArray(deal.cards) || !deal.cards.length || !Array.isArray(deal.rows)\n    || !deal.missionId || !deal.callSign) throw new RangeError('缺少完整定位资料');\n  const methods = METHODS.slice(0, Math.min(id, 4));\n  const rangeCards = deal.cards.filter(card => card.kind === 'range' && Number.isFinite(card.payload?.maxRound));\n  const round = Math.max(...rangeCards.map(card => card.payload.maxRound));\n  if (!Number.isInteger(round) || round \u003c 1) throw new RangeError('定位资料没有当前监听时间');\n  const start = Math.max(1, round - 2);\n  const armyRows = deal.rows.filter(row => row.mission_id === deal.missionId && row.call_sign === deal.callSign\n    && row.ship_class === 'warship' && row.observed_round === round && RELIABLE_SOURCES.has(row.source)\n    && finiteVector(row.embedding)).sort((a, b) => a.id.localeCompare(b.id));\n  if (!armyRows.length) throw new RangeError('定位资料没有当前军用参考回波');\n  const military = Array.from({ length: 8 }, (_, i) => armyRows.reduce((sum, row) => sum + row.embedding[i], 0) / armyRows.length);\n  const chosen = methods.map(method => {\n    const candidates = deal.cards.filter(card => card.kind === method.kind);\n    let card;\n    if (method.kind === 'range') card = candidates.find(c => c.payload?.minRound === start && c.payload.maxRound === round);\n    if (method.kind === 'keyword') card = candidates.find(c => c.payload?.keyword === deal.callSign);\n    if (method.kind === 'vector') card = candidates.filter(c => finiteVector(c.payload?.vector))\n      .sort((a, b) => distance(a.payload.vector, military) - distance(b.payload.vector, military))\n      .find(c => distance(c.payload.vector, military) \u003c= 0.42);\n    if (method.kind === 'filter') card = candidates.find(c => currentFilter(c.payload, deal.missionId, id));\n    if (!card) throw new RangeError(`定位资料缺少当前${method.kind}证据`);\n    return clone(card);\n  });\n  const kind = id === 1 ? 'range' : id === 2 ? 'keyword' : id === 3 ? 'vector' : 'filter';\n  const wrongCandidates = deal.cards.filter(card => {\n    if (card.kind !== kind) return false;\n    const p = card.payload;\n    if (kind === 'range') return Number.isInteger(p?.minRound) && Number.isInteger(p.maxRound)\n      && p.minRound \u003c= p.maxRound && (p.minRound === 0 || p.maxRound \u003c start);\n    if (kind === 'keyword') return typeof p?.keyword === 'string' && p.keyword !== deal.callSign;\n    if (kind === 'vector') return finiteVector(p?.vector) && distance(p.vector, military) > 0.42;\n    return p?.missionId && Array.isArray(p.sources) && p.sources.length\n      && (p.missionId !== deal.missionId || p.sources.some(source => !RELIABLE_SOURCES.has(source)));\n  }).sort((a, b) => a.id.localeCompare(b.id));\n  if (!wrongCandidates.length) throw new RangeError(`定位资料缺少可对照的${kind}证据`);\n  const seed = `${deal.missionId}|${deal.phase}|${round}|${deal.callSign}`;\n  const replacement = clone(wrongCandidates[hash(`${seed}|replacement`) % wrongCandidates.length]);\n  const alternative = chosen.map(card => card.kind === kind ? replacement : clone(card));\n  let rejectionHint;\n  if (kind === 'range') rejectionHint = `这套用了第${replacement.payload.minRound}～${replacement.payload.maxRound}轮档案；本轮有效窗口是第${start}～${round}轮。`;\n  if (kind === 'keyword') rejectionHint = `这套口令是${replacement.payload.keyword}，本次要找的编队口令是${deal.callSign}；时间正确也会查到别的记录。`;\n  if (kind === 'vector') rejectionHint = '这套用了民船运输回波，军用推进器特征没有匹配；口令相同也不能把民船当敌舰。';\n  if (kind === 'filter') rejectionHint = replacement.payload.missionId !== deal.missionId\n    ? '这套任务编号属于历史行动；同名回波不能替代当前任务记录。'\n    : '这套只收传闻或未确认来源，缺少当前任务的可靠站点；转载次数不等于独立互证。';\n  const make = (cards, hint) => ({ id: `combo-${hash(JSON.stringify([seed, cards.map(card => [card.kind, card.payload])]))}`,\n    description: reconDescription(cards, deal, military), cards, abilities: methods.map(method => method.ability), rejectionHint: hint });\n  return orderedPair([make(chosen, '这套尚未锁定目标，请对照实际结果复核任务、时间和来源。'), make(alternative, rejectionHint)], seed);\n}\n\n/** 接受详情资料或原始定位deal；两套只改变回波，监听词相同，实际SQL决定是否得到extra。 */\nexport function createDetailChoices({ evidence, seed = 1, level = 1 } = {}) {\n  const id = levelId(level);\n  if (!evidence) throw new RangeError('缺少详情资料');\n  const detail = evidence.signalStory && Array.isArray(evidence.samples) ? evidence\n    : createDetailEvidence({ evidence, level: id, seed });\n  const sample = detail.samples.find(item => item.name === 'warship' && finiteVector(item.vector));\n  const alternatives = detail.samples.filter(item => ['civil', 'noise'].includes(item.name) && finiteVector(item.vector));\n  const keyword = detail.signalStory?.listen?.keyword;\n  if (!sample || !alternatives.length || !keyword) throw new RangeError('详情资料缺少有效回波或监听卡');\n  const tag = `${seed}|${id}|${detail.signalStory.id}`;\n  const other = alternatives[hash(`${tag}|echo`) % alternatives.length];\n  const make = (selected, hint) => ({ id: `combo-${hash(JSON.stringify([tag, selected.vector, keyword]))}`,\n    description: `回波：${selected.label}；来源：${selected.name === 'warship' ? detail.signalStory.echo.source : selected.name === 'civil' ? '民船电台' : '气象浮标'}；监听：${keyword}（${detail.signalStory.listen.source}）。`,\n    sample: clone(selected), keyword, rejectionHint: hint });\n  return orderedPair([make(sample, '尚未取得战术观测，请核对实际查询返回的任务与海区。'),\n    make(other, `这套用了${other.label}，与本任务的${sample.label}不相符；监听词虽然相同，还需要匹配正确回波。`)], tag);\n}\n"],"dependencies":["细节检索.mjs"]},"检索任务.mjs":{"kind":"module","parts":["/** 只生成目标与选项；选择后仍执行真实SQL，不在此判定查询成败。 */\nimport { createDetailEvidence } from ",{"ref":"细节检索.mjs"},";\n\nconst METHODS = [\n  { kind: 'range', ability: 'range', label: '时间范围' },\n  { kind: 'keyword', ability: 'fulltext', label: '全文关键词' },\n  { kind: 'vector', ability: 'vector', label: '回波样本' },\n  { kind: 'filter', ability: 'filter', label: '条件过滤' },\n];\nconst RELIABLE = new Set(['岸基观察站', '舰载雷达站', 'COAST', 'RADAR']);\nconst MISSION_THEMES = [\n  { title: '时效核对：消息别过夜', opening: '先核对监听时间，昨天的消息今天不顶班。' },\n  { title: '追口令：别跟着渡轮跑', opening: '海上代号多，先找本次作战口令。' },\n  { title: '军民回波：认准推进器', opening: '民船也有发动机，军用回波另有特征。' },\n  { title: '清旧任务：档案先归档', opening: '同名记录未必同次行动，任务与信源一起核对。' },\n  { title: '潜艇补给追踪', opening: '潜艇小，资料不能马虎；先锁定可靠观测。' },\n  { title: '终局双站会签', opening: '两站都签字，传闻别来凑数。' },\n];\nconst WEBSITE = 'OceanBase 战舰队社区网站（https://open.oceanbase.com/）';\nconst FORMAL_CHANNELS = [\n  '舰队电视新闻（主播领带歪了，口令没念歪）', '军港日报（头版，不是包鱼的旧报纸）',\n  '官方电台（船长点歌前插播）', '军港公告（盖了章，没盖泡面）',\n  '海军新闻发布会（记者先问完午饭）', '航务局公报（附件比船票还齐）',\n  '海事气象专报（只报天气，不报心情）', '海防观察简报（望远镜擦过了）',\n  '护航司令部通告（咖啡印不影响正文）', '联合舰队值班纪要（值班员终于没打哈欠）',\n  '海军通信处通知（这次没串到点歌台）', '航道管理处公告（标点比航标还全）',\n  '前沿观测站日报（海鸥没代笔）', '军港调度中心通报（喇叭先修好了）',\n  '舰载雷达值班记录（屏幕不是在播球赛）', '岸基监听站公报（耳机线终于理顺）',\n  '海军测绘中心简报（尺子没拿反）', '水文监测中心日报（没有拿汤勺量海）',\n  '海事安全委员会公告（救生圈不负责签字）', '联合侦察组周报（组长先收起了自拍杆）',\n  '巡航分队任务快讯（快艇慢点也会送到）', '舰队情报科摘要（不是食堂菜单摘要）',\n  '港口安保中心通告（门卫这次没夹私货）', '海军训练中心通讯（教官没夹带俯卧撑）',\n  '护航协调处公函（纸飞机已改回文件）', '海面监测中心快报（浪大，字没糊）',\n  '舰队技术处设备报告（螺丝数也对上了）', '军用航标管理通报（灯泡不是气氛灯）',\n  '海事搜救中心广播（先广播，再找饭盒）', '远洋补给舰队通报（没夹带罐头广告）',\n  '舰队新闻编辑部专刊（错别字先下船）', '通信校准中心报告（杂音不算背景音乐）',\n  '海防指挥部晨报（比起床号晚一分钟）', '海军档案馆核验件（管理员掸过灰了）',\n  '联合指挥部发布稿（印章终于找到盖子）', '战区信息发布平台（不是船员相亲版）',\n];\nconst RUMOR_CHANNELS = [\n  '贿赂海盗（收钱时说自己从不骗人）', '酒馆小道消息（隔壁桌隔了三张桌）',\n  '船长吹牛大会（鱼有航母那么大）', '码头大爷口述（眼镜忘在家里）',\n  '半袋饼干换情报（对方先挑走夹心）', '坊间传言（坊也不知道谁先说的）',\n  '鹦鹉复读现场（只学会最后半句）', '漂流瓶留言（瓶盖比内容新）',\n  '海盗二手群（群主刚改名诚信船长）', '渔具店闲聊（买钩子送坐标）',\n  '海鸥代送纸条（先啄掉一角）', '藏宝图背面（画图的人已晕船）',\n  '澡堂战术讨论（蒸汽太大看不清）', '水手梦话（枕头说可以作证）',\n  '港口算命摊（罗盘兼职算姻缘）', '修船工茶歇（扳手听完都摇头）',\n  '旧船票背面涂鸦（日期被墨鱼盖住）', '跳蚤市场秘本（第二本半价）',\n  '走私商友情价（友情另收手续费）', '甲板麻将桌（东风被当成方位）',\n  '船员亲戚转述（亲戚的亲戚开过船）', '神秘热线来电（接通先卖保险）',\n  '码头棋摊分析（将军和军舰没分清）', '章鱼占卜结果（八只手各指一边）',\n  '海盗匿名投稿（署名是绝非海盗）', '锚链上捡的便签（字迹跟浪一样弯）',\n  '船厨午饭预言（盐放多了才有灵感）', '救生圈留言板（留言者正在转圈）',\n  '水族馆志愿者爆料（海豚拒绝背书）', '港口快递代收点（收件人写着随便）',\n  '旧收音机串台（先听到半段广告）', '夜钓群语音（风声比人声坚定）',\n  '船模店老板保证（比例尺忘乘一百）', '兜售捷径的向导（自己先迷了路）',\n  '漂浮木板刻字（刻字时船已经开走）', '海边许愿池回音（硬币没找零）',\n];\nconst clone = value => JSON.parse(JSON.stringify(value));\nconst finiteVector = vector => Array.isArray(vector) && vector.length === 8\n  && Array.from({ length: 8 }, (_, i) => vector[i]).every(Number.isFinite);\nconst distance = (a, b) => Math.sqrt(a.reduce((sum, n, i) => sum + (n - b[i]) ** 2, 0));\n\nfunction hash(value) {\n  const text = String(value);\n  let n = 2166136261;\n  for (let i = 0; i \u003c text.length; i++) n = Math.imul(n ^ text.charCodeAt(i), 16777619);\n  return n >>> 0;\n}\n\nfunction shuffled(items, seed) {\n  const result = [...items];\n  let state = hash(seed);\n  for (let i = result.length - 1; i > 0; i--) {\n    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;\n    const j = state % (i + 1);\n    [result[i], result[j]] = [result[j], result[i]];\n  }\n  return result;\n}\n\nfunction levelId(level) {\n  const id = typeof level === 'number' ? level : level?.id;\n  if (!Number.isInteger(id) || id \u003c 1 || id > 6) throw new RangeError('检索任务关卡无效');\n  return id;\n}\n\nfunction campaignKey(seed, missionId) {\n  if (seed !== undefined) return hash(seed).toString(16);\n  return /^mission-\\d+-(.+)$/.exec(missionId)?.[1] ?? String(missionId);\n}\n\nfunction acquisition(key, level, slot, formal) {\n  const index = (level - 1) * 6 + slot;\n  if (formal && hash(`${key}|website|${level}`) % 6 === slot) return WEBSITE;\n  return shuffled(formal ? FORMAL_CHANNELS : RUMOR_CHANNELS, `${key}|${formal ? 'formal' : 'rumor'}`)[index];\n}\n\nfunction filterMatches(p, mission, level) {\n  return p?.missionId === mission && Number.isFinite(p.minConfidence) && p.minConfidence >= 85\n    && Array.isArray(p.sources) && p.sources.length > 0 && p.sources.every(source => RELIABLE.has(source))\n    && p.minSources >= (level >= 6 ? 2 : 1);\n}\n\nfunction describeCard(card, military, missionId) {\n  const p = card.payload;\n  if (card.kind === 'range') return `时间：第${p.minRound}～${p.maxRound}轮`;\n  if (card.kind === 'keyword') return `口令：${p.keyword}`;\n  if (card.kind === 'vector') return `回波：${distance(p.vector, military) \u003c= 0.42 ? '军用推进器回波' : '民船运输回波'}`;\n  const sources = p.sources.map(source => ({ COAST: '岸基观察站', RADAR: '舰载雷达站', RUMOR: '港口传闻' })[source] ?? source);\n  return `任务：${p.missionId === missionId ? '本次行动' : '历史行动'}；来源：${sources.join('、')}；可信度：至少${p.minConfidence}；独立来源数：至少${p.minSources}`;\n}\n\n/** 每种已解锁方法各两项；goal和target明确给出需要匹配的值，mismatch只供失败后解释。 */\nexport function createReconTask({ deal, level = 1, seed } = {}) {\n  const id = levelId(level);\n  if (!deal || !Array.isArray(deal.cards) || !deal.cards.length || !Array.isArray(deal.rows)\n    || !deal.missionId || !deal.callSign) throw new RangeError('缺少完整定位资料');\n  const ranges = deal.cards.filter(card => card.kind === 'range' && Number.isInteger(card.payload?.maxRound));\n  const round = Math.max(...ranges.map(card => card.payload.maxRound)), start = Math.max(1, round - 2);\n  if (!Number.isInteger(round) || round \u003c 1) throw new RangeError('定位资料缺少当前时间');\n  const references = deal.rows.filter(row => row.mission_id === deal.missionId && row.call_sign === deal.callSign\n    && row.ship_class === 'warship' && row.observed_round === round && RELIABLE.has(row.source) && finiteVector(row.embedding));\n  if (!references.length) throw new RangeError('定位资料缺少当前军用回波');\n  const military = Array.from({ length: 8 }, (_, i) => references.reduce((sum, row) => sum + row.embedding[i], 0) / references.length);\n  const key = campaignKey(seed, deal.missionId);\n  const groups = METHODS.slice(0, Math.min(id, 4)).map((method, slot) => {\n    const cards = deal.cards.filter(card => card.kind === method.kind).sort((a, b) => a.id.localeCompare(b.id));\n    const match = card => {\n      const p = card.payload;\n      if (method.kind === 'range') return p?.minRound === start && p.maxRound === round;\n      if (method.kind === 'keyword') return p?.keyword === deal.callSign;\n      if (method.kind === 'vector') return finiteVector(p?.vector) && distance(p.vector, military) \u003c= 0.42;\n      return filterMatches(p, deal.missionId, id);\n    };\n    const good = cards.find(match);\n    const wrong = cards.filter(card => {\n      const p = card.payload;\n      if (method.kind === 'range') return Number.isInteger(p?.minRound) && Number.isInteger(p.maxRound)\n        && p.minRound \u003c= p.maxRound && (p.minRound === 0 || p.maxRound \u003c start) && !match(card);\n      if (method.kind === 'keyword') return typeof p?.keyword === 'string' && p.keyword && !match(card);\n      if (method.kind === 'vector') return finiteVector(p?.vector) && distance(p.vector, military) > 0.42;\n      return p?.missionId && Array.isArray(p.sources) && p.sources.length\n        && (p.missionId !== deal.missionId || p.sources.some(source => !RELIABLE.has(source)));\n    });\n    if (!good || !wrong.length) throw new RangeError(`定位资料缺少可对照的${method.kind}选项`);\n    const bad = wrong[hash(`${key}|${id}|${method.kind}|alternative`) % wrong.length];\n    const target = describeCard(good, military, deal.missionId);\n    let mismatch;\n    if (method.kind === 'range') mismatch = `时间不符：需要第${start}～${round}轮，这张是第${bad.payload.minRound}～${bad.payload.maxRound}轮旧档案。`;\n    if (method.kind === 'keyword') mismatch = `口令不符：需要${deal.callSign}，这张是${bad.payload.keyword}。`;\n    if (method.kind === 'vector') mismatch = '回波不符：需要军用推进器回波，这张是民船运输回波。';\n    if (method.kind === 'filter') mismatch = bad.payload.missionId !== deal.missionId\n      ? '任务不符：需要本次行动，这张属于历史行动。'\n      : `来源和可信度不符：需要岸基观察站、舰载雷达站，可信度至少85${id === 6 ? '且至少2个独立来源' : ''}；这张是港口传闻。`;\n    const make = (card, hint, formal) => ({ ...clone(card), description: describeCard(card, military, deal.missionId),\n      acquisition: acquisition(key, id, slot, formal), mismatch: hint });\n    return { ...method, target, choices: shuffled([make(good, '', true), make(bad, mismatch, false)], `${key}|${id}|recon|${method.kind}|${round}`) };\n  });\n  const theme = MISSION_THEMES[id - 1];\n  return { title: theme.title, goal: `${theme.opening}本次目标：${groups.map(group => group.target).join('；')}。`, groups };\n}\n\n/** 追加侦察各提供唯一有效回波和监听，仍需玩家点击加入实际SQL。 */\nexport function createDetailTask({ evidence, seed, level = 1 } = {}) {\n  const id = levelId(level);\n  if (!evidence) throw new RangeError('缺少详情资料');\n  const detail = evidence.signalStory && Array.isArray(evidence.samples) ? evidence\n    : createDetailEvidence({ evidence, level: id, seed: seed ?? 1 });\n  const story = detail.signalStory;\n  const sample = detail.samples.find(item => item.name === 'warship' && finiteVector(item.vector));\n  const keyword = story?.listen?.keyword;\n  if (!sample || !keyword || !story.echo?.source || !story.listen.source) {\n    throw new RangeError('详情资料缺少有效回波或监听选项');\n  }\n  const mission = detail.rows?.[0]?.mission_id ?? evidence.missionId ?? story.id;\n  const key = campaignKey(seed, mission), tag = `${key}|${id}|${story.id}`;\n  const echo = { id: `echo-${hash(`${tag}|${sample.name}`)}`, name: sample.name,\n    label: sample.label, vector: [...sample.vector], source: story.echo.source, text: story.echo.text,\n    acquisition: acquisition(key, id, 4, true), mismatch: '' };\n  const listen = { id: `listen-${hash(`${tag}|${keyword}`)}`, keyword, label: story.listen.label,\n    source: story.listen.source, text: story.listen.text, acquisition: acquisition(key, id, 5, true), mismatch: '' };\n  const groups = [\n    { kind: 'echo', label: '回波样本', target: `回波：${sample.label}`,\n      choices: [echo] },\n    { kind: 'keyword', label: '全文关键词', target: `监听词：${keyword}（${story.listen.label}）`,\n      choices: [listen] },\n  ];\n  return { title: story.title, goal: `本次目标：${groups.map(group => group.target).join('；')}。`, groups };\n}\n"],"dependencies":["细节检索.mjs"]},"海战规则.mjs":{"kind":"module","parts":["/**\n * 海战的裁判与资料生成规则。舰队对象只供裁判使用，不得写入 intelligence。\n * 本模块不模拟 SQL 结果；buildQuery 只拼查询，由真实 seekdb 执行。\n */\nimport { generateTacticalClues } from ",{"ref":"战术线索.mjs"},";\nexport { generateTacticalClues } from ",{"ref":"战术线索.mjs"},";\n\nexport const LEVELS = Object.freeze([\n  { id: 1, title: '初航 · 静海监听', size: 8, playerShips: [5, 3, 2, 1], enemyShips: [5, 3, 2, 2],\n    enemyDoubleEvery: 0, playerDoubleEvery: 0, evidenceEpochEvery: 0,\n    radarCharges: 2, dualCharges: 1, tripleCharges: 0, clueLimit: 2, defaultClues: 1, enemyPursuit: 'random',\n    reward: 'lightweight', rewardName: '极致轻量',\n    briefing: '核对资料时间，查询8×8战场与坐标粗线索；双方普通攻击每轮一发，开局可用雷达和双点炮。极致轻量缩短旗舰一格，还解锁嵌入式三联炮。' },\n  { id: 2, title: '迷雾 · 信源甄别', size: 8, playerShips: [5, 3, 2, 1], enemyShips: [5, 4, 2, 2],\n    enemyDoubleEvery: 0, playerDoubleEvery: 0, evidenceEpochEvery: 0,\n    radarCharges: 2, dualCharges: 1, tripleCharges: 1, clueLimit: 2, defaultClues: 1, enemyPursuit: 'random',\n    reward: 'fork', rewardName: 'Fork / Merge',\n    briefing: '轻量舰体已启用，双方普通攻击仍每轮一发。结合时间范围与全文检索排除同名干扰；雷达与多点炮均为有限库存。' },\n  { id: 3, title: '分支 · 变化的口令', size: 10, playerShips: [5, 4, 4, 3, 2], enemyShips: [5, 4, 4, 3, 2],\n    enemyDoubleEvery: 4, playerDoubleEvery: 0, evidenceEpochEvery: 3,\n    radarCharges: 3, dualCharges: 2, tripleCharges: 1, clueLimit: 2, defaultClues: 1, enemyPursuit: 'adjacent',\n    reward: 'mysql', rewardName: 'MySQL 兼容',\n    briefing: '10×10海域增配侦察资源，敌军每四轮双炮，前一轮预告。Fork重开保留敌位与公开笔记，使用后两关冷却，第三关恢复。' },\n  { id: 4, title: '混合 · 同名异舰', size: 10, playerShips: [5, 5, 4, 3, 2], enemyShips: [5, 5, 4, 4, 2],\n    enemyDoubleEvery: 3, playerDoubleEvery: 4, evidenceEpochEvery: 3,\n    radarCharges: 3, dualCharges: 2, tripleCharges: 1, clueLimit: 2, defaultClues: 1, enemyPursuit: 'linear',\n    reward: 'distributed', rewardName: '分布式扩展',\n    briefing: 'MySQL兼容双响炮复制每四轮双响协议；敌军升级为每三轮双炮并提前一轮预告。混合检索带回固定坐标线索，不返回单舰位置。' },\n  { id: 5, title: '扩展 · 旧日回声', size: 12, playerShips: [6, 5, 5, 4, 3, 2], enemyShips: [6, 5, 5, 4, 3, 2, 1],\n    enemyDoubleEvery: 3, playerDoubleEvery: 4, evidenceEpochEvery: 3,\n    radarCharges: 5, dualCharges: 3, tripleCharges: 2, clueLimit: 3, defaultClues: 1, enemyPursuit: 'linear',\n    reward: 'piercing', rewardName: '异步索引', extraRewards: ['ultimate'],\n    briefing: '分布式扩展弹参照TARTAR，攻击4×4范围四角4点，每关一次，由真实SQL选格；特殊弹占用整次炮击，不叠加普通双炮。敌方潜艇仅1格，建议预留雷达。' },\n  { id: 6, title: '终战 · 双源确认', size: 12, playerShips: [6, 6, 5, 4, 3, 2], enemyShips: [6, 6, 5, 5, 4, 3, 1],\n    enemyDoubleEvery: 2, playerDoubleEvery: 4, evidenceEpochEvery: 3,\n    radarCharges: 5, dualCharges: 3, tripleCharges: 2, clueLimit: 3, defaultClues: 1, enemyPursuit: 'linear',\n    reward: null, rewardName: '战役完成',\n    briefing: '终战敌军每两轮双炮并提前一轮预告。究极分布式扩展弹参照TRIDENT D9隔格九点，与分布式扩展弹共享一次弹包；异步索引导弹另有一次HARPOON五点X攻击。敌方潜艇仅1格，建议预留雷达。' },\n].map(level => Object.freeze({ ...level, playerShips: Object.freeze(level.playerShips), enemyShips: Object.freeze(level.enemyShips),\n  ...(level.extraRewards ? { extraRewards: Object.freeze(level.extraRewards) } : {}) })));\n\n// 保留普通海战的扫格时间；SQL提供战场和固定半盘带，仍需靠公开炮击寻找舰船。\nexport const ROUND_LIMITS = Object.freeze([48, 48, 70, 70, 96, 100]);\n\n/** 预告只依赖关卡与轮次，不读取布局或受击信息。 */\nexport function enemyFirePlan(level = 1, round = 1) {\n  const definition = typeof level === 'number' ? LEVELS.find(item => item.id === level) : level;\n  if (!definition || !Number.isInteger(round) || round \u003c 1) throw new RangeError('关卡或轮次无效');\n  const every = definition.enemyDoubleEvery;\n  const shots = every && round % every === 0 ? 2 : 1;\n  const nextShots = every && (round + 1) % every === 0 ? 2 : 1;\n  return { shots, nextShots, warning: nextShots === 2 };\n}\n\nexport const TACTICAL_FEATURES = Object.freeze([\n  '军用特征', '发动机低频', '航速', '舰体尺度', '雷达强度', '热源', '金属回波', '编队规律',\n]);\n\nconst WARSHIP_VECTOR = Object.freeze([0.96, 0.86, 0.72, 0.78, 0.9, 0.82, 0.93, 0.86]);\nconst CIVIL_VECTOR = Object.freeze([0.12, 0.42, 0.36, 0.82, 0.28, 0.54, 0.64, 0.08]);\nconst BUOY_VECTOR = Object.freeze([0.06, 0.04, 0.01, 0.08, 0.45, 0.03, 0.18, 0.02]);\nconst CALL_SIGNS = ['TERN', 'KITE', 'PETREL', 'GULL', 'HERON', 'KESTREL', 'OSPREY', 'SWIFT'];\n\nfunction hashSeed(seed) {\n  const text = String(seed);\n  let hash = 2166136261;\n  for (let index = 0; index \u003c text.length; index += 1) {\n    hash ^= text.charCodeAt(index);\n    hash = Math.imul(hash, 16777619);\n  }\n  return hash >>> 0;\n}\n\n/** 返回 [0, 1) 的可复现随机数函数，种子支持数字和字符串。 */\nexport function createRng(seed = 1) {\n  let state = hashSeed(seed);\n  return function random() {\n    state = (state + 0x6D2B79F5) >>> 0;\n    let value = state;\n    value = Math.imul(value ^ (value >>> 15), value | 1);\n    value ^= value + Math.imul(value ^ (value >>> 7), value | 61);\n    return ((value ^ (value >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\nfunction shuffled(items, rng) {\n  const result = [...items];\n  for (let index = result.length - 1; index > 0; index -= 1) {\n    const next = Math.floor(rng() * (index + 1));\n    [result[index], result[next]] = [result[next], result[index]];\n  }\n  return result;\n}\n\nconst coordinateKey = cell => `${cell.x},${cell.y}`;\nconst inBounds = (cell, size) => Number.isInteger(cell?.x) && Number.isInteger(cell?.y)\n  && cell.x >= 0 && cell.x \u003c size && cell.y >= 0 && cell.y \u003c size;\n\n/** 本作双方明确采用含对角的间距规则；这是用户确认的改编，GBC原作允许邻接。 */\nexport function createFleet(lengths, { size = 8, seed = 1, lightweight = false, noTouch = true } = {}) {\n  if (!Number.isInteger(size) || size \u003c 2 || size > 16 || !Array.isArray(lengths)\n    || lengths.length === 0 || lengths.length > size * size\n    || lengths.some(length => !Number.isInteger(length) || length \u003c 1 || length > size)) {\n    throw new RangeError('舰长或棋盘尺寸无效');\n  }\n  const rng = createRng(seed);\n  const lightIndex = lightweight ? lengths.indexOf(Math.max(...lengths)) : -1;\n  const specs = lengths.map((originalLength, index) => ({\n    id: `ship-${index + 1}`, originalLength,\n    length: index === lightIndex && originalLength > 2 ? originalLength - 1 : originalLength,\n    index,\n  }));\n  const ordered = [...specs].sort((a, b) => b.length - a.length);\n  const occupied = [];\n  const placed = [];\n  let searchSteps = 0;\n\n  function place(depth) {\n    if (depth === ordered.length) return true;\n    if (searchSteps > 200000) return false;\n    const spec = ordered[depth];\n    const candidates = [];\n    for (let y = 0; y \u003c size; y += 1) {\n      for (let x = 0; x \u003c size; x += 1) {\n        for (const horizontal of spec.length === 1 ? [true] : [true, false]) {\n          const cells = Array.from({ length: spec.length }, (_, offset) => ({\n            x: x + (horizontal ? offset : 0), y: y + (horizontal ? 0 : offset),\n          }));\n          if (cells.every(cell => inBounds(cell, size))) candidates.push(cells);\n        }\n      }\n    }\n    for (const cells of shuffled(candidates, rng)) {\n      searchSteps += 1;\n      const blocked = cells.some(cell => occupied.some(other => noTouch\n        ? Math.abs(cell.x - other.x) \u003c= 1 && Math.abs(cell.y - other.y) \u003c= 1\n        : cell.x === other.x && cell.y === other.y));\n      if (blocked) continue;\n      occupied.push(...cells);\n      placed.push({ ...spec, cells });\n      if (place(depth + 1)) return true;\n      placed.pop();\n      occupied.splice(occupied.length - cells.length, cells.length);\n    }\n    return false;\n  }\n  if (!place(0)) throw new RangeError('当前舰队无法在棋盘中合法部署');\n\n  return {\n    size, noTouch,\n    ships: placed.sort((a, b) => a.index - b.index).map(({ index, ...spec }) => ({\n      ...spec, sunk: false,\n      cells: spec.cells.map(cell => ({ ...cell, hp: 1, maxHp: 1 })),\n    })),\n    shots: {},\n  };\n}\n\nexport const ENEMY_LAYOUT_POOL_SIZE = 128;\nexport const ENEMY_LAYOUT_POOL_VERSION = 'seekdb-naval-layout-pool-v1';\nconst enemyLayoutPools = new Map();\n\n/** 每关公开固定阵形池；campaignSeed只选择索引，返回副本防止污染缓存。 */\nexport function createEnemyFleet({ level = 1, seed = 1 } = {}) {\n  const definition = typeof level === 'number' ? LEVELS.find(item => item.id === level) : level;\n  if (!definition || !Array.isArray(definition.enemyShips)) throw new RangeError('缺少有效关卡配置');\n  const config = `${definition.id}|${definition.size}|${definition.enemyShips.join(',')}`;\n  if (!enemyLayoutPools.has(config)) {\n    enemyLayoutPools.set(config, Array.from({ length: ENEMY_LAYOUT_POOL_SIZE }, (_, index) => createFleet(definition.enemyShips,\n      { size: definition.size, seed: `${ENEMY_LAYOUT_POOL_VERSION}|${config}|${index}` })));\n  }\n  const layoutIndex = hashSeed(`${seed}|enemy-layout|${definition.id}`) % ENEMY_LAYOUT_POOL_SIZE;\n  return { ...JSON.parse(JSON.stringify(enemyLayoutPools.get(config)[layoutIndex])), layoutIndex, layoutPoolSize: ENEMY_LAYOUT_POOL_SIZE };\n}\n\n/** 校验人工部署及移动后的舰队；受损舰船的 hp 为零仍是合法布局。 */\nexport function validateFleet(fleet) {\n  const errors = [];\n  if (!fleet || !Number.isInteger(fleet.size) || fleet.size \u003c 2 || !Array.isArray(fleet.ships) || !fleet.ships.length) {\n    return { ok: false, errors: ['缺少有效的棋盘或舰队'] };\n  }\n  const occupied = new Map();\n  const identifiers = new Set();\n  fleet.ships.forEach((ship, index) => {\n    if (!ship?.id || identifiers.has(ship.id)) errors.push(`第 ${index + 1} 艘舰编号重复或缺失`);\n    identifiers.add(ship?.id);\n    if (!Array.isArray(ship?.cells) || !ship.cells.length || ship.cells.length !== ship.length) {\n      errors.push(`第 ${index + 1} 艘舰长度不匹配`);\n      return;\n    }\n    const xs = new Set(ship.cells.map(cell => cell.x));\n    const ys = new Set(ship.cells.map(cell => cell.y));\n    if (xs.size !== 1 && ys.size !== 1) errors.push(`第 ${index + 1} 艘舰必须横放或竖放`);\n    const axis = ys.size === 1 ? 'x' : 'y';\n    const positions = ship.cells.map(cell => cell[axis]).sort((a, b) => a - b);\n    if (positions.some((value, next) => next > 0 && value !== positions[next - 1] + 1)) {\n      errors.push(`第 ${index + 1} 艘舰必须连续`);\n    }\n    ship.cells.forEach(cell => {\n      if (!inBounds(cell, fleet.size)) errors.push('舰体越出棋盘');\n      if (cell.maxHp !== 1 || !Number.isInteger(cell.hp) || cell.hp \u003c 0 || cell.hp > 1) {\n        errors.push('舰体血量无效');\n      }\n      const key = coordinateKey(cell);\n      if (occupied.has(key)) errors.push(`${String.fromCharCode(65+cell.x)}${cell.y+1}：第${index+1}艘舰与第${occupied.get(key)+1}艘舰重叠`);\n      occupied.set(key, index);\n    });\n    if (ship.cells.reduce((sum, cell) => sum + cell.maxHp, 0) !== ship.length) errors.push('舰体总血量与实际舰长不符');\n  });\n  if (fleet.noTouch !== false) {\n    for (const [key, shipIndex] of occupied) {\n      const [x, y] = key.split(',').map(Number);\n      for (let dy = -1; dy \u003c= 1; dy += 1) {\n        for (let dx = -1; dx \u003c= 1; dx += 1) {\n          const other = occupied.get(`${x + dx},${y + dy}`);\n          if (other !== undefined && other !== shipIndex) errors.push(`${String.fromCharCode(65+x)}${y+1} 与 ${String.fromCharCode(65+x+dx)}${y+dy+1} 的不同舰船${dx&&dy?'斜角':'边缘'}接壤`);\n        }\n      }\n    }\n  }\n  return { ok: errors.length === 0, errors: [...new Set(errors)] };\n}\n\n/** 部署提示只标其他固定舰周围的空格，不把选中舰自身或舰体涂成禁放格。 */\nexport function placementBlockedCells(fleet, movingShipIndex=0) {\n  if(!fleet?.ships || fleet.noTouch===false)return [];\n  const occupied=new Set(fleet.ships.flatMap(ship=>ship.cells.map(coordinateKey))),blocked=new Map();\n  fleet.ships.forEach((ship,index)=>{\n    if(index===movingShipIndex)return;\n    for(const cell of ship.cells)for(let dy=-1;dy\u003c=1;dy++)for(let dx=-1;dx\u003c=1;dx++){\n      const next={x:cell.x+dx,y:cell.y+dy};\n      if(inBounds(next,fleet.size)&&!occupied.has(coordinateKey(next)))blocked.set(coordinateKey(next),next);\n    }\n  });\n  return [...blocked.values()];\n}\n\n/** 每格一击，命中和落空都记入攻击史；同关禁止再次投弹。 */\nexport function applyShot(fleet, target) {\n  if (!inBounds(target, fleet.size)) return { valid: false, error: '炮击坐标必须是棋盘内整数格', ...target };\n  const key = coordinateKey(target);\n  const ship = fleet.ships.find(candidate => candidate.cells.some(cell => coordinateKey(cell) === key));\n  const cell = ship?.cells.find(candidate => coordinateKey(candidate) === key);\n  if (fleet.shots[key] || (cell && cell.hp === 0)) {\n    return { valid: false, error: '该格本关已经投过弹，请选择未攻击坐标', ...target };\n  }\n  if (cell) cell.hp -= 1;\n  const sunk = Boolean(ship && ship.cells.every(part => part.hp === 0));\n  if (sunk) ship.sunk = true;\n  const remainingHp = fleet.ships.reduce((total, candidate) => total + candidate.cells.reduce((sum, part) => sum + part.hp, 0), 0);\n  const result = {\n    valid: true, x: target.x, y: target.y, kind: cell ? (sunk ? 'sunk' : 'hit') : 'miss',\n    cellCleared: !cell || cell.hp === 0, cellHp: cell?.hp ?? 0,\n    shipId: sunk ? ship.id : null,\n    sunkCells: sunk ? ship.cells.map(part => ({ x: part.x, y: part.y })) : [],\n    remainingHp, defeated: remainingHp === 0,\n  };\n  fleet.shots[key] = { ...result, attempts: (fleet.shots[key]?.attempts ?? 0) + 1 };\n  return result;\n}\n\n/** 双炮与特殊弹都用此函数先校验整次齐射，再逐格结算。 */\nexport function validateSalvo(targets, maxShots, size = 8) {\n  const errors = [];\n  if (!Array.isArray(targets) || targets.length === 0 || !Number.isInteger(maxShots) || maxShots \u003c 1 || targets.length > maxShots) {\n    errors.push('齐射数量不合法');\n  } else {\n    if (targets.some(cell => !inBounds(cell, size))) errors.push('齐射坐标越界或不是整数');\n    if (new Set(targets.map(coordinateKey)).size !== targets.length) errors.push('同一次齐射不能重复攻击同一格');\n  }\n  return { ok: errors.length === 0, errors };\n}\n\n/** history 接受 knowledge.shots/fleet.shots 字典、坐标数组或坐标键Set。 */\nexport function validateNewBombs(cells, history = {}, size = 8) {\n  const result = validateSalvo(cells, Array.isArray(cells) ? Math.max(1, cells.length) : 1, size);\n  if (!result.ok) return result;\n  const keys = history instanceof Set ? history : Array.isArray(history)\n    ? new Set(history.map(item => typeof item === 'string' ? item : coordinateKey(item)))\n    : new Set(Object.keys(history.shots ?? history));\n  if (cells.some(cell => keys.has(coordinateKey(cell)))) result.errors.push('范围内含本关已经投过弹的坐标');\n  return { ok: result.errors.length === 0, errors: result.errors };\n}\n\n/** 原作多点模板；I的偶数4×4范围以中间四格左上格为锚点，边缘裁剪，不使用方向参数。 */\nexport function weaponPattern(kind, anchor, size = 8) {\n  if (!Number.isInteger(size) || size \u003c 2 || !inBounds(anchor, size)) throw new RangeError('武器中心必须位于棋盘内');\n  let offsets;\n  if (kind === 'distributed_i') offsets = [-1, 2].flatMap(dy => [-1, 2].map(dx => [dx, dy]));\n  else if (kind === 'distributed' || kind === 'distributed_ii') offsets = [-2, 0, 2].flatMap(dy => [-2, 0, 2].map(dx => [dx, dy]));\n  else if (kind === 'piercing') offsets = [[-1, -1], [1, -1], [0, 0], [-1, 1], [1, 1]];\n  else throw new RangeError('未知的特殊武器类型');\n  return offsets.map(([dx, dy]) => ({ x: anchor.x + dx, y: anchor.y + dy })).filter(cell => inBounds(cell, size));\n}\n\n/** 正式多点武器以完整外框左上角为锚点；放不下返回[]，不裁剪图案。 */\nexport function weaponPatternAtAnchor(kind, anchor, size = 8) {\n  const shape = kind === 'distributed_i' ? { span: 4, offset: 1 }\n    : kind === 'distributed_ii' || kind === 'distributed' ? { span: 5, offset: 2 }\n      : kind === 'piercing' ? { span: 3, offset: 1 } : null;\n  if (!shape) throw new RangeError('未知的特殊武器类型');\n  if (!Number.isInteger(size) || size \u003c 2) throw new RangeError('棋盘尺寸无效');\n  if (!inBounds(anchor, size) || anchor.x + shape.span > size || anchor.y + shape.span > size) return [];\n  return weaponPattern(kind, { x: anchor.x + shape.offset, y: anchor.y + shape.offset }, size);\n}\n\nexport function createKnowledge(size = 8) {\n  return { size, shots: {}, sunkShips: [] };\n}\n\n/** 只保存炮击公开回执，不接受敌舰布局。 */\nexport function recordShot(knowledge, result) {\n  if (!result?.valid) return knowledge;\n  const key = coordinateKey(result);\n  knowledge.shots[key] = {\n    x: result.x, y: result.y,\n    state: result.kind === 'miss' ? 'miss' : result.kind === 'sunk' ? 'sunk' : result.cellCleared ? 'hit' : 'damaged',\n    cellCleared: result.cellCleared,\n    attempts: (knowledge.shots[key]?.attempts ?? 0) + 1,\n  };\n  if (result.kind === 'sunk') {\n    const cells = result.sunkCells.map(cell => ({ x: cell.x, y: cell.y }));\n    if (!knowledge.sunkShips.some(ship => ship.id === result.shipId)) knowledge.sunkShips.push({ id: result.shipId, cells });\n    for (const cell of cells) {\n      const previous = knowledge.shots[coordinateKey(cell)];\n      knowledge.shots[coordinateKey(cell)] = { ...previous, ...cell, state: 'sunk', cellCleared: true };\n    }\n  }\n  return knowledge;\n}\n\n/**\n * AI 的全部输入只有公开炮击知识：沿命中线追击，最后随机搜索；不重复投弹。\n * 一次齐射的全部目标在任何回执出现前决定，双炮不能偷看第一炮结果。\n */\nexport function chooseEnemyShots(knowledge, count = 1, rng = createRng(1), { pursuit = 'linear' } = {}) {\n  const { size, shots } = knowledge;\n  const limit = Number.isInteger(count) && count > 0 ? count : 0;\n  const available = cell => inBounds(cell, size) && !shots[coordinateKey(cell)];\n  const selected = [];\n  const selectedKeys = new Set();\n  const append = cells => {\n    for (const cell of cells) {\n      const clean = { x: cell.x, y: cell.y };\n      const key = coordinateKey(clean);\n      if (selected.length \u003c limit && available(clean) && !selectedKeys.has(key)) {\n        selected.push(clean);\n        selectedKeys.add(key);\n      }\n    }\n  };\n  const hits = pursuit === 'random' ? [] : Object.values(shots).filter(shot => shot.state === 'hit' || shot.state === 'damaged');\n\n  const linear = [];\n  for (let first = 0; pursuit === 'linear' && first \u003c hits.length; first += 1) {\n    for (let second = first + 1; second \u003c hits.length; second += 1) {\n      const a = hits[first];\n      const b = hits[second];\n      if (a.y === b.y && Math.abs(a.x - b.x) === 1) {\n        linear.push({ x: Math.min(a.x, b.x) - 1, y: a.y }, { x: Math.max(a.x, b.x) + 1, y: a.y });\n      }\n      if (a.x === b.x && Math.abs(a.y - b.y) === 1) {\n        linear.push({ x: a.x, y: Math.min(a.y, b.y) - 1 }, { x: a.x, y: Math.max(a.y, b.y) + 1 });\n      }\n    }\n  }\n  append(shuffled(linear, rng));\n  const adjacent = hits.flatMap(cell => [\n    { x: cell.x - 1, y: cell.y }, { x: cell.x + 1, y: cell.y },\n    { x: cell.x, y: cell.y - 1 }, { x: cell.x, y: cell.y + 1 },\n  ]);\n  append(shuffled(adjacent, rng));\n  const sea = [];\n  for (let y = 0; y \u003c size; y += 1) {\n    for (let x = 0; x \u003c size; x += 1) sea.push({ x, y });\n  }\n  append(shuffled(sea, rng));\n  return selected;\n}\n\n/** 全球海域由4×4个交战窗口构成，步长为半盘；舰队仍使用真实窗口内local坐标。 */\nexport function sectorBounds(sector, windowSize) {\n  if (!/^S(?:[1-9]|1[0-6])$/.test(sector) || !Number.isInteger(windowSize) || windowSize \u003c 2 || windowSize > 16 || windowSize % 2 !== 0) {\n    throw new RangeError('交战窗口编号或尺寸无效');\n  }\n  const index = Number(sector.slice(1)) - 1;\n  const minX = index % 4 * windowSize / 2;\n  const minY = Math.floor(index / 4) * windowSize / 2;\n  return { minX, minY, maxX: minX + windowSize - 1, maxY: minY + windowSize - 1, width: windowSize, height: windowSize };\n}\n\n/** 偏离半盘时0.55，偏离一整盘及以上为0；中间采用连续分段线性衰减。 */\nexport function targetingAccuracy(selectedBounds, targetBounds) {\n  const centerX = bounds => (bounds.minX + bounds.maxX) / 2;\n  const centerY = bounds => (bounds.minY + bounds.maxY) / 2;\n  const deviation = Math.max(Math.abs(centerX(selectedBounds) - centerX(targetBounds)) / targetBounds.width,\n    Math.abs(centerY(selectedBounds) - centerY(targetBounds)) / targetBounds.height);\n  if (deviation >= 1) return 0;\n  return deviation \u003c= 0.5 ? 1 - 0.9 * deviation : 1.1 * (1 - deviation);\n}\n\n/** 打偏不等于落空，调用方不可把drift写成已排除格；准确选区不额外消耗随机数。 */\nexport function resolveAim({ selectedBounds, targetBounds, cell, rng }) {\n  if (!Number.isInteger(cell?.x) || !Number.isInteger(cell?.y) || cell.x \u003c 0 || cell.y \u003c 0\n    || cell.x >= selectedBounds.width || cell.y >= selectedBounds.height) throw new RangeError('瞄准格必须位于所选交战窗口内');\n  const accuracy = targetingAccuracy(selectedBounds, targetBounds);\n  if (accuracy === 0) return { drift: true, target: null, accuracy };\n  if (accuracy \u003c 1) {\n    if (typeof rng !== 'function') throw new TypeError('偏区瞄准必须提供可复现随机数函数');\n    if (rng() >= accuracy) return { drift: true, target: null, accuracy };\n  }\n  const x = selectedBounds.minX + cell.x - targetBounds.minX;\n  const y = selectedBounds.minY + cell.y - targetBounds.minY;\n  const target = x >= 0 && x \u003c targetBounds.width && y >= 0 && y \u003c targetBounds.height ? { x, y } : null;\n  return { drift: false, target, accuracy };\n}\n\n/** 只根据数据库实际返回cells计算边界；空集、缺格、重复格或非法坐标返回null。 */\nexport function boundsFromCells(input) {\n  let cells;\n  try { cells = typeof input === 'string' ? JSON.parse(input) : input; } catch { return null; }\n  if (!Array.isArray(cells) || !cells.length || cells.some(cell => !Number.isInteger(cell?.x) || !Number.isInteger(cell?.y) || cell.x \u003c 0 || cell.y \u003c 0)) return null;\n  const minX = Math.min(...cells.map(cell => cell.x));\n  const maxX = Math.max(...cells.map(cell => cell.x));\n  const minY = Math.min(...cells.map(cell => cell.y));\n  const maxY = Math.max(...cells.map(cell => cell.y));\n  const width = maxX - minX + 1;\n  const height = maxY - minY + 1;\n  if (width * height !== cells.length || new Set(cells.map(coordinateKey)).size !== cells.length) return null;\n  return { minX, minY, maxX, maxY, width, height };\n}\n\nfunction sectorCells(sector, windowSize) {\n  const bounds = sectorBounds(sector, windowSize);\n  return Array.from({ length: windowSize * windowSize }, (_, offset) => ({\n    x: bounds.minX + offset % windowSize, y: bounds.minY + Math.floor(offset / windowSize),\n  }));\n}\n\nconst BAND_TYPES = ['west', 'east', 'north', 'south'];\nfunction inHalfBand(cell, type, size) {\n  return type === 'west' ? cell.x \u003c size / 2 : type === 'east' ? cell.x >= size / 2\n    : type === 'north' ? cell.y \u003c size / 2 : cell.y >= size / 2;\n}\n\n/**\n * 资料只记录完整交战窗口。目标窗口由seed与关卡确定，不能随轮次、命中或舰损变化。\n * signature 是人工定义的八维战术特征，不是通用语言模型的语义嵌入。\n * truth 仅供生成质量检查；不要将 truth、fleet 或 ships 插入 intelligence。\n */\nexport function generateEvidence({ fleet, level = 1, round = 1, seed = 1 } = {}) {\n  const definition = typeof level === 'number' ? LEVELS.find(item => item.id === level) : level;\n  if (!definition || !Number.isInteger(round) || round \u003c 1) throw new RangeError('关卡或回合无效');\n  if (fleet?.size !== definition.size || !Array.isArray(fleet.ships) || !fleet.ships.length) throw new RangeError('裁判舰队尺寸必须与本关交战窗口一致');\n  const windowSize = definition.size;\n  const worldSize = windowSize + windowSize / 2 * 3;\n  const phase = definition.evidenceEpochEvery ? Math.floor((round - 1) / definition.evidenceEpochEvery) + 1 : 1;\n  const rng = createRng(`${seed}|evidence|${definition.id}|${phase}|${round}`);\n  const missionId = `mission-${definition.id}-${hashSeed(seed).toString(16)}`;\n  const oldMission = `${missionId}-old`;\n  const windowRng = createRng(`${seed}|combat-window|${definition.id}`);\n  const targetSector = `S${1 + Math.floor(windowRng() * 16)}`;\n  // 用开局完整舰体采样一次；不能根据剩余HP或轮次追踪目标、持续缩窄活动带。\n  const clueSeed = `${seed}|tactical-clues|${definition.id}`;\n  const trueClues = generateTacticalClues({ fleet, level: definition, seed: clueSeed });\n  const targetBand = BAND_TYPES.find(type => trueClues[0].cells.every(cell => inHalfBand(cell, type, windowSize)));\n  const cluesBySector = new Map([[targetSector, trueClues]]);\n  const emptySectors = shuffled(Array.from({ length: 16 }, (_, index) => `S${index + 1}`)\n    .filter(sector => sector !== targetSector), rng);\n  const falseSector = index => emptySectors[index % emptySectors.length] ?? `S${((Number(targetSector.slice(1)) + index) % 16) + 1}`;\n  const callSign = CALL_SIGNS[(hashSeed(seed) + definition.id + phase) % CALL_SIGNS.length];\n  const rows = [];\n  const prefix = `l${definition.id}-r${round}`;\n\n  function observation({ label, sector = targetSector, source = '岸基观察站', confidence = 92,\n    observedRound = round, mission = missionId, shipClass = 'warship', callsign = callSign,\n    vector = WARSHIP_VECTOR, text = '截获军用发动机和编队回波。' }) {\n    const signature = vector.map(value => Number(Math.max(0, Math.min(1, value + (rng() - 0.5) * 0.04)).toFixed(4)));\n    if (!cluesBySector.has(sector)) {\n      const synthetic = createFleet(definition.enemyShips, { size: windowSize, seed: `${clueSeed}|synthetic|${sector}` });\n      cluesBySector.set(sector, generateTacticalClues({ fleet: synthetic, level: definition, seed: `${clueSeed}|${sector}` }));\n    }\n    const bounds = sectorBounds(sector, windowSize);\n    const clues = cluesBySector.get(sector).map(clue => ({ ...clue,\n      ...(clue.cells ? { cells: clue.cells.map(cell => ({ x: cell.x + bounds.minX, y: cell.y + bounds.minY })) } : {}) }));\n    const tacticalHint = clues[0].text;\n    rows.push({ id: `${prefix}-${label}`, sector_id: sector, cells: JSON.stringify(sectorCells(sector, windowSize)),\n      tactical_cells: JSON.stringify(clues[0].cells), tactical_hint: tacticalHint, tactical_clues: JSON.stringify(clues),\n      body: `${source} REPORT ${callsign} : 全海域${worldSize}×${worldSize}，登记${windowSize}×${windowSize}战场与开局固定粗线索，不提供单舰格。${text}`, source, confidence,\n      observed_round: observedRound, mission_id: mission, ship_class: shipClass,\n      call_sign: callsign, signature, embedding: [...signature] });\n  }\n  observation({ label: 'coast', confidence: 94, text: `第 ${phase} 版口令确认，低频发动机与军用编队特征吻合。` });\n  observation({ label: 'radar', source: '舰载雷达站', confidence: 93, text: '另一独立站点观测到同类目标，位置只精确到大致海区。' });\n  // 干扰按能力逐关激活：范围、全文、向量、条件。尚未教学的干扰归入第0轮档案。\n  // 旧任务、过期、民船均给双源记录，防止终关的双源条件替代其他检索能力。\n  for (const [source, suffix, confidence] of [['岸基观察站', 'coast', 93], ['舰载雷达站', 'radar', 92]]) {\n    observation({ label: suffix === 'coast' ? 'old' : 'archive-echo', sector: falseSector(1),\n      source, confidence, mission: oldMission, observedRound: definition.id >= 4 ? round : 0,\n      text: '上一次任务的同代号军用回波；观察轮次与任务编号都应核对，第0轮是出航前档案。' });\n    observation({ label: suffix === 'coast' ? 'expired' : 'expired-radar', sector: falseSector(2),\n      source, confidence, observedRound: Math.max(0, round - 4), text: '本任务的同代号旧时段监听，已超出当前有效时间窗。' });\n    observation({ label: suffix === 'radar' ? 'civil' : 'civil-coast', sector: falseSector(3),\n      source, confidence, shipClass: 'merchant', vector: CIVIL_VECTOR, observedRound: definition.id >= 3 ? round : 0,\n      text: '相同代号，但低频和编队规律符合民船；第0轮属档案，当前轮次记录应比较战术特征。' });\n    for (const [tag, sectorOffset] of [['a', 4], ['b', 5]]) {\n      observation({ label: `other-${tag}-${suffix}`, sector: falseSector(sectorOffset),\n        source, confidence, callsign: tag === 'a' ? 'SCOUTA' : 'SCOUTB', observedRound: definition.id >= 2 ? round : 0,\n        text: '军用回波与任务一致，但编队口令不同；第0轮是档案，当前记录需要全文代号匹配。' });\n    }\n  }\n  observation({ label: 'rumor', sector: falseSector(0), source: 'RUMOR', confidence: 96, observedRound: definition.id >= 4 ? round : 0,\n    text: '港口转述本任务的同代号军用回波，自报可信度很高，却没有独立站点确认。' });\n  observation({ label: 'rumor-repeat', sector: falseSector(0), source: 'RUMOR', confidence: 95, observedRound: definition.id >= 4 ? round : 0,\n    text: '另一份转载仍来自同一个传闻来源，不能把转载次数当作独立信源。' });\n  observation({ label: 'weather', sector: falseSector(6), source: '舰载雷达站', confidence: 98, observedRound: 0,\n    shipClass: 'buoy', vector: BUOY_VECTOR, callsign: 'WEATHER', text: '气象浮标记录真实，但不能用于寻找敌舰。' });\n  if (definition.id >= 6) {\n    observation({ label: 'single-source', sector: falseSector(6), source: '岸基观察站', confidence: 94,\n      text: '单站异常回波；信源身份有效，但尚无第二个独立来源复核。' });\n  }\n  const rangeStart = Math.max(1, round - 2);\n  const title = (intro, neutral) => definition.id === 1 ? intro : neutral;\n  const cards = [\n    { id: `${prefix}-keyword`, kind: 'keyword', title: title('当前作战口令', '监听摘录 A'),\n      body: `本轮作战通知：军舰使用英文代号 ${callSign}。全文检索应保留完整代号。`, payload: { keyword: callSign } },\n    { id: `${prefix}-civil-keyword`, kind: 'keyword', title: title('渡轮时刻表', '监听摘录 B'),\n      body: '港内渡轮代号 FERRY，资料真实，是否与本次找舰有关需要判断。', payload: { keyword: 'FERRY' } },\n    { id: `${prefix}-vector`, kind: 'vector', title: title('军用回波特征', '声纹样本 A'),\n      body: '参考军舰的发动机低频、航速、金属回波和编队规律，共八维人工战术特征。', payload: { vector: [...WARSHIP_VECTOR] } },\n    { id: `${prefix}-civil-vector`, kind: 'vector', title: title('民船回波手册', '声纹样本 B'),\n      body: '商船舰体较大，但军用特征与编队规律较弱；这是民船参考向量。', payload: { vector: [...CIVIL_VECTOR] } },\n    { id: `${prefix}-filter`, kind: 'filter', title: title('当前任务与信源', '任务附件 A'),\n      body: `当前任务 ${missionId}；采用 岸基观察站 / 舰载雷达站 独立站点，可信度至少 85${definition.id >= 6 ? '，同海区至少两个来源' : ''}。`,\n      payload: { missionId, minConfidence: 85, sources: ['岸基观察站', '舰载雷达站'], minSources: definition.id >= 6 ? 2 : 1 } },\n    { id: `${prefix}-old-filter`, kind: 'filter', title: title('历史任务封面', '任务附件 B'),\n      body: `档案任务 ${oldMission}，记录有签名，但属于上一次行动。`,\n      payload: { missionId: oldMission, minConfidence: 85, sources: ['岸基观察站', '舰载雷达站'], minSources: 1 } },\n    { id: `${prefix}-range`, kind: 'range', title: title('本轮有效时间窗', '时间附件 A'),\n      body: `本轮为第 ${round} 轮，采用第 ${rangeStart}～${round} 轮监听；第0轮是档案。查询同时返回战场和固定坐标粗线索。`,\n      payload: { minRound: rangeStart, maxRound: round } },\n    { id: `${prefix}-old-range`, kind: 'range', title: title('旧版监听时间窗', '时间附件 B'),\n      body: `旧版资料时间窗为第 0～${Math.max(0, round - 3)} 轮，注意它与当前时间窗的差异。`,\n      payload: { minRound: 0, maxRound: Math.max(0, round - 3) } },\n    { id: `${prefix}-rumor-filter`, kind: 'filter', title: title('港口传闻摘录', '转述附件'),\n      body: 'RUMOR 没有独立确认，仅按自报可信度收集，可能存在错误海区。',\n      payload: { missionId, minConfidence: 40, sources: ['RUMOR'], minSources: 1 } },\n    { id: `${prefix}-weather-keyword`, kind: 'keyword', title: title('气象站日志', '监听摘录 C'),\n      body: 'WEATHER 是气象浮标代号。日志可靠，但它的回波不代表军舰。', payload: { keyword: 'WEATHER' } },\n  ];\n  return { cards: shuffled(cards, rng), rows: shuffled(rows, rng), missionId, phase, windowSize, worldSize, tacticalCount: windowSize * windowSize / 2,\n    callSign, featureNames: [...TACTICAL_FEATURES],\n    truth: { targetSector, targetBounds: sectorBounds(targetSector, windowSize), targetBand, reliableRowIds: [`${prefix}-coast`, `${prefix}-radar`] } };\n}\n\nfunction sqlLiteral(value) {\n  // 同时兼容 MySQL 字符串的反斜杠转义与标准单引号转义。\n  return `'${String(value).replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"''\").replaceAll('\\0', '')}'`;\n}\n\n/** 按选中的资料卡构造可直接执行的 seekdb SQL；不访问裁判舰位。 */\nexport function buildQuery({ selectedCards = [], abilities = [], missionId = '', round = 1 } = {}) {\n  const invalid = error => ({ sql: '', description: '', valid: false, error, keyword: null, vector: null });\n  if (!Array.isArray(selectedCards) || !Array.isArray(abilities)) return invalid('资料卡或检索能力格式不正确');\n  const abilityKinds = { fulltext: 'keyword', vector: 'vector', filter: 'filter', range: 'range' };\n  if (abilities.length === 0 || abilities.some(ability => !abilityKinds[ability])) return invalid('至少选择一种有效检索能力');\n  if (new Set(abilities).size !== abilities.length) return invalid('检索能力不能重复');\n  const payloads = {};\n  for (const ability of abilities) {\n    const matches = selectedCards.filter(card => card?.kind === abilityKinds[ability]);\n    if (matches.length !== 1) return invalid(matches.length ? `同类资料只能选择一张：${abilityKinds[ability]}` : `缺少与${ability}匹配的资料卡`);\n    payloads[ability] = matches[0].payload ?? {};\n  }\n  if (selectedCards.some(card => !abilities.some(ability => abilityKinds[ability] === card?.kind))) {\n    return invalid('选中的资料没有配套能力，请移除资料或补上对应能力');\n  }\n  const conditions = [];\n  const descriptions = [];\n  let keyword = null;\n  let vector = null;\n  let distance = '';\n  let minSources = 1;\n  if (payloads.fulltext) {\n    keyword = payloads.fulltext.keyword;\n    if (typeof keyword !== 'string' || !keyword.trim() || keyword.length > 100) return invalid('全文资料缺少有效英文代号');\n    conditions.push(`MATCH(body) AGAINST (${sqlLiteral(keyword)} IN NATURAL LANGUAGE MODE)`);\n    descriptions.push(`全文检索代号 ${keyword}`);\n  }\n  if (payloads.vector) {\n    vector = payloads.vector.vector;\n    if (!Array.isArray(vector) || vector.length !== 8 || vector.some(value => typeof value !== 'number' || !Number.isFinite(value))) {\n      return invalid('战术特征必须是八维有限数值向量');\n    }\n    vector = [...vector];\n    const vectorLiteral = sqlLiteral(JSON.stringify(vector));\n    distance = `l2_distance(embedding, ${vectorLiteral})`;\n    conditions.push(`${distance} \u003c= 0.42`);\n    descriptions.push('八维战术特征的 L2 距离不超过 0.42');\n  }\n  if (payloads.filter) {\n    const filter = payloads.filter;\n    const mission = filter.missionId ?? missionId;\n    if (typeof mission !== 'string' || !mission || !Number.isFinite(filter.minConfidence)\n      || filter.minConfidence \u003c 0 || filter.minConfidence > 100 || !Array.isArray(filter.sources)\n      || !filter.sources.length || filter.sources.some(source => typeof source !== 'string' || !source)) {\n      return invalid('条件资料缺少任务编号、可信度或信源');\n    }\n    minSources = filter.minSources ?? 1;\n    if (!Number.isInteger(minSources) || minSources \u003c 1 || minSources > filter.sources.length) return invalid('独立来源数量不合法');\n    conditions.push(`mission_id = ${sqlLiteral(mission)}`);\n    conditions.push(`confidence >= ${filter.minConfidence}`);\n    conditions.push(`source IN (${filter.sources.map(sqlLiteral).join(', ')})`);\n    descriptions.push(`筛选任务 ${mission}、可靠信源与可信度`);\n  }\n  if (payloads.range) {\n    const { minRound, maxRound } = payloads.range;\n    if (!Number.isInteger(minRound) || !Number.isInteger(maxRound) || minRound \u003c 0 || maxRound \u003c minRound || maxRound > 100000) {\n      return invalid('时间范围必须是有效回合区间');\n    }\n    conditions.push(`observed_round BETWEEN ${minRound} AND ${maxRound}`);\n    descriptions.push(`时间窗为第 ${minRound}～${maxRound} 轮`);\n  }\n  const baseWhere = conditions.join('\\n  AND ');\n  if (minSources > 1) {\n    conditions.push(`sector_id IN (\\n    SELECT sector_id FROM intelligence\\n    WHERE ${baseWhere}\\n    GROUP BY sector_id\\n    HAVING COUNT(DISTINCT source) >= ${minSources}\\n  )`);\n    descriptions.push(`同海区至少 ${minSources} 个独立来源`);\n  }\n  const fields = 'id, sector_id, cells, body, source, confidence, observed_round, tactical_cells, tactical_hint, tactical_clues, fleet_manifest, map_x, map_y, enemy_fire_every, detail_keyword';\n  const sql = `SELECT ${fields}${distance ? `, ${distance} AS distance` : ''}\\nFROM intelligence\\nWHERE ${conditions.join('\\n  AND ')}\\nORDER BY ${distance ? 'distance ASC, ' : ''}confidence DESC, id ASC\\nLIMIT 8;`;\n  return { sql, description: `${descriptions.join('；')}。返回完整战场与开局舰格分布统计，不返回单舰坐标。`, valid: true, error: null, keyword, vector };\n}\n"],"dependencies":["战术线索.mjs"]},"战术规划.mjs":{"kind":"module","parts":["/** 只处理数据库返回的公开粗范围与协议，不接受舰队或实时敌位。 */\nimport {LEVELS,enemyFirePlan} from ",{"ref":"海战规则.mjs"},";\n\nexport const SUPPORT_CODES=Object.freeze(['radar_recommend','safe_mark','relay_target','radar_sweep','radar_filter','pattern_plan']);\nexport const TACTICAL_PATTERNS=Object.freeze(Object.fromEntries([\n  ['radar',2,[[0,0],[1,0],[0,1],[1,1]]],\n  ['distributed_i',4,[[0,0],[3,0],[0,3],[3,3]]],\n  ['distributed_ii',5,[0,2,4].flatMap(dy=>[0,2,4].map(dx=>[dx,dy]))],\n  ['piercing',3,[[0,0],[2,0],[1,1],[0,2],[2,2]]],\n].map(([weapon,span,points])=>[weapon,Object.freeze({span,offsets:Object.freeze(points.map(([dx,dy])=>Object.freeze({dx,dy})))} )])));\n\nconst kinds=new Set(['dense_half','full_ship_band','empty_patch','ship_orientation','ship_crossline','submarine_region']);\nconst proofKeys=new Set(['asOf','fallback','span','emptyCellCount','length','orientation','candidatePlacementCount','quantifier','axis','boundaries','minLength','candidateCellCount','width','targetLength','regionCellCount']);\nconst key=c=>`${c.x},${c.y}`;\nfunction integer(v,min,max,label){if(!Number.isInteger(v)||v\u003cmin||v>max)throw new RangeError(`${label}必须为${min}～${max}的整数`);return v;}\nfunction object(v,label){if(!v||Array.isArray(v)||typeof v!=='object'||Object.getPrototypeOf(v)!==Object.prototype)throw new TypeError(`${label}必须是普通对象`);}\nfunction keys(v,allowed,label){object(v,label);for(const name of Object.keys(v))if(!allowed.has(name))throw new TypeError(`${label}包含未知字段：${name}`);}\nfunction checkSize(size){if(![8,10,12].includes(size))throw new RangeError('棋盘尺寸只支持8、10、12');}\nfunction rectangle(cells,size){\n  if(!cells.length)return null;\n  const x=Math.min(...cells.map(c=>c.x)),y=Math.min(...cells.map(c=>c.y)),w=Math.max(...cells.map(c=>c.x))-x+1,h=Math.max(...cells.map(c=>c.y))-y+1;\n  return cells.length===w*h?{x,y,w,h,stripe:w===size||h===size}:null;\n}\nfunction validateProof(proof,size){\n  if(proof===undefined)return;\n  keys(proof,proofKeys,'公开依据');\n  for(const [name,value] of Object.entries(proof)){\n    if(name==='asOf'){if(value!=='开局')throw new RangeError('公开依据必须是开局观测');}\n    else if(name==='fallback'){if(typeof value!=='boolean')throw new TypeError('fallback必须为布尔值');}\n    else if(name==='orientation'){if(!['horizontal','vertical'].includes(value))throw new RangeError('舰向无效');}\n    else if(name==='axis'){if(!['x','y'].includes(value))throw new RangeError('轴向无效');}\n    else if(name==='quantifier'){if(value!=='at_least_one')throw new RangeError('存在性量词无效');}\n    else if(name==='boundaries'){if(!Array.isArray(value)||value.length!==1)throw new RangeError('分界必须为一条');integer(value[0],1,size-1,'分界');}\n    else integer(value,1,size**3,`公开依据${name}`);\n  }\n}\nfunction validateCells(clue,size,level){\n  if(!Array.isArray(clue.cells)||clue.cells.length>size*size)throw new TypeError('粗范围必须是棋盘内坐标数组');\n  const cells=clue.cells.map(c=>{keys(c,new Set(['x','y']),'粗范围坐标');return{x:integer(c.x,0,size-1,'x'),y:integer(c.y,0,size-1,'y')};});\n  if(new Set(cells.map(key)).size!==cells.length)throw new RangeError('粗范围坐标重复');\n  validateProof(clue.proof,size);const box=rectangle(cells,size),proof=clue.proof??{};\n  if(['dense_half','full_ship_band'].includes(clue.kind)){\n    if(!box?.stripe||cells.length!==size*size/2)throw new RangeError('半盘粗范围不能缩成精确舰格');\n    if(clue.kind==='dense_half'&&!([0,size/2].includes(box.w===size?box.y:box.x)))throw new RangeError('密度半盘起点无效');\n  }else if(clue.kind==='empty_patch'){\n    const span=level===6?3:2;\n    if(![2,5,6].includes(level)||!box||box.w!==span||box.h!==span||proof.span!==span||proof.emptyCellCount!==span*span)throw new RangeError('空海区域必须是本关完整公开方块');\n  }else if(clue.kind==='submarine_region'){\n    const width=level===5?size/2:Math.ceil(size/3)+1;\n    if(![5,6].includes(level)||!box?.stripe||cells.length!==width*size||proof.width!==width||proof.targetLength!==1||proof.regionCellCount!==cells.length)throw new RangeError('潜艇观测必须保留宽区域，不能给单舰坐标');\n  }else if(clue.kind==='ship_orientation'){\n    if(level!==3||cells.length||proof.length!==5||!['horizontal','vertical'].includes(proof.orientation)||proof.candidatePlacementCount!==size*(size-4))throw new RangeError('舰向观测不能携带精确舰格');\n  }else if(clue.kind==='ship_crossline'){\n    if(level!==4||!box?.stripe||cells.length\u003cMath.ceil(size*size/3)||proof.minLength!==4)throw new RangeError('跨线观测必须保留公开候选带');\n  }\n  return cells;\n}\nfunction normalizeProtocol(value,level){\n  const allowed=new Set(['id','code','description',...(level===3?['target_length','period']:level===4?['enemy_period','max_enemy_shots']:[])]);\n  keys(value,allowed,'战术协议');\n  if(value.id!==`level-${level}-support`||value.code!==SUPPORT_CODES[level-1])throw new RangeError('战术协议与关卡不匹配');\n  if(value.description!==undefined&&(typeof value.description!=='string'||value.description.length>500))throw new TypeError('战术说明无效');\n  if(level===3&&(value.target_length!==5||value.period!==4))throw new RangeError('中继协议只接受公开的唯一5格舰与四轮周期');\n  if(level===4&&(value.enemy_period!==3||value.max_enemy_shots!==1))throw new RangeError('扫频协议参数无效');\n  return {...value};\n}\n\n/** 无效资料整批拒绝；目录噪声的空对象不提供任何能力。坐标全部是0起点局部坐标。 */\nexport function normalizeSupportRows(rows,{size,level}={}){\n  checkSize(size);integer(level,1,6,'关卡');if(LEVELS[level-1].size!==size)throw new RangeError('关卡与棋盘尺寸不一致');\n  if(!Array.isArray(rows))throw new TypeError('查询结果必须是数组');\n  const focus=new Map(),submarine=new Map(),safe=new Map(),protocols=new Map();\n  for(const row of rows){\n    object(row,'查询行');if(typeof row.payload_json!=='string'||row.payload_json.length>65536)throw new TypeError('缺少合法payload_json');\n    let payload;try{payload=JSON.parse(row.payload_json);}catch{throw new TypeError('payload_json不是合法JSON');}\n    keys(payload,new Set(['clue','protocol']),'公开战术payload');\n    if(!Object.keys(payload).length){if(row.kind&&row.kind!=='non_tactical')throw new TypeError('战术行缺少公开payload');continue;}\n    keys(payload.clue,new Set(['kind','cells','proof']),'公开线索');const clue=payload.clue;\n    if(!kinds.has(clue.kind)||(row.kind!==undefined&&row.kind!==clue.kind))throw new RangeError('公开线索类型不匹配');\n    const cells=validateCells(clue,size,level);\n    if(['dense_half','full_ship_band','submarine_region'].includes(clue.kind))for(const c of cells)focus.set(key(c),c);\n    if(clue.kind==='submarine_region')for(const c of cells)submarine.set(key(c),c);\n    if(clue.kind==='empty_patch')for(const c of cells)safe.set(key(c),c);\n    if(payload.protocol!==undefined){const p=normalizeProtocol(payload.protocol,level),old=protocols.get(p.id);if(old&&JSON.stringify(old)!==JSON.stringify(p))throw new RangeError('同一协议出现冲突参数');protocols.set(p.id,p);}\n    else if(clue.kind!=='dense_half')throw new TypeError('额外线索缺少本关协议');\n  }\n  const ordered=map=>[...map.values()].sort((a,b)=>a.y-b.y||a.x-b.x),f=ordered(focus),s=ordered(submarine),e=ordered(safe);\n  return{focus:f,submarine:s,safe:e,protocols:[...protocols.values()],cells:[...f.map(c=>({...c,tag:'focus'})),...s.map(c=>({...c,tag:'submarine'})),...e.map(c=>({...c,tag:'safe'}))]};\n}\n\nfunction literal(value,label,max){if(typeof value!=='string'||!value.trim()||value.length>max||value.includes('\\0'))throw new TypeError(`${label}无效`);return`'${value.replaceAll('\\\\','\\\\\\\\').replaceAll(\"'\",\"''\")}'`;}\n\n/** 只按公开候选覆盖排序；旧格与安全格可覆盖，但不给覆盖分。不是命中率。 */\nexport function planSql({weapon,size,missionId,sectorId,limit=2}={}){\n  checkSize(size);if(typeof weapon!=='string'||!Object.hasOwn(TACTICAL_PATTERNS,weapon))throw new RangeError('不支持该规划武器');integer(limit,1,10,'建议数量');\n  const mission=literal(missionId,'任务编号',64);if(typeof sectorId!=='string'||!/^S(?:[1-9]|1[0-6])$/.test(sectorId))throw new RangeError('海区编号无效');const sector=literal(sectorId,'海区编号',8),pattern=TACTICAL_PATTERNS[weapon];\n  const unknown='COALESCE(t.is_safe,0)=0 AND COALESCE(s.is_shot,0)=0';\n  return [\n    'SELECT a.x AS anchor_x, a.y AS anchor_y,',\n    `  SUM(CASE WHEN ${unknown} THEN 1 ELSE 0 END) AS unknown_coverage,`,\n    '  SUM(CASE WHEN COALESCE(s.is_shot,0)=1 THEN 1 ELSE 0 END) AS repeat_count,',\n    '  SUM(CASE WHEN COALESCE(t.is_safe,0)=1 THEN 1 ELSE 0 END) AS safe_count,',\n    '  COUNT(*) AS total_points,',\n    `  SUM(CASE WHEN ${unknown} AND COALESCE(t.is_submarine,0)=1 THEN 1 ELSE 0 END) AS submarine_coverage,`,\n    `  SUM(CASE WHEN ${unknown} AND COALESCE(t.is_focus,0)=1 THEN 1 ELSE 0 END) AS focus_coverage`,\n    'FROM sea_cells a',\n    `JOIN naval_pattern_offsets o ON o.weapon='${weapon}' AND o.span=${pattern.span}`,\n    'JOIN sea_cells p ON p.x=a.x+o.dx AND p.y=a.y+o.dy',\n    'LEFT JOIN (',\n    \"  SELECT x,y,MAX(CASE WHEN tag='safe' THEN 1 ELSE 0 END) AS is_safe,\",\n    \"    MAX(CASE WHEN tag='focus' THEN 1 ELSE 0 END) AS is_focus,\",\n    \"    MAX(CASE WHEN tag='submarine' THEN 1 ELSE 0 END) AS is_submarine\",\n    `  FROM naval_tactic_cells WHERE mission_id=${mission} AND sector_id=${sector}`,\n    '  GROUP BY x,y',\n    ') t ON t.x=p.x AND t.y=p.y',\n    'LEFT JOIN (',\n    '  SELECT x,y,1 AS is_shot FROM naval_public_shots',\n    `  WHERE mission_id=${mission} AND sector_id=${sector} AND state IN ('miss','hit','sunk')`,\n    '  GROUP BY x,y',\n    ') s ON s.x=p.x AND s.y=p.y',\n    `WHERE a.x BETWEEN 0 AND ${size-pattern.span} AND a.y BETWEEN 0 AND ${size-pattern.span}`,\n    `  AND p.x BETWEEN 0 AND ${size-1} AND p.y BETWEEN 0 AND ${size-1}`,\n    ...(weapon==='radar'?['  AND MOD(a.x,2)=0 AND MOD(a.y,2)=0']:[]),\n    'GROUP BY a.x,a.y',\n    `HAVING total_points=${pattern.offsets.length} AND unknown_coverage>0`,\n    'ORDER BY submarine_coverage DESC,focus_coverage DESC,unknown_coverage DESC,repeat_count ASC,safe_count ASC,anchor_y,anchor_x',\n    `LIMIT ${limit}`,\n  ].join('\\n');\n}\n\n/** 只调整公开副炮计划；不读舰位、不授予额外资源，也不改变AI选点。 */\nexport function supportEnemyPlan({level,round,relayDisabled=false,sweepRound=null}={}){\n  integer(level,1,6,'关卡');integer(round,1,10000,'轮次');if(typeof relayDisabled!=='boolean')throw new TypeError('中继状态必须为布尔值');if(sweepRound!==null)integer(sweepRound,1,10000,'扫频轮次');\n  const base=enemyFirePlan(level,round);let shots=base.shots,nextShots=base.nextShots,reason=null;\n  if(level===3&&relayDisabled){shots=1;nextShots=1;reason='relay_disabled';}\n  else if(level===4&&sweepRound===round){shots=1;reason='radar_sweep';}\n  return{shots,nextShots,warning:nextShots===2,baseShots:base.shots,baseNextShots:base.nextShots,reason};\n}\n"],"dependencies":["海战规则.mjs"]},"棋盘字模.mjs":{"kind":"module","parts":["/** 坐标数字独立绘制，不依赖小字号字体的抗锯齿或系统字形。每字7×9像素。 */\nexport const AXIS_DIGITS = Object.freeze({\n  '0':['0111110','1100011','1100011','1100011','1100011','1100011','1100011','1100011','0111110'],\n  '1':['0001100','0011100','0111100','0001100','0001100','0001100','0001100','0001100','0111110'],\n  '2':['0111110','1100011','0000011','0000110','0001100','0011000','0110000','1100000','1111111'],\n  '3':['0111110','1100011','0000011','0000011','0011110','0000011','0000011','1100011','0111110'],\n  '4':['0001100','0011100','0111100','1101100','1101100','1111111','0001100','0001100','0001100'],\n  '5':['1111111','1100000','1100000','1100000','1111110','0000011','0000011','1100011','0111110'],\n  '6':['0011110','0110000','1100000','1100000','1111110','1100011','1100011','1100011','0111110'],\n  '7':['1111111','0000011','0000110','0000110','0001100','0001100','0011000','0011000','0011000'],\n  '8':['0111110','1100011','1100011','1100011','0111110','1100011','1100011','1100011','0111110'],\n  '9':['0111110','1100011','1100011','1100011','0111111','0000011','0000011','0000110','0111100'],\n});\n\nexport function drawAxisNumber(ctx, value, centerX, centerY, color='#163e58') {\n  const label=String(value);\n  if(!/^\\d{1,2}$/.test(label))return {x:centerX,y:centerY,width:0,height:0};\n  const width=label.length*8-1,height=9,x=Math.round(centerX-width/2),y=Math.round(centerY-height/2);\n  ctx.fillStyle=color;\n  [...label].forEach((digit,index)=>AXIS_DIGITS[digit].forEach((row,dy)=>[...row].forEach((pixel,dx)=>{\n    if(pixel==='1')ctx.fillRect(x+index*8+dx,y+dy,1,1);\n  })));\n  return {x,y,width,height};\n}\n\n/** 列字母同样使用整数像素，避免12px字体缩成9px后变成色块。 */\nexport const AXIS_LETTERS=Object.freeze({\n  A:['0011100','0110110','1100011','1100011','1111111','1100011','1100011','1100011','1100011'],\n  B:['1111110','1100011','1100011','1100011','1111110','1100011','1100011','1100011','1111110'],\n  C:['0111110','1100011','1100000','1100000','1100000','1100000','1100000','1100011','0111110'],\n  D:['1111100','1100110','1100011','1100011','1100011','1100011','1100011','1100110','1111100'],\n  E:['1111111','1100000','1100000','1100000','1111110','1100000','1100000','1100000','1111111'],\n  F:['1111111','1100000','1100000','1100000','1111110','1100000','1100000','1100000','1100000'],\n  G:['0111110','1100011','1100000','1100000','1101111','1100011','1100011','1100011','0111110'],\n  H:['1100011','1100011','1100011','1100011','1111111','1100011','1100011','1100011','1100011'],\n  I:['1111111','0001100','0001100','0001100','0001100','0001100','0001100','0001100','1111111'],\n  J:['0001111','0000011','0000011','0000011','0000011','1100011','1100011','1100011','0111110'],\n  K:['1100011','1100110','1101100','1111000','1110000','1111000','1101100','1100110','1100011'],\n  L:['1100000','1100000','1100000','1100000','1100000','1100000','1100000','1100000','1111111'],\n});\n\nexport function drawAxisLetter(ctx,value,centerX,centerY,color='#163e58') {\n  const pattern=AXIS_LETTERS[value];if(!pattern)return;\n  const x=Math.round(centerX-3.5),y=Math.round(centerY-4.5);ctx.fillStyle=color;\n  pattern.forEach((row,dy)=>[...row].forEach((pixel,dx)=>{if(pixel==='1')ctx.fillRect(x+dx,y+dy,1,1);}));\n}\n"],"dependencies":[]},"海面像素.mjs":{"kind":"module","parts":["// 方案 A：蓝色静态海面与暖色战术标记，颜色不编码情报或舰位。\nexport const SEA_PALETTE = Object.freeze({\n  water: '#1683b5',\n  deep: '#1177a4',\n  crest: '#38a2ca',\n  foam: '#8ccadf',\n  grid: '#102c45',\n  frame: '#0c2238',\n  ink: '#102c45',\n  ship: '#fff1c6',\n  hit: '#f16f50',\n  sunk: '#ffe071',\n  radarYes: '#ffe071',\n  radarNo: '#fff1c6',\n});\n\n// 填整格海色，不绘制网格。调用方在全部海格之后统一画网格和标记。\n// 纹理只按行列奇偶交替两种，无时间、随机数或情报输入，未攻击棋盘帧保持稳定。\n// 10px 格中心保留 5×5 纯水色，15px 格中心保留 7×7 纯水色。\nexport function drawSeaCell(ctx, x, y, step, col, row) {\n  const size = Math.floor(step);\n  if (!Number.isFinite(size) || size \u003c 4) return;\n  const left = Math.floor(x), top = Math.floor(y);\n  const phase = (((col | 0) + (row | 0)) & 1);\n  ctx.save();\n  ctx.fillStyle = SEA_PALETTE.water;\n  ctx.fillRect(left, top, size, size);\n  if (size >= 10) {\n    const start = 2 + (phase & 1), waveY = size >= 14 ? 2 : 1;\n    ctx.fillStyle = SEA_PALETTE.deep;\n    ctx.fillRect(left + start, top + waveY + 1, 3, 1);\n    ctx.fillStyle = SEA_PALETTE.crest;\n    ctx.fillRect(left + start, top + waveY, 2, 1);\n    ctx.fillRect(left + start + 2, top + waveY + 1, 2, 1);\n    ctx.fillStyle = SEA_PALETTE.foam;\n    ctx.fillRect(left + start + 1, top + waveY, 1, 1);\n    const lowerY = size >= 14 ? size - 3 : size - 2;\n    ctx.fillStyle = SEA_PALETTE.crest;\n    ctx.fillRect(left + size - 6 + phase, top + lowerY, 3, 1);\n    ctx.fillStyle = phase & 1 ? SEA_PALETTE.deep : SEA_PALETTE.foam;\n    ctx.fillRect(left + size - 5, top + lowerY, 1, 1);\n  }\n  ctx.restore();\n}\n"],"dependencies":[]},"作战流程.mjs":{"kind":"module","parts":["/** 流程裁判只核对查询结果与导航误差，不生成或补充战术线索。 */\nexport const FORK_DESCRIPTION = '在关卡内或关卡失败后，可重开本关一次；敌位和重开前一致，随后需要两关冷却时间。';\n\nexport function canEnterSea(state) {\n  return Boolean(state?.deploymentConfirmed && state.reconLocked && state.briefingAccepted);\n}\n\nexport function checkRecon(rows, {level, targetSector, abilities}) {\n  const required = ['range','fulltext','vector','filter'].slice(0, Math.min(4, level));\n  const names={range:'范围检索',fulltext:'全文检索',vector:'向量检索',filter:'条件筛选'};\n  const missing=required.filter(method=>!abilities.includes(method));\n  if(missing.length)return {ok:false,reason:`还缺${missing.map(method=>names[method]).join('、')}，请为对应资料配上检索能力。`};\n  if (!rows.length) return {ok: false, reason: '没有查到相关观测，换一份证据试试。'};\n  const sectors = new Set(rows.map(row => row.sector_id));\n  if (sectors.size !== 1 || !sectors.has(targetSector)) return {ok: false, reason: '观测尚未指向正确目标。检查口令、时间和信源。'};\n  return {ok: true, reason: '观测已吻合，请在航海图上标记会合点。'};\n}\n\nexport function canUseFork({owned, level, lastUse, used}) {\n  return Boolean(owned && !used && (lastUse == null || level - lastUse >= 3));\n}\n\n/** 点位使用海图连续坐标；容差为棋盘边长的1/8，不替玩家自动吸附。 */\nexport function locatePin(pin, row, size) {\n  const tolerance = size / 8;\n  if (!pin || !Number.isFinite(pin.x) || !Number.isFinite(pin.y)\n    || !Number.isFinite(Number(row?.map_x)) || !Number.isFinite(Number(row?.map_y))) return {ok: false, distance: Infinity, tolerance};\n  const distance = Math.hypot(pin.x - Number(row.map_x), pin.y - Number(row.map_y));\n  return {ok: distance \u003c= tolerance, distance, tolerance};\n}\n\nexport function chartColumn(index) {\n  let value = Math.floor(index) + 1, label = '';\n  while (value > 0) {value--; label = String.fromCharCode(65 + value % 26) + label; value = Math.floor(value / 26);}\n  return label;\n}\n"],"dependencies":[]},"像素图鉴.mjs":{"kind":"module","parts":["/** 纯代码像素图鉴：不读取图片文件，也不依赖DOM。 */\nimport { FORK_DESCRIPTION } from ",{"ref":"作战流程.mjs"},";\nexport const ICON_SIZE = 24;\n\nconst COLORS = Object.freeze({ navy: '#173e52', blue: '#4f91a5', cream: '#f4ead2', coral: '#ed8c76', gold: '#f2c76d' });\nconst ICON_IDS = new Set(['normal', 'radar', 'dual', 'triple', 'distributed_i', 'distributed_ii', 'piercing',\n  'lightweight', 'fork', 'mysql', 'distributed', 'ultimate', 'trophy', 'index_medal']);\n\nfunction glyph(id, blink) {\n  const pixels = [];\n  const r = (x, y, w, h, color = 'navy') => pixels.push([x, y, w, h, COLORS[color]]);\n  const missile = (x, y, height) => {\n    r(x + 2, y, 2, 2); r(x, y + 2, 6, height);\n    r(x + 2, y + 2, 2, height - 2, 'cream');\n    r(x - 1, y + height - 1, 2, 4, 'blue'); r(x + 5, y + height - 1, 2, 4, 'blue');\n    r(x + 2, y + height + 2, 2, 2, blink ? 'gold' : 'coral');\n  };\n  const blast = (x, y, color) => {\n    r(x + 1, y, 3, 5, color); r(x, y + 1, 5, 3, color); r(x + 2, y + 2, 1, 1, 'cream');\n  };\n  switch (id) {\n    case 'normal':\n      r(11, 2, 2, 2); r(9, 4, 6, 2); r(8, 6, 8, 12); r(10, 5, 4, 11, 'cream');\n      r(6, 15, 3, 5, 'blue'); r(15, 15, 3, 5, 'blue'); r(10, 18, 4, 4, blink ? 'gold' : 'coral');\n      break;\n    case 'radar':\n      r(8, 2, 8, 2); r(4, 4, 16, 2); r(2, 6, 20, 12); r(4, 18, 16, 2); r(8, 20, 8, 2);\n      r(6, 5, 12, 2, 'cream'); r(4, 7, 16, 10, 'cream'); r(6, 17, 12, 2, 'cream');\n      r(10, 10, 4, 4, 'blue');\n      if (blink) { r(12, 7, 2, 5, 'gold'); r(14, 6, 3, 2, 'gold'); }\n      else { r(12, 12, 6, 2, 'coral'); r(17, 14, 2, 3, 'coral'); }\n      break;\n    case 'dual':\n      missile(4, 2, 14); missile(14, 2, 14);\n      break;\n    case 'triple':\n      missile(1, 7, 8); missile(9, 2, 8); missile(17, 7, 8);\n      break;\n    case 'distributed_i':\n      r(4, 4, 16, 1, 'blue'); r(4, 19, 16, 1, 'blue'); r(4, 4, 1, 16, 'blue'); r(19, 4, 1, 16, 'blue');\n      for (const y of [2, 18]) for (const x of [2, 18]) blast(x, y, blink ? 'gold' : 'coral');\n      break;\n    case 'distributed_ii':\n      for (const y of [2, 10, 18]) for (const x of [2, 10, 18]) blast(x, y, blink ? 'gold' : 'coral');\n      break;\n    case 'piercing':\n      for (const [x, y] of [[7, 7], [15, 7], [7, 15], [15, 15]]) r(x, y, 2, 2, 'blue');\n      for (const [x, y] of [[2, 2], [17, 2], [9, 9], [2, 17], [17, 17]]) blast(x, y, blink ? 'gold' : 'coral');\n      break;\n    case 'lightweight':\n      r(15, 2, 6, 2, 'gold'); r(11, 4, 10, 3, 'cream'); r(8, 7, 12, 3, 'cream');\n      r(6, 10, 12, 3, 'cream'); r(5, 13, 10, 3, 'cream'); r(5, 16, 7, 2, 'cream');\n      r(16, 5, 2, 2, 'blue'); r(13, 8, 2, 2, 'blue'); r(10, 11, 2, 2, 'blue');\n      r(7, 14, 2, 3, 'blue'); r(5, 17, 2, 5, 'blue'); r(8, 18, 4, 2, 'gold');\n      break;\n    case 'fork':\n      r(3, 3, 6, 2, 'cream'); r(3, 3, 2, 6, 'cream'); r(5, 6, 3, 3, 'blue'); r(7, 9, 3, 3, 'blue');\n      r(15, 3, 6, 2, 'cream'); r(19, 3, 2, 6, 'cream'); r(16, 6, 3, 3, 'coral'); r(14, 9, 3, 3, 'coral');\n      r(10, 11, 4, 5, 'gold'); r(11, 16, 2, 6, 'cream');\n      break;\n    case 'mysql':\n      r(6, 2, 12, 2, 'cream'); r(4, 4, 16, 3); r(3, 7, 18, 11); r(4, 18, 16, 3);\n      r(5, 6, 14, 2, 'cream'); r(5, 10, 14, 2, 'blue'); r(5, 15, 14, 2, 'cream');\n      r(18, 11, 3, 2, 'gold'); r(20, 13, 3, 2, 'gold'); r(18, 15, 3, 2, 'gold');\n      break;\n    case 'distributed':\n      r(5, 1, 5, 7, 'coral'); r(14, 1, 5, 7, 'blue'); r(6, 7, 12, 2); r(3, 9, 18, 10); r(6, 19, 12, 3);\n      r(6, 10, 12, 8, 'gold');\n      for (const y of [11, 15]) for (const x of [7, 14]) r(x, y, 3, 2, 'cream');\n      break;\n    case 'ultimate':\n      r(10, 1, 4, 4, 'gold'); r(7, 5, 10, 3, 'gold'); r(2, 8, 20, 8, 'gold');\n      r(5, 16, 14, 2, 'gold'); r(7, 18, 10, 2, 'gold'); r(10, 20, 4, 3, 'gold');\n      for (const y of [7, 11, 15]) for (const x of [6, 11, 16]) r(x, y, 2, 2, 'blue');\n      break;\n    case 'index_medal':\n      r(6, 2, 11, 2, 'blue'); r(4, 4, 16, 15); r(6, 5, 12, 12, 'cream');\n      r(7, 7, 7, 2, 'blue'); r(7, 11, 7, 2, 'blue'); r(7, 15, 7, 1, 'blue');\n      r(17, 6, 5, 3, 'gold'); r(17, 11, 5, 3, 'gold'); r(8, 19, 3, 4, 'coral'); r(14, 19, 3, 4, 'coral');\n      break;\n    case 'trophy':\n      r(5, 2, 14, 3, 'gold'); r(6, 5, 12, 9, 'gold'); r(8, 5, 2, 8, 'cream');\n      r(2, 5, 4, 3, 'gold'); r(18, 5, 4, 3, 'gold'); r(2, 8, 3, 5, 'gold'); r(19, 8, 3, 5, 'gold');\n      r(4, 12, 3, 3, 'gold'); r(17, 12, 3, 3, 'gold'); r(10, 14, 4, 5, 'blue'); r(6, 20, 12, 3, 'gold');\n      break;\n  }\n  return pixels;\n}\n\n/** x/y对齐整数，scale向下取整为正整数；frame交替绘制闪光，未知ID画普通炮弹。 */\nexport function drawPixelIcon(ctx, id, x, y, scale = 1, frame = 0) {\n  const resolved = typeof id === 'string' && ICON_IDS.has(id) ? id : 'normal';\n  const unit = Number.isFinite(scale) ? Math.max(1, Math.floor(scale)) : 1;\n  const left = Number.isFinite(x) ? Math.round(x) : 0, top = Number.isFinite(y) ? Math.round(y) : 0;\n  const blink = Number.isFinite(frame) ? Math.abs(Math.floor(frame)) % 2 : 0;\n  if (ctx && typeof ctx.fillRect === 'function') {\n    const previous = ctx.fillStyle;\n    for (const [px, py, width, height, color] of glyph(resolved, blink)) {\n      ctx.fillStyle = color; ctx.fillRect(left + px * unit, top + py * unit, width * unit, height * unit);\n    }\n    ctx.fillStyle = previous;\n  }\n  return { id: resolved, width: ICON_SIZE * unit, height: ICON_SIZE * unit };\n}\n\nfunction pattern(size, cells) {\n  return Object.freeze({ size, cells: Object.freeze(cells.map(([x, y]) => Object.freeze({ x, y }))) });\n}\n\n// 官方事实与游戏效果分开；部署/可见性边界按链接中的版本说明理解。\nconst SQL_FEATURE = Object.freeze({\n  featureTitle: 'SQL条件与批量坐标查询',\n  featureDescription: '支持用WHERE、IN和OR组合多行筛选条件，也能与向量、全文和其他标量条件一起组织查询，方便按多个坐标或属性获取所需记录。',\n  featureUrl: 'https://github.com/oceanbase/seekdb/blob/master/README.md#-hybrid-search-in-a-single-sql',\n});\nconst HTAP_FEATURE = Object.freeze({\n  featureTitle: 'OceanBase HTAP',\n  featureDescription: 'HTAP将事务处理与分析放在同一系统。OceanBase以同一套引擎和同一份数据同时支持交易更新、查询和实时分析，减少两套系统间的数据搬运。',\n  featureUrl: 'https://oceanbase.github.io/docs/user_manual/operation_and_maintenance/en-US/scenario_best_practices/chapter_03_htap/introduction',\n});\nconst MULTIMODAL_FEATURE = Object.freeze({\n  featureTitle: '多模态与统一检索',\n  featureDescription: 'seekdb在同一引擎中管理关系、向量、文本、JSON与地理空间等数据，支持全文、向量与关系条件组合查询，便于将不同类型的信息放进统一检索流程。',\n  featureUrl: 'https://github.com/oceanbase/seekdb-doc#seekdb-documentation',\n});\nconst ULTIMATE_FEATURE = Object.freeze({\n  featureTitle: 'OceanBase分布式扩展',\n  featureDescription: 'seekdb在浏览器本地执行范围SQL；OceanBase提供分布式扩展能力。更多坐标可用同一查询中的条件组合表达，展示统一SQL处理范围数据的方式。',\n  featureUrl: 'https://docs.seekdb.ai/seekdb/seekdb-overview/#capability-matrix',\n});\nconst FEATURE_INFO = Object.freeze({\n  normal: SQL_FEATURE, dual: HTAP_FEATURE,\n  radar: Object.freeze({\n    featureTitle: '混合检索',\n    featureDescription: '把全文匹配、向量相似度和关系条件放在同一条SQL中执行；既能按关键词找记录，也能按特征筛选相近内容，再用任务和时间等条件缩小范围。',\n    featureUrl: 'https://docs.seekdb.ai/seekdb/experience-client-server-mode-seekdb-with-SQL/',\n  }),\n  triple: Object.freeze({\n    featureTitle: '嵌入式部署',\n    featureDescription: '支持由应用启动并访问本地数据库，通过开发接口管理数据和执行SQL，适合桌面应用、本地开发与边缘场景，也便于将数据能力放在应用附近。',\n    featureUrl: 'https://docs.seekdb.ai/seekdb/deploy-embedded-seekdb/',\n  }),\n  lightweight: Object.freeze({\n    featureTitle: '轻量部署',\n    featureDescription: '针对本地、边缘和低规格设备优化二进制体积、常驻内存及线程等资源开销，支持轻量部署，便于在有限资源环境中使用SQL、索引与混合检索。',\n    featureUrl: 'https://github.com/oceanbase/seekdb/releases/tag/v1.4.0#significant-reduction-in-resource-overhead',\n  }),\n  fork: Object.freeze({\n    featureTitle: '写时复制分支与合并',\n    featureDescription: '以写时复制方式从一致性快照创建独立数据分支，各分支可分别读写；再通过比较与合并策略接纳修改，适合隔离试验、并行探索和版本管理。',\n    featureUrl: 'https://github.com/oceanbase/seekdb/blob/master/README_CN.md#-写时复制沙箱agent-自由探索',\n  }),\n  mysql: Object.freeze({\n    featureTitle: 'MySQL兼容',\n    featureDescription: '兼容MySQL协议并提供熟悉的SQL访问方式，可连接常用客户端和驱动；利用关系表、查询、插入等能力组织数据处理，方便现有生态接入。',\n    featureUrl: 'https://github.com/oceanbase/seekdb/blob/master/README.md#-mysql-compatible-acid-embeddable',\n  }),\n  distributed: MULTIMODAL_FEATURE, distributed_i: MULTIMODAL_FEATURE,\n  ultimate: ULTIMATE_FEATURE, distributed_ii: ULTIMATE_FEATURE,\n  piercing: Object.freeze({\n    featureTitle: '异步向量索引',\n    featureDescription: '将主表写入与后台向量索引维护解耦，后台持续消费增量变更并更新索引；通过同步或异步模式及刷新策略，组织持续写入与相似检索的更新过程。',\n    featureUrl: 'https://github.com/oceanbase/seekdb/releases/tag/v1.3.0#async-indexes',\n  }),\n});\n\nexport const WEAPON_INFO = Object.freeze(Object.fromEntries([\n  { id: 'normal', title: '普通炮弹', description: '选择未攻击过的一格投弹；普通双响回合可选两格。', icon: 'normal' },\n  { id: 'radar', title: '混合检索雷达', description: '扫描完整2×2四格，消耗一次行动；不投弹，回波可保留作笔记。', icon: 'radar',\n    pattern: pattern(2, [[0, 0], [1, 0], [0, 1], [1, 1]]) },\n  { id: 'dual', title: 'HTAP 双响炮', description: '同一次行动选择两个不同坐标投弹，消耗一次双响炮库存。', icon: 'dual' },\n  { id: 'triple', title: '嵌入式三联炮', description: '同一次行动选择三个不同坐标投弹，消耗一次三联库存。', icon: 'triple' },\n  { id: 'distributed_i', title: '多模态扩展弹', description: '攻击完整4×4范围四角4点；与OceanBase 分布式火力支援共享本关一次弹包。', icon: 'distributed_i',\n    pattern: pattern(4, [[0, 0], [3, 0], [0, 3], [3, 3]]) },\n  { id: 'piercing', title: '异步向量索引导弹', description: '攻击完整3×3范围五点X，每关一枚，使用独立弹包。', icon: 'piercing',\n    pattern: pattern(3, [[0, 0], [2, 0], [1, 1], [0, 2], [2, 2]]) },\n  { id: 'distributed_ii', title: 'OceanBase 分布式火力支援', description: '攻击完整5×5范围隔格9点；与多模态扩展弹共享本关一次弹包。', icon: 'distributed_ii',\n    pattern: pattern(5, [[0, 0], [2, 0], [4, 0], [0, 2], [2, 2], [4, 2], [0, 4], [2, 4], [4, 4]]) },\n].map(info => [info.id, Object.freeze({ ...info, ...FEATURE_INFO[info.id] })])));\n\nconst medal = (id, title, description, icon = id) => ({ kind: 'medal', id, title, description, icon });\nconst weapon = id => ({ kind: 'weapon', ...WEAPON_INFO[id] });\nconst REWARDS = {\n  1: [medal('lightweight', '极致轻量', '下一关起可启用轻量舰体：最长舰缩短一格。'), weapon('triple')],\n  2: [medal('fork', 'Fork / Merge', FORK_DESCRIPTION),\n    { kind: 'skill', id: 'fork', title: '试错机会', description: FORK_DESCRIPTION, icon: 'fork' }],\n  3: [medal('mysql', 'MySQL 兼容', '复制敌军的双炮协议，下一关起生效。'),\n    { kind: 'skill', id: 'mysql', title: 'MySQL兼容双响炮', description: '每四轮普通攻击可同时选择两格，不与其他武器叠加。', icon: 'dual' }],\n  4: [medal('distributed', '分布式扩展', '下一关解锁四角四点的多模态扩展弹。'), weapon('distributed_i')],\n  5: [medal('piercing', '异步索引', '下一关解锁独立弹包的异步向量索引导弹（五点X）。', 'index_medal'), weapon('piercing'),\n    medal('ultimate', '究极分布式扩展', '下一关解锁OceanBase 分布式火力支援，与多模态扩展弹共享一次弹包。'), weapon('distributed_ii')],\n};\n\n/** 返回独立卡片供UI使用；同概念的勋章/技能可同id，界面key请组合kind与id。 */\nexport function getLevelRewards(level) {\n  const id = typeof level === 'number' ? level : level?.id;\n  if (!Number.isInteger(id) || id \u003c 1 || id > 6) return [];\n  return (REWARDS[id] ?? []).map(card => ({ ...card, ...FEATURE_INFO[card.id],\n    ...(card.pattern ? { pattern: { size: card.pattern.size, cells: card.pattern.cells.map(cell => ({ ...cell })) } } : {}) }));\n}\n\n/** 仅整理展示副本；旧存档和实际奖励列表仍保持完整。 */\nexport function getRewardDisplayCards(rewards) {\n  const cards = [], identical = new Map(), effects = new Set(), features = new Set();\n  for (const reward of rewards) {\n    const identity = JSON.stringify([reward.id, reward.description, reward.featureDescription]);\n    const previous = identical.get(identity);\n    if (previous) {\n      if (reward.title !== previous.title) previous.relatedUnlocks.push({kind: reward.kind, title: reward.title});\n      continue;\n    }\n    const card = {...reward, relatedUnlocks: []};\n    identical.set(identity, card);\n    if (card.description) {\n      if (effects.has(card.description)) delete card.description;\n      else effects.add(card.description);\n    }\n    if (card.featureDescription) {\n      if (features.has(card.featureDescription)) {\n        delete card.featureDescription; delete card.featureTitle; delete card.featureUrl;\n      } else features.add(card.featureDescription);\n    }\n    cards.push(card);\n  }\n  return cards;\n}\n"],"dependencies":["作战流程.mjs"]},"资源清理.mjs":{"kind":"module","parts":["/** 仅管理本游戏生成的临时表；SQL由调用方执行，固定业务表不进入登记表。 */\nconst DYNAMIC_NAME = /^(?:notes_main_\\d+|(?:live|checkpoint|notes_work|checkpoint_edit|live_restore|notes_after)_\\d+_\\d+_\\d+)$/;\nconst validName = name => typeof name === 'string' && name.match(DYNAMIC_NAME)?.[0] === name;\n\nexport class DynamicTableResources {\n  #tables = new Map();\n\n  get size() { return this.#tables.size; }\n\n  entries() { return [...this.#tables].map(([name, parent]) => ({ name, parent })); }\n\n  restore(entries = []) {\n    const next = new Map();\n    for (const {name, parent} of entries) {\n      if (!validName(name) || (parent !== null && !validName(parent)) || next.has(name)) throw new Error('存档中的分支登记无效');\n      next.set(name, parent);\n    }\n    for (const name of next.keys()) {\n      const visited = new Set(); let current = name;\n      while (current !== null) {\n        if (!next.has(current) || visited.has(current)) throw new Error('存档中的分支父链无效');\n        visited.add(current); current = next.get(current);\n      }\n    }\n    this.#tables = next;\n  }\n\n  async create(name, create, parent = null) {\n    if (!validName(name)) throw new TypeError('只允许登记本游戏生成的动态表');\n    if (this.#tables.has(name)) throw new Error('动态表重复登记');\n    if (parent !== null && !this.#tables.has(parent)) throw new Error('Fork父表尚未登记');\n    if (typeof create !== 'function') throw new TypeError('缺少动态表创建操作');\n    const result = await create();\n    // 登记表独立于游戏快照，动作回滚后仍能找到已经成功创建的孤立表。\n    this.#tables.set(name, parent);\n    return result;\n  }\n\n  async cleanup({ keep = [], drop, warn = () => {} } = {}) {\n    if (typeof drop !== 'function') throw new TypeError('缺少动态表删除操作');\n    const protectedNames = new Set();\n    for (const name of keep) {\n      let current = name;\n      while (this.#tables.has(current) && !protectedNames.has(current)) {\n        protectedNames.add(current);\n        current = this.#tables.get(current);\n      }\n    }\n    const attempted = new Set(), dropped = [], failures = [];\n    for (;;) {\n      // 所有仍存在的子表都保护父源，包括本次DROP失败而等待重试的分支。\n      const parents = new Set(this.#tables.values());\n      const leaves = [...this.#tables.keys()].filter(name => !protectedNames.has(name)\n        && !parents.has(name) && !attempted.has(name));\n      if (!leaves.length) break;\n      for (const name of leaves) {\n        attempted.add(name);\n        try {\n          await drop(name);\n          this.#tables.delete(name);\n          dropped.push(name);\n        } catch (error) {\n          failures.push({ name, error });\n          // 清理失败不能令成功动作回滚到可能已经删除的旧表。\n          try { warn(name, error); } catch { /* 警告回调也不能改变游戏动作结果。 */ }\n        }\n      }\n    }\n    return { dropped, failures, remaining: [...this.#tables.keys()] };\n  }\n}\n"],"dependencies":[]},"航海存档.mjs":{"kind":"module","parts":["const CATALOG = '`seekdb_naval_catalog`.`active_game`';\nconst SCHEMA_VERSION = 1;\nlet lastTimestamp = -1n;\n\nexport function isGameDatabaseName(name) {\n  if (typeof name !== 'string') return false;\n  // 比较完整匹配，避免 JavaScript 的 $ 接受末尾换行。\n  return name.match(/^seekdb_naval_\\d+$/)?.[0] === name;\n}\n\nfunction requireDatabaseName(name) {\n  if (!isGameDatabaseName(name)) throw new Error('航海日志数据库名称无效。');\n  return name;\n}\n\nexport function makeGameDatabaseName(now = Date.now(), previous = '') {\n  if (typeof now !== 'number' || !Number.isSafeInteger(now) || now \u003c 0) {\n    throw new Error('数据库时间戳必须是非负安全整数。');\n  }\n  if (previous !== '') requireDatabaseName(previous);\n  const previousTimestamp = previous === '' ? -1n : BigInt(previous.slice('seekdb_naval_'.length));\n  let timestamp = BigInt(now);\n  if (timestamp \u003c= previousTimestamp) timestamp = previousTimestamp + 1n;\n  if (timestamp \u003c= lastTimestamp) timestamp = lastTimestamp + 1n;\n  lastTimestamp = timestamp;\n  return `seekdb_naval_${timestamp}`;\n}\n\nfunction table(name, tableName) {\n  return `\\`${requireDatabaseName(name)}\\`.\\`${tableName}\\``;\n}\n\nfunction literal(value) {\n  return `'${String(value).replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"''\").replaceAll('\\0', '\\\\0')}'`;\n}\n\nfunction serialize(value, field) {\n  let json;\n  try {\n    json = JSON.stringify(value);\n  } catch (error) {\n    throw new Error(`航海日志 ${field} 无法序列化。`, {cause: error});\n  }\n  if (json === undefined) throw new Error(`航海日志 ${field} 必须是可序列化的 JSON。`);\n  return json;\n}\n\nfunction parseJson(value, field) {\n  if (typeof value !== 'string') throw new Error(`航海日志 ${field} 格式损坏。`);\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    throw new Error(`航海日志 ${field} 不是有效 JSON。`, {cause: error});\n  }\n}\n\nfunction revisionNumber(value) {\n  if (!((typeof value === 'string' && /^\\d+$/.test(value)) || typeof value === 'number')) {\n    throw new Error('航海日志版本号无效。');\n  }\n  const revision = Number(value);\n  if (!Number.isSafeInteger(revision) || revision \u003c 0) throw new Error('航海日志版本号无效。');\n  return revision;\n}\n\nfunction resetIntent(value) {\n  const reset = parseJson(value, 'reset_json');\n  if (!reset || typeof reset !== 'object' || Array.isArray(reset)) throw new Error('航海日志重置意图格式损坏。');\n  if (reset.oldDatabase !== null) requireDatabaseName(reset.oldDatabase);\n  requireDatabaseName(reset.newDatabase);\n  if (reset.oldDatabase === reset.newDatabase) throw new Error('重置前后数据库不能相同。');\n  return {oldDatabase: reset.oldDatabase, newDatabase: reset.newDatabase};\n}\n\nexport class NavalArchive {\n  writing = false;\n  revision = 0;\n  #db;\n  #queue = Promise.resolve();\n  #pending = 0;\n  #revisionDatabase = null;\n\n  constructor(db) {\n    if (typeof db?.exec !== 'function' || typeof db?.query !== 'function') {\n      throw new TypeError('航海日志需要提供 exec/query 的数据库连接。');\n    }\n    this.#db = db;\n  }\n\n  // 串行处理，避免并发存档分配同一版本，也避免提前解除 trace 屏蔽。\n  #run(work) {\n    this.#pending += 1;\n    this.writing = true;\n    const task = this.#queue.then(work);\n    this.#queue = task.catch(() => {});\n    return task.finally(() => {\n      this.#pending -= 1;\n      this.writing = this.#pending > 0;\n    });\n  }\n\n  initCatalog() {\n    return this.#run(async () => {\n      await this.#db.exec('CREATE DATABASE IF NOT EXISTS `seekdb_naval_catalog`');\n      await this.#db.exec(`CREATE TABLE IF NOT EXISTS ${CATALOG} (slot INT PRIMARY KEY, database_name VARCHAR(64), reset_json LONGTEXT)`);\n      const {rows} = await this.#db.query(`SELECT database_name, reset_json FROM ${CATALOG} WHERE slot = 1`);\n      if (!rows?.length) return {databaseName: null, reset: null};\n      const row = rows[0];\n      const databaseName = row.database_name === null ? null : requireDatabaseName(row.database_name);\n      const reset = row.reset_json === null ? null : resetIntent(row.reset_json);\n      return {databaseName, reset};\n    });\n  }\n\n  beginReset(oldName, newName) {\n    return this.#run(async () => {\n      const oldDatabase = oldName === null || oldName === '' ? null : requireDatabaseName(oldName);\n      const newDatabase = requireDatabaseName(newName);\n      if (oldDatabase === newDatabase) throw new Error('重置前后数据库不能相同。');\n      const reset = serialize({oldDatabase, newDatabase}, 'reset_json');\n      await this.#db.exec(`REPLACE INTO ${CATALOG} (slot, database_name, reset_json) VALUES (1, ${oldDatabase === null ? 'NULL' : literal(oldDatabase)}, ${literal(reset)})`);\n    });\n  }\n\n  finishReset(newName) {\n    return this.#run(async () => {\n      requireDatabaseName(newName);\n      await this.#db.exec(`REPLACE INTO ${CATALOG} (slot, database_name, reset_json) VALUES (1, ${literal(newName)}, NULL)`);\n    });\n  }\n\n  initGame(name) {\n    return this.#run(async () => {\n      requireDatabaseName(name);\n      await this.#db.exec(`CREATE DATABASE IF NOT EXISTS \\`${name}\\``);\n      await this.#db.exec(`CREATE TABLE IF NOT EXISTS ${table(name, 'naval_current')} (slot INT PRIMARY KEY, schema_version INT, revision BIGINT, payload_json LONGTEXT, pending_json LONGTEXT, updated_at VARCHAR(40))`);\n      await this.#db.exec(`CREATE TABLE IF NOT EXISTS ${table(name, 'naval_history')} (revision BIGINT PRIMARY KEY, label VARCHAR(80), payload_json LONGTEXT, pending_json LONGTEXT, sql_json LONGTEXT, created_at VARCHAR(40))`);\n      if (this.#revisionDatabase !== name) {\n        this.#revisionDatabase = name;\n        this.revision = 0;\n      }\n    });\n  }\n\n  load(name) {\n    return this.#run(async () => {\n      const {rows} = await this.#db.query(`SELECT schema_version, revision, payload_json, pending_json FROM ${table(name, 'naval_current')} WHERE slot = 1`);\n      if (!rows?.length) {\n        this.#revisionDatabase = name;\n        this.revision = 0;\n        return null;\n      }\n      const row = rows[0];\n      if (Number(row.schema_version) !== SCHEMA_VERSION) throw new Error(`不支持的航海日志格式版本：${row.schema_version}。`);\n      const revision = revisionNumber(row.revision);\n      const payload = parseJson(row.payload_json, 'payload_json');\n      const pending = row.pending_json === null ? null : parseJson(row.pending_json, 'pending_json');\n      this.#revisionDatabase = name;\n      this.revision = revision;\n      return {payload, pending, revision};\n    });\n  }\n\n  save(name, payload, {pending = null, label = '自动存档', sql = []} = {}) {\n    return this.#run(async () => {\n      const currentTable = table(name, 'naval_current');\n      const historyTable = table(name, 'naval_history');\n      if (typeof label !== 'string') throw new TypeError('航海日志标题必须是字符串。');\n      if (!Array.isArray(sql)) throw new TypeError('航海日志 SQL 记录必须是数组。');\n      const payloadJson = literal(serialize(payload, 'payload_json'));\n      const pendingJson = pending === null ? 'NULL' : literal(serialize(pending, 'pending_json'));\n      const sqlJson = literal(serialize(sql, 'sql_json'));\n      const revision = revisionNumber(this.#revisionDatabase === name ? this.revision : 0) + 1;\n      if (!Number.isSafeInteger(revision)) throw new Error('航海日志版本号超出安全范围。');\n      const timestamp = literal(new Date().toISOString());\n      try {\n        await this.#db.exec('BEGIN');\n        await this.#db.exec(`REPLACE INTO ${currentTable} (slot, schema_version, revision, payload_json, pending_json, updated_at) VALUES (1, ${SCHEMA_VERSION}, ${revision}, ${payloadJson}, ${pendingJson}, ${timestamp})`);\n        await this.#db.exec(`INSERT INTO ${historyTable} (revision, label, payload_json, pending_json, sql_json, created_at) VALUES (${revision}, ${literal(label)}, ${payloadJson}, ${pendingJson}, ${sqlJson}, ${timestamp})`);\n        await this.#db.exec('COMMIT');\n      } catch (error) {\n        // 保留原始错误；回滚本身失败不能把写入失败伪装成另一类结果。\n        try { await this.#db.exec('ROLLBACK'); } catch {}\n        throw error;\n      }\n      this.#revisionDatabase = name;\n      this.revision = revision;\n      return {revision};\n    });\n  }\n\n  history(name, limit = 20) {\n    return this.#run(async () => {\n      const historyTable = table(name, 'naval_history');\n      if (!Number.isSafeInteger(limit) || limit \u003c 1) throw new Error('航海日志条数必须是正整数。');\n      const {rows} = await this.#db.query(`SELECT revision, label, payload_json, pending_json, sql_json, created_at FROM ${historyTable} ORDER BY revision DESC LIMIT ${limit}`);\n      return rows;\n    });\n  }\n}\n"],"dependencies":[]},"持久写入.mjs":{"kind":"module","parts":["const defaultWait = ms => new Promise(resolve => setTimeout(resolve, ms));\nconst isMemstorePressure = error => error?.code === 4030 || error?.code === '4030';\n\n/**\n * 仅重试已自行 ROLLBACK 的原子事务，或可安全重复的幂等写入/恢复操作。\n * 不能用于任意尚未回滚的事务、非幂等 DDL 或含不可重复副作用的函数。\n * 仅触发一次 Memstore 刷盘，不删除历史、不增大内存预算。\n */\nexport async function persistentWrite(db, work, {\n  onRetry = () => {}, wait = defaultWait, maxWaitMs = 15000, intervalMs = 250,\n} = {}) {\n  if (typeof db?.exec !== 'function' || typeof work !== 'function') {\n    throw new TypeError('持久写入需要数据库 exec 和可重试的 work 函数。');\n  }\n  if (typeof onRetry !== 'function' || typeof wait !== 'function') {\n    throw new TypeError('持久写入的 onRetry 和 wait 必须是函数。');\n  }\n  if (!Number.isFinite(maxWaitMs) || maxWaitMs \u003c= 0 || !Number.isFinite(intervalMs) || intervalMs \u003c= 0) {\n    throw new RangeError('持久写入的等待预算和间隔必须是正数。');\n  }\n  const maxAttempts = Math.ceil(maxWaitMs / intervalMs);\n  if (!Number.isSafeInteger(maxAttempts)) throw new RangeError('持久写入的重试次数超出安全范围。');\n\n  let firstError;\n  try {\n    return await work();\n  } catch (error) {\n    if (!isMemstorePressure(error)) throw error;\n    firstError = error;\n  }\n\n  try {\n    await db.exec('ALTER SYSTEM MINOR FREEZE');\n  } catch (error) {\n    throw new AggregateError([firstError, error], '持久写入重试前的 Memstore 刷盘失败。', {cause: error});\n  }\n\n  let lastError = firstError;\n  let waitedMs = 0;\n  for (let attempt = 1; attempt \u003c= maxAttempts; attempt++) {\n    // 状态提示失效不能更改数据库写入的结果。\n    try { await onRetry({attempt, lastError}); } catch {}\n    const delay = Math.min(intervalMs, maxWaitMs - waitedMs);\n    await wait(delay);\n    waitedMs += delay;\n    try {\n      return await work();\n    } catch (error) {\n      if (!isMemstorePressure(error)) throw error;\n      lastError = error;\n    }\n  }\n  throw firstError;\n}\n"],"dependencies":[]},"战斗适配.mjs":{"kind":"module","parts":["/* 只管理桌面战斗画面的整体缩放与节点归位，不读取游戏状态或更改浏览器缩放。 */\nconst installed = new WeakMap();\n\nexport function setupBattleFit() {\n  const doc = globalThis.document;\n  if (!doc?.body) return null;\n  if (installed.has(doc)) return installed.get(doc);\n  const body = doc.body;\n  const shell = doc.querySelector('.terminal-shell');\n  const masthead = doc.querySelector('.masthead');\n  const manual = doc.querySelector('.quick-rule-section');\n  const core = doc.querySelector('.navy-game-screen');\n  if (!shell || !masthead || !manual || !core) return null;\n  const win = doc.defaultView;\n  const host = doc.createElement('section');\n  host.className = 'battle-fit-host';\n  host.setAttribute('aria-label', '战斗画面显示方式');\n  host.hidden = true;\n  const tools = doc.createElement('div');\n  tools.className = 'battle-fit-toolbar';\n  const fitButton = doc.createElement('button');\n  const originalButton = doc.createElement('button');\n  for (const button of [fitButton, originalButton]) {\n    button.type = 'button';\n    button.className = 'button battle-fit-button';\n  }\n  fitButton.textContent = '适应屏幕';\n  originalButton.textContent = '原始大小';\n  const hint = doc.createElement('p');\n  hint.className = 'battle-fit-hint';\n  hint.setAttribute('role', 'status');\n  hint.hidden = true;\n  tools.append(fitButton, originalButton, hint);\n  const viewport = doc.createElement('div');\n  viewport.className = 'battle-fit-viewport';\n  const stage = doc.createElement('div');\n  stage.className = 'battle-fit-stage';\n  const manualSlot = doc.createElement('div');\n  manualSlot.className = 'battle-fit-manual-slot';\n  const coreSlot = doc.createElement('div');\n  coreSlot.className = 'battle-fit-core-slot';\n  stage.append(manualSlot, coreSlot);\n  viewport.append(stage);\n  host.append(tools, viewport);\n  shell.prepend(host);\n  const radarDetails = core.querySelector('.radar-details');\n  const radarReport = core.querySelector('#radar-report');\n  const radarRecords = doc.createElement('section');\n  radarRecords.className = 'battle-fit-radar-records';\n  radarRecords.setAttribute('aria-label', '雷达逐格结果与实际 SQL');\n  radarRecords.hidden = true;\n  host.after(radarRecords);\n  let mode = 'fit';\n  let previousView = body.dataset.view;\n  let frame = 0;\n  let mounted = false;\n  let destroyed = false;\n  let anchorPending = false;\n  let positions = [];\n  const modifier = /Mac/i.test(win.navigator.platform) ? '⌘' : 'Ctrl';\n  if (!body.dataset.battleFitColumns) body.dataset.battleFitColumns = '3';\n  body.dataset.battleFitReady = 'true';\n\n  function mount() {\n    if (mounted) return;\n    positions = [masthead, manual, core, radarDetails].filter(Boolean).map(node => {\n      const placeholder = doc.createComment('战斗适配归位点');\n      node.before(placeholder);\n      return { node, placeholder };\n    });\n    stage.prepend(masthead);\n    manualSlot.append(manual);\n    coreSlot.append(core);\n    if (radarDetails) radarRecords.append(radarDetails);\n    mounted = true;\n  }\n\n  function restore() {\n    if (!mounted) return;\n    // 先还原雷达明细，再还原其上层战斗节点，避免遗漏子树。\n    for (const {node, placeholder} of [...positions].reverse()) {\n      if (placeholder.parentNode) placeholder.replaceWith(node);\n    }\n    positions = [];\n    mounted = false;\n    radarRecords.hidden = true;\n  }\n\n  function update() {\n    frame = 0;\n    const inBattle = body.dataset.view === 'battle';\n    const active = inBattle && mode === 'fit';\n    host.hidden = !inBattle;\n    body.dataset.battleFitActive = String(active);\n    body.dataset.battleFitMode = mode;\n    fitButton.setAttribute('aria-pressed', String(mode === 'fit'));\n    originalButton.setAttribute('aria-pressed', String(mode === 'original'));\n    viewport.hidden = !active;\n    if (!active) {\n      restore();\n      body.dataset.battleFitScale = '1';\n      hint.hidden = !inBattle;\n      hint.textContent = `原始大小：可用 ${modifier} + 加号放大。${modifier}− 缩小，${modifier}0 恢复浏览器比例。`;\n      if (inBattle && anchorPending) win.scrollTo({top: 0, behavior: 'instant'});\n      anchorPending = false;\n      return;\n    }\n    mount();\n    const columns = body.dataset.battleFitColumns === '2' ? 2 : 3;\n    const nativeWidth = columns === 3 ? 1664 : 1536;\n    stage.style.width = `${nativeWidth}px`;\n    const top = host.getBoundingClientRect().top + win.scrollY;\n    const availableHeight = Math.max(1, win.innerHeight - top - tools.getBoundingClientRect().height - 8 - 12);\n    const nativeHeight = stage.offsetHeight;\n    if (!nativeHeight || !viewport.clientWidth) return;\n    // CSS zoom只作用于这一组，原有字号、留白和像素图形按同一比例缩放。\n    const ratio = Math.min(1, viewport.clientWidth / nativeWidth, availableHeight / nativeHeight);\n    const scale = Math.max(0.1, Math.floor(ratio * 1000) / 1000);\n    const previousScale = host.style.getPropertyValue('--battle-fit-scale');\n    if (previousScale !== String(scale)) host.style.setProperty('--battle-fit-scale', String(scale));\n    body.dataset.battleFitScale = String(scale);\n    hint.hidden = scale >= 0.65;\n    hint.textContent = `当前显示 ${Math.round(scale * 100)}%。放大窗口更清楚；也可选原始大小，按 ${modifier}− 缩小、${modifier}0 恢复。`;\n    radarRecords.hidden = !radarDetails || !radarReport || radarReport.hidden;\n    if (anchorPending) win.scrollTo({top: 0, behavior: 'instant'});\n    anchorPending = false;\n  }\n\n  function refresh() {\n    if (destroyed) return;\n    // 比动画下一帧更早设定标记，让主程序停止旧的自动滚动。\n    body.dataset.battleFitActive = String(body.dataset.view === 'battle' && mode === 'fit');\n    if (!frame) frame = win.requestAnimationFrame(update);\n  }\n  function choose(next) {\n    mode = next;\n    anchorPending = true;\n    refresh();\n  }\n  const onFit = () => choose('fit');\n  const onOriginal = () => choose('original');\n  fitButton.addEventListener('click', onFit);\n  originalButton.addEventListener('click', onOriginal);\n  const views = new MutationObserver(records => {\n    const nextView = body.dataset.view;\n    // renderFlow每轮会重写同一个data-view，只有实际切屏才允许重新定位。\n    if (nextView !== previousView) {\n      anchorPending = nextView === 'battle';\n      previousView = nextView;\n      if (nextView !== 'battle') { restore(); host.hidden = true; }\n    }\n    refresh();\n  });\n  views.observe(body, {attributes: true, attributeFilter: ['data-view', 'data-battle-fit-columns']});\n  const content = new MutationObserver(refresh);\n  for (const node of [masthead, manual, core]) {\n    content.observe(node, {subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['hidden']});\n  }\n  const sizes = typeof ResizeObserver === 'function' ? new ResizeObserver(refresh) : null;\n  sizes?.observe(stage);\n  sizes?.observe(host);\n  win.addEventListener('resize', refresh);\n  doc.fonts?.ready.then(refresh).catch(() => {});\n  const api = {\n    refresh,\n    setMode(value) { if (value === 'fit' || value === 'original') choose(value); },\n    destroy() {\n      destroyed = true;\n      if (frame) win.cancelAnimationFrame(frame);\n      views.disconnect(); content.disconnect(); sizes?.disconnect();\n      win.removeEventListener('resize', refresh);\n      fitButton.removeEventListener('click', onFit); originalButton.removeEventListener('click', onOriginal);\n      restore(); host.remove(); radarRecords.remove();\n      for (const name of ['battleFitActive', 'battleFitScale', 'battleFitMode', 'battleFitReady']) delete body.dataset[name];\n      installed.delete(doc);\n    },\n  };\n  installed.set(doc, api);\n  anchorPending = body.dataset.view === 'battle';\n  refresh();\n  return api;\n}\n"],"dependencies":[]},"游戏逻辑.mjs":{"kind":"module","parts":["import {NavalDB} from ",{"ref":"数据库.mjs"},";\nimport {renderWeaponChoices,paintPixelBrand} from ",{"ref":"像素控件.mjs"},";\nimport {createReconChoices,createDetailChoices} from ",{"ref":"情报组合.mjs"},";\nimport {createReconTask,createDetailTask} from ",{"ref":"检索任务.mjs"},";\nimport {normalizeSupportRows,planSql,supportEnemyPlan} from ",{"ref":"战术规划.mjs"},";\nimport {drawAxisNumber, drawAxisLetter} from ",{"ref":"棋盘字模.mjs"},";\nimport {SEA_PALETTE,drawSeaCell} from ",{"ref":"海面像素.mjs"},";\nimport {ICON_SIZE, drawPixelIcon, getLevelRewards, getRewardDisplayCards, WEAPON_INFO} from ",{"ref":"像素图鉴.mjs"},";\nimport {createDetailEvidence, buildDetailQuery, isTacticalClueKind} from ",{"ref":"细节检索.mjs"},";\nimport {checkRecon, canUseFork, chartColumn, canEnterSea, FORK_DESCRIPTION} from ",{"ref":"作战流程.mjs"},";\nimport {DynamicTableResources} from ",{"ref":"资源清理.mjs"},";\nimport {NavalArchive, makeGameDatabaseName, isGameDatabaseName} from ",{"ref":"航海存档.mjs"},";\nimport {persistentWrite} from ",{"ref":"持久写入.mjs"},";\nimport {setupBattleFit} from ",{"ref":"战斗适配.mjs"},";\nimport {LEVELS, ROUND_LIMITS, createRng, createFleet, validateFleet, applyShot, createKnowledge,\n  recordShot, chooseEnemyShots, generateEvidence, buildQuery, validateSalvo, sectorBounds, boundsFromCells, resolveAim, weaponPatternAtAnchor, enemyFirePlan, createEnemyFleet, placementBlockedCells} from ",{"ref":"海战规则.mjs"},";\n\nconst $ = id => document.getElementById(id);\nconst clone = value => structuredClone(value);\nconst key = cell => `${cell.x},${cell.y}`;\nconst coord = cell => `${String.fromCharCode(65 + cell.x)}${cell.y + 1}`;\nconst quote = value => `'${String(value).replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"''\")}'`;\nconst sleep = ms => new Promise(resolve => setTimeout(resolve, ms));\nconst LIMITS = ROUND_LIMITS;\nconst COMBAT_SPEED = 0.45;\nconst COMBAT_PLAYBACK_RATE = 1.2;\nconst REWARD_PROMPT = '本关奖励已解锁，请查看下方介绍并确认领取。';\nconst isExtraClueKind = kind => kind !== 'dense_half' && isTacticalClueKind(kind);\nconst DETAIL_MISSIONS = [\n  ['新兵认船','确认哪一带有完整舰，练习命中后追击。'],\n  ['海水免打扰','找一块确认无舰的2×2海域，省下炮弹。'],\n  ['听声辨长舰','判断最长舰的横竖方向，别把所有船当成同一方向。'],\n  ['航道抓现行','找出长舰跨过的行列分界，两侧都可能藏着同一艘船。'],\n  ['潜艇捉迷藏','查潜艇所在半盘与一块空海域，再安排雷达。'],\n  ['终局联合搜潜','查潜艇活动宽带和3×3空海域，规划最后的搜潜路线。'],\n];\nconst METHODS = [\n  {id: 'range', kind: 'range', name: '范围检索', unlock: 1, detail: 'BETWEEN · 选有效观测区间'},\n  {id: 'fulltext', kind: 'keyword', name: '全文检索', unlock: 2, detail: 'MATCH · 识别监听代号'},\n  {id: 'vector', kind: 'vector', name: '向量检索', unlock: 3, detail: 'L2 · 比对八维回波特征'},\n  {id: 'filter', kind: 'filter', name: '条件筛选', unlock: 4, detail: 'WHERE · 排除旧任务与传闻'},\n];\nconst TUTORIAL = [\n  ['先安排自己的舰队', '点舰身选船，再点船头的目标格；方向键移动，R以船头为中心旋转，船头位置不变。确认后出航。'],\n  ['查情报，再读SQL结果', '定位SQL给出坐标；回波向量加监听词查更多线索。读完结果后自动定位，确认出航。'],\n  ['点格、发射、追击', '空心圈是落空，橙色是命中。普通炮不重打，雷达与武器在菜单里。'],\n];\nconst MEDALS = {\n  lightweight: ['极致轻量', '最长舰缩短一格，解锁嵌入式三联炮。'],\n  fork: ['Fork / Merge', FORK_DESCRIPTION],\n  mysql: ['MySQL 兼容', '复制敌舰双炮协议，每四轮普通双响。'],\n  distributed: ['分布式扩展', '解锁四角四点弹；第六关增加隔格九点弹，同系列每关共享一发。'],\n  piercing: ['异步向量索引导弹', '每关一枚X形五点导弹。'],\n  ultimate: ['究极分布式扩展', '解锁5×5隔格九点弹，与四角弹共享弹包。'],\n};\nlet db;\nlet campaign;\nlet state;\nlet deal;\nlet detailEvidence = null;\nlet detailSelection = {sample:'',keyword:''};\nlet busy = true;\nlet serial = 0;\nlet tableNames;\nlet cards = new Set();\nlet abilities = new Set();\nlet targets = [];\nlet hover = null;\nlet selectedShip = 0;\nlet deploySerial = 0;\nlet fx = null;\nlet noteSerial = 0;\nlet queryMetrics = [];\nlet logs = [];\nlet notes = [];\nlet view = 'welcome';\nlet tutorialIndex = 0;\nlet recordsOpen = false;\nlet archive;\nlet battleFit;\nlet gameDatabase = null;\nlet restartRequested = false;\nlet recoveringAction = false;\nlet saveBlocked = false;\nlet resetInProgress = false;\nlet resetIntent = null;\nlet uiSaveTimer;\nlet finishAnimation = () => {};\nlet businessSql = [];\nlet maintenanceRevision = 0;\nconst tableResources = new DynamicTableResources();\nconst reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;\n\nfunction element(tag, className, text) {\n  const node = document.createElement(tag);\n  if (className) node.className = className;\n  if (text !== undefined) node.textContent = text;\n  return node;\n}\n\nfunction freshSeed() {\n  return `SEA-${crypto.getRandomValues(new Uint32Array(1))[0].toString(36).toUpperCase()}`;\n}\n\nfunction notify(message, type = 'info') {\n  logs.unshift({round: state?.round ?? 0, message, type});\n  logs = logs.slice(0, 50);\n  const status = $('status-message');\n  if (status) {status.textContent = message; status.dataset.tone = type;}\n  const area = $('battle-log');\n  area.replaceChildren(...logs.map(item => {\n    const row = element('p', `log-line ${item.type}`);\n    row.append(element('b', '', String(item.round).padStart(2, '0')), document.createTextNode(` ${item.message}`));\n    return row;\n  }));\n}\n\nasync function createDynamicTable(name, sql, parent = null) {\n  return tableResources.create(name, () => db.exec(sql), parent);\n}\n\nasync function cleanupDynamicTables() {\n  // OPFS 中保留整局的分支和历史，只在明确重开新游戏时删除整局数据库。\n  if (gameDatabase) return;\n  await tableResources.cleanup({\n    keep: [campaign?.notesTable, tableNames?.live, tableNames?.checkpoint, tableNames?.notes],\n    drop: name => db.exec(`DROP TABLE IF EXISTS \\`${name}\\``),\n    warn: (name, error) => console.warn(`动态表清理失败，将在后续动作重试：${name}`, error),\n  });\n}\n\nfunction saveStatus(text, error = false) {\n  $('save-status').textContent = text;\n  $('save-status').dataset.tone = error ? 'error' : 'saved';\n  $('save-database').textContent = gameDatabase ? `opfs://${gameDatabase}` : '每局使用独立 seekdb 数据库';\n}\n\nfunction archivePayload() {\n  return clone({version:1, campaign, state, deal, detailEvidence, detailSelection, serial, tableNames,\n    cards:[...cards], abilities:[...abilities], targets, selectedShip, deploySerial, noteSerial,\n    queryMetrics, logs, notes, view, tutorialIndex, recordsOpen, resources:tableResources.entries(),\n    ui:{shrinkEnabled:$('shrink-toggle').checked,seed:$('new-seed').value,fitMode:document.body.dataset.battleFitMode||'fit',\n      resultTitle:$('result-title').textContent,resultCopy:$('result-copy').textContent,\n      resultAction:$('next-level').textContent,resultVisible:!$('result-panel').hidden},\n    lifecycle:{sql:$('database-lifecycle-sql').textContent,result:$('database-lifecycle-result').textContent}});\n}\n\nfunction restorePayload(payload) {\n  if (payload?.version !== 1 || !payload.campaign || !payload.state?.enemy?.ships || !payload.state?.player?.ships\n    || !Number.isInteger(payload.campaign.level) || payload.campaign.level \u003c 1 || payload.campaign.level > 6) {\n    throw new Error('航海日志格式不匹配，原存档已保留；请重试或明确选择重开新游戏。');\n  }\n  ({campaign,state,deal,detailEvidence,detailSelection,serial,tableNames,targets,selectedShip,deploySerial,noteSerial,\n    queryMetrics,logs,notes,view,tutorialIndex,recordsOpen}=clone(payload));\n  cards=new Set(payload.cards);abilities=new Set(payload.abilities);tableResources.restore(payload.resources);\n  if(state.activeSector)state.knowledge=state.sectorKnowledge[state.activeSector];\n  $('shrink-toggle').checked=payload.ui.shrinkEnabled;$('new-seed').value=payload.ui.seed;\n  battleFit?.setMode(payload.ui.fitMode||'fit');\n  $('result-title').textContent=payload.ui.resultTitle;$('result-copy').textContent=payload.ui.resultCopy;\n  $('next-level').textContent=payload.ui.resultAction;$('result-panel').hidden=!payload.ui.resultVisible;\n  $('database-lifecycle-sql').textContent=payload.lifecycle?.sql||'';\n  $('database-lifecycle-result').textContent=payload.lifecycle?.result||'';\n  $('database-lifecycle').hidden=!payload.lifecycle?.sql;\n  fx=null;\n}\n\nasync function persistArchive(label='自动存档', pending=null) {\n  if(!archive||!gameDatabase||!campaign)return;\n  saveStatus('OPFS · 正在保存航海日志…');\n  const sql=businessSql;businessSql=[];\n  const payload=archivePayload();\n  try {\n    await persistentWrite(db,()=>archive.save(gameDatabase,payload,{pending,label,sql}),{\n      onRetry:()=>saveStatus(restartRequested?'正在整理数据库，然后重开…':'OPFS · 正在整理并保存航海日志…'),\n    });\n    saveStatus(`OPFS · 已保存 · 第${campaign.level}关 / 第${state.round}回合`);\n  } catch(error) {\n    businessSql.unshift(...sql);saveBlocked=true;saveStatus('存档失败 · 请重试，原档保留',true);throw error;\n  }\n}\n\nfunction scheduleUISave() {\n  if(!db||!campaign||saveBlocked||restartRequested)return;\n  clearTimeout(uiSaveTimer);\n  uiSaveTimer=setTimeout(()=>{\n    if(busy){scheduleUISave();return;}\n    void operation(async()=>{},'保存选择');\n  },250);\n}\n\nfunction showDatabaseSql(statements,result) {\n  $('database-lifecycle').hidden=false;\n  $('database-lifecycle-title').textContent='本局数据库 · 实际执行的 SQL';\n  $('database-lifecycle-sql').textContent=statements.join('\\n');\n  $('database-lifecycle-result').textContent=result;\n}\n\nasync function replaceGameDatabase(reset=resetIntent) {\n  view='restarting';render();\n  const oldDatabase=reset?reset.oldDatabase:gameDatabase;\n  const next=reset?.newDatabase??makeGameDatabaseName(Date.now(),oldDatabase||'');\n  if(!isGameDatabaseName(next)||(oldDatabase&&!isGameDatabaseName(oldDatabase)))throw new Error('数据库名称不合法，未执行删除。');\n  await persistentWrite(db,()=>archive.beginReset(oldDatabase,next),{onRetry:()=>saveStatus('正在整理数据库，准备创建新局…')});\n  resetInProgress=true;resetIntent={oldDatabase,newDatabase:next};\n  const statements=[];\n  if(oldDatabase){\n    const sql=`DROP DATABASE IF EXISTS \\`${oldDatabase}\\`;`;\n    statements.push(sql);showDatabaseSql(statements,'正在删除旧战役数据库…');\n    await db.exec(sql);\n  }\n  gameDatabase=next;tableResources.restore([]);tableNames=null;serial=0;\n  const exists=await db.query(`SHOW DATABASES LIKE ${quote(next)}`);\n  // 尚未完成首次存档的新库只含初始化中间表；续建时清理这些表，仍使用同一预定库名。\n  if(reset&&exists.rows.length){\n    const cleanup=`DROP DATABASE IF EXISTS \\`${next}\\`;`;\n    statements.push(cleanup);showDatabaseSql(statements,'正在重新建立尚未完成的新局数据库…');\n    await db.exec(cleanup);\n  }\n  const create=`CREATE DATABASE ${!reset&&exists.rows.length?'IF NOT EXISTS ':''}\\`${next}\\`;`;\n  statements.push(create);showDatabaseSql(statements,'正在创建本局独立数据库…');\n  await db.exec(create);await createSchema(next);await archive.initGame(next);\n  maintenanceRevision=0;\n  businessSql=[];saveBlocked=false;\n  showDatabaseSql(statements,'执行成功。新战役数据将由 seekdb 写入 OPFS；刷新可继续这一局。');\n}\n\nasync function finishGameDatabaseReset() {\n  if(!resetInProgress)return;\n  if(!campaign||!state||gameDatabase!==resetIntent?.newDatabase)throw new Error('新局尚无完整状态，未清除重开请求。');\n  // 只有完整首档COMMIT成功后才切换目录，刷新时才能区分完成的新局与初始化中间状态。\n  await persistentWrite(db,()=>archive.finishReset(gameDatabase));\n  resetInProgress=false;resetIntent=null;\n}\n\nfunction requestNewGame() {\n  if($('help-dialog').open)$('help-dialog').close();\n  if(restartRequested)return;\n  restartRequested=true;clearTimeout(uiSaveTimer);finishAnimation();\n  $('restart-game').textContent='正在重开…';\n  saveStatus('正在结束旧操作，准备重开新游戏…');\n  if(!busy&&db)void operation(async()=>{});\n}\n\nasync function restoreWorkingData() {\n  // 工作表由完整存档重建，未完成操作留下的中间写入不能改变已保存战役。\n  const level=LEVELS[campaign.level-1];\n  await db.exec(`USE \\`${gameDatabase}\\``);\n  await db.exec(`REPLACE INTO capabilities VALUES ('enemy','double_fire',${level.enemyDoubleEvery})`);\n  await db.exec(\"DELETE FROM capabilities WHERE owner='player'\");\n  if(campaign.medals.includes('mysql'))await db.exec(`REPLACE INTO capabilities VALUES ('player','double_fire',${state.copiedDoubleEvery||LEVELS[2].enemyDoubleEvery})`);\n  const occupied=new Set(state.enemy.ships.flatMap(ship=>ship.cells.map(key)));\n  await db.exec('DELETE FROM radar_echoes');\n  await db.exec(`INSERT INTO radar_echoes VALUES ${Array.from({length:level.size**2},(_,i)=>`(${i%level.size},${Math.floor(i/level.size)},${occupied.has(`${i%level.size},${Math.floor(i/level.size)}`)?1:0},${campaign.level===5&&i%level.size>=level.size/2?1:0})`).join(',')}`);\n  if(deal){const details=detailEvidence;await writeEvidence(deal);detailEvidence=details;}\n  if(tableNames){\n    const ids=notes.map(n=>quote(n.id));\n    for(const table of new Set([campaign.notesTable,tableNames.notes])){\n      await db.exec(`DELETE FROM ${table}${ids.length?` WHERE id NOT IN (${ids.join(',')})`:''}`);\n    }\n    await saveState();\n  }\n  await restoreSerialHighWater();\n}\n\nasync function restoreSerialHighWater() {\n  const tables=await db.query('SHOW TABLES');\n  for(const row of tables.rows)for(const name of Object.values(row)){\n    if(/^(?:notes_main_\\d+|(?:live|checkpoint|notes_work|checkpoint_edit|live_restore|notes_after)_\\d+_\\d+_\\d+)$/.test(name)){\n      serial=Math.max(serial,...name.match(/\\d+/g).map(Number));\n    }\n  }\n}\n\nasync function operation(work,label=work.name||'作战操作',{newGame=false}={}) {\n  if (busy) return;\n  if(saveBlocked&&!restartRequested){notify('航海日志保存失败。请刷新重试，或点击“重开新游戏”。','error');return;}\n  // SQL动作失败时恢复可操作状态；序号保持单调，已创建的分支名称不复用。\n  const backup = clone({campaign, state, deal, detailEvidence, detailSelection, tableNames, notes, queryMetrics, targets,\n    cards: [...cards], abilities: [...abilities], noteSerial, view, tutorialIndex, gameDatabase});\n  busy = true;\n  render();\n  let actionStarted=false;\n  try {\n    // 定期请求Memstore正常落盘；不清除任何战役行或分支，不改变游戏规则。\n    if(archive&&gameDatabase&&archive.revision-maintenanceRevision>=8){\n      await db.exec('ALTER SYSTEM MINOR FREEZE');maintenanceRevision=archive.revision;\n    }\n    if(!restartRequested&&!newGame)await persistArchive(label,{kind:work===fire?'fire':'operation',label});\n    actionStarted=true;\n    if(!restartRequested)await work();\n    if(!restartRequested){await persistArchive(label);await finishGameDatabaseReset();}\n  }\n  catch (error) {\n    if(resetInProgress||backup.gameDatabase!==gameDatabase){\n      campaign=null;state=null;deal=null;tableNames=null;view='welcome';saveBlocked=true;\n      detailEvidence=null;detailSelection={sample:'',keyword:''};\n      cards=new Set();abilities=new Set();targets=[];hover=null;fx=null;recordsOpen=false;\n      saveStatus('新局尚未建好 · 可刷新恢复或再次重开',true);\n      $('database-lifecycle-result').textContent=`执行失败：${error.message}。已保留重开请求；刷新可继续建立同一新局。`;\n      notify(`建立新战役失败，未把旧局状态写入新库：${error.message}`,'error');return;\n    }\n    ({campaign, state, deal, detailEvidence, detailSelection, tableNames, notes, queryMetrics, targets, view, tutorialIndex} = backup);\n    cards = new Set(backup.cards); abilities = new Set(backup.abilities);\n    // 补偿已成功写入而动作尚未提交的笔记，避免重试或Merge保留幽灵记录。\n    if (tableNames?.notes && campaign) {\n      try {\n        const added = Array.from({length: Math.max(0, noteSerial - backup.noteSerial)}, (_, i) =>\n          quote(`${campaign.id}-${campaign.level}-${backup.noteSerial + i + 1}`));\n        if (added.length) await db.exec(`DELETE FROM ${tableNames.notes} WHERE id IN (${added.join(',')})`);\n      } catch (cleanupError) { notify(`未能清理失败动作的笔记：${cleanupError.message}`, 'error'); }\n    }\n    if (state?.activeSector) state.knowledge = state.sectorKnowledge[state.activeSector];\n    notify(`执行失败：${error.message}`, 'error');\n    $('engine-detail').textContent = error.message;\n    if(recoveringAction){\n      saveBlocked=true;saveStatus('上次炮击尚未完成 · 原存档保留，请刷新重试',true);return;\n    }\n    if(actionStarted&&!saveBlocked&&!restartRequested){try{await persistArchive('操作失败，恢复原状态');}catch{/* 保留原存档及错误提示。 */}}\n  } finally {\n    // 成功时保留新引用；失败时backup已恢复，先保留旧引用再清理孤立分支。\n    await cleanupDynamicTables();\n    busy = false; render();\n    if(restartRequested&&db){\n      restartRequested=false;$('restart-game').textContent='重开新游戏';saveBlocked=false;\n      await operation(async()=>{await startCampaign(freshSeed());},'重开新游戏',{newGame:true});\n    }\n  }\n}\n\nfunction boardSize() { return state?.player.size ?? 8; }\nfunction availableMethods() { return METHODS.filter(method => method.unlock \u003c= (campaign?.level ?? 1)); }\nfunction hasMedal(name) { return campaign?.medals.includes(name); }\nfunction canRewind() { return Boolean(state?.deploymentConfirmed && tableNames?.checkpoint\n  && canUseFork({owned: hasMedal('fork'), level: campaign.level,\n    lastUse: campaign.lastForkUseLevel, used: campaign.rewinds[campaign.level]})); }\nfunction ordinaryShots() {\n  return hasMedal('mysql') && state?.copiedDoubleEvery > 0 && state.round % state.copiedDoubleEvery === 0 ? 2 : 1;\n}\n\nasync function createSchema(name) {\n  await db.exec(`USE \\`${name}\\``);\n  await db.exec(`CREATE TABLE IF NOT EXISTS intelligence (\n    id VARCHAR(64) PRIMARY KEY, sector_id VARCHAR(8), cells LONGTEXT, tactical_cells LONGTEXT, tactical_hint TEXT,\n    tactical_clues LONGTEXT, fleet_manifest TEXT, map_x DOUBLE, map_y DOUBLE, enemy_fire_every INT, detail_keyword VARCHAR(24), body TEXT,\n    source VARCHAR(24), confidence INT, observed_round INT, mission_id VARCHAR(64),\n    ship_class VARCHAR(24), call_sign VARCHAR(24), embedding VECTOR(8),\n    FULLTEXT INDEX ft_body(body), VECTOR INDEX idx_signal(embedding)\n    WITH (distance=l2, type=hnsw, lib=vsag))`);\n  await db.exec('CREATE TABLE IF NOT EXISTS sea_cells (x INT, y INT, PRIMARY KEY(x,y), INDEX grid_yx(y,x))');\n  await db.exec('DELETE FROM sea_cells');\n  const cells = [];\n  for (let y = 0; y \u003c 12; y++) for (let x = 0; x \u003c 12; x++) cells.push(`(${x},${y})`);\n  await db.exec(`INSERT INTO sea_cells VALUES ${cells.join(',')}`);\n  await db.exec('CREATE TABLE IF NOT EXISTS capabilities (owner VARCHAR(16), skill VARCHAR(24), every_n INT, PRIMARY KEY(owner,skill))');\n  await db.exec(`CREATE TABLE IF NOT EXISTS tactical_observations (\n    id VARCHAR(80) PRIMARY KEY, sector_id VARCHAR(8), mission_id VARCHAR(64), observed_round INT,\n    clue_id VARCHAR(64), kind VARCHAR(32), clue_text TEXT, body TEXT, source VARCHAR(24), embedding VECTOR(8), payload_json LONGTEXT,\n    FULLTEXT INDEX ft_detail(body), VECTOR INDEX idx_detail_signal(embedding)\n    WITH (distance=l2, type=hnsw, lib=vsag))`);\n  await db.exec('CREATE TABLE IF NOT EXISTS radar_echoes (x INT, y INT, occupied INT, jammed INT, PRIMARY KEY(x,y))');\n  await db.exec('CREATE TABLE IF NOT EXISTS naval_tactic_cells (mission_id VARCHAR(64),sector_id VARCHAR(8),x INT,y INT,tag VARCHAR(24),PRIMARY KEY(mission_id,sector_id,x,y,tag))');\n  await db.exec('CREATE TABLE IF NOT EXISTS naval_public_shots (mission_id VARCHAR(64),sector_id VARCHAR(8),x INT,y INT,state VARCHAR(16),PRIMARY KEY(mission_id,sector_id,x,y))');\n  await db.exec('CREATE TABLE IF NOT EXISTS naval_pattern_offsets (weapon VARCHAR(24),dx INT,dy INT,span INT,PRIMARY KEY(weapon,dx,dy))');\n  await db.exec('DELETE FROM naval_pattern_offsets');\n  const offsets=[];\n  for(const [weapon,span] of [['radar',2],['distributed_i',4],['distributed_ii',5],['piercing',3]]){\n    const points=weapon==='radar'?[{x:0,y:0},{x:1,y:0},{x:0,y:1},{x:1,y:1}]:weaponPatternAtAnchor(weapon,{x:0,y:0},12);\n    for(const c of points)offsets.push(`(${quote(weapon)},${c.x},${c.y},${span})`);\n  }\n  await db.exec(`INSERT INTO naval_pattern_offsets VALUES ${offsets.join(',')}`);\n  await db.exec(\"REPLACE INTO capabilities VALUES ('enemy','double_fire',2)\");\n}\n\nasync function startCampaign(seed = freshSeed(), reuseDatabase = false) {\n  if(!reuseDatabase)await replaceGameDatabase();\n  const cleanSeed = String(seed).trim().slice(0, 64) || freshSeed();\n  campaign = {seed: cleanSeed, id: ++serial, level: 1, medals: [], score: 0, rewinds: {}, lastForkUseLevel: null};\n  logs = []; notes = []; queryMetrics = []; noteSerial = 0;\n  $('new-seed').value = cleanSeed;\n  await db.exec(\"DELETE FROM capabilities WHERE owner='player'\");\n  const name = `notes_main_${serial}`;\n  await createDynamicTable(name, `CREATE TABLE ${name} (id VARCHAR(80) PRIMARY KEY, level_no INT, round_no INT, kind VARCHAR(12), body TEXT)`);\n  campaign.notesTable = name;\n  await prepareLevel();\n}\n\nasync function prepareLevel() {\n  const level = LEVELS[campaign.level - 1];\n  const enemySeed = `${campaign.seed}|enemy|${campaign.level}`;\n  const lightweight = hasMedal('lightweight');\n  await db.exec(`REPLACE INTO capabilities VALUES ('enemy','double_fire',${level.enemyDoubleEvery})`);\n  state = {\n    phase: 'deploy', rewardsConfirmed:false, pendingRewards:[], rewardCards:[], projectileStyle:{}, deploymentConfirmed: false, briefingAccepted: false, round: 1, enemySeed,\n    player: createFleet(level.playerShips, {size: level.size, seed: `${campaign.seed}|player|${campaign.level}`, lightweight, noTouch:true}),\n    enemy: createEnemyFleet({level: campaign.level, seed: enemySeed}),\n    knowledge: createKnowledge(level.size), aiKnowledge: createKnowledge(level.size),\n    activeSector: null, proposedSector: 'S1', sectorKnowledge: {}, globalShots: {}, enemySector: null,\n    queryUsed: false, reconLocked: false, mapPin: null, wasHit: false, heat: [], resultRows: [], copiedDoubleEvery: 0,\n    ammo: {radar: level.radarCharges, dual: level.dualCharges, triple: level.tripleCharges}, radarFindings: [], radarKnowledge: {}, lastRadarSql: '', impact: null,\n    reconChoiceId:'',detailChoiceId:'',rejectedReconChoices:[],rejectedDetailChoices:[],\n    mapMarks:{},detailComparisons:null,hybridReady:false,support:{focus:[],submarine:[],safe:[],cells:[],protocols:[]},relayDisabled:false,sweepRound:null,tacticPlans:[],lastTacticSql:'',detailRows: [], acquiredDetailRows: [], lastDetailSql: '', lastDetailInput: null, detailMs: 0, detailFeedback: '',\n    weapon: 'normal', direction: 'horizontal', specialUsed: {distributed: false, piercing: false},\n    levelScore: 0, shotHistory: [], lastSql: '', lastReconSql: '', lastMs: 0,\n  };\n  state.enemySector = generateEvidence({fleet: state.enemy, level: campaign.level, round: 1, seed: campaign.seed}).truth.targetSector;\n  // 雷达裁判表单独预载，情报表只保存粗线索。正常界面只能按雷达模板查询四格。\n  const occupied = new Set(state.enemy.ships.flatMap(ship => ship.cells.map(key)));\n  const echoes = Array.from({length: level.size ** 2}, (_, i) => `(${i % level.size},${Math.floor(i / level.size)},${occupied.has(`${i % level.size},${Math.floor(i / level.size)}`) ? 1 : 0},${campaign.level===5 && i%level.size>=level.size/2?1:0})`);\n  await db.exec('DELETE FROM radar_echoes');\n  await db.exec(`INSERT INTO radar_echoes VALUES ${echoes.join(',')}`);\n  if (hasMedal('mysql')) {\n    const config = await db.query(\"SELECT every_n FROM capabilities WHERE owner='player' AND skill='double_fire'\");\n    state.copiedDoubleEvery = Number(config.rows[0]?.every_n ?? 0);\n  }\n  selectedShip = 0; deploySerial = 0; targets = []; cards.clear(); abilities.clear();\n  deal = null; detailEvidence = null; detailSelection={sample:'',keyword:''}; tableNames = null; view = 'deploy'; $('result-panel').hidden = true;\n  $('shrink-toggle').checked = lightweight;\n  notify(`进入第${campaign.level}关。先部署舰队，再选择资料进行检索。`);\n  if (campaign.level === 1) notify('第一关先用时间范围定位，再用回波和监听词查更多线索。');\n  notify('点舰身选船，再点船头目标格；方向键移动，R以船头为中心旋转，船头不动。确认后出航。');\n  render();\n}\n\nasync function writeEvidence(evidence) {\n  detailEvidence=createDetailEvidence({evidence,level:campaign.level,seed:campaign.seed});\n  const manifest = JSON.stringify(LEVELS[campaign.level - 1].enemyShips);\n  const archive=Array.from({length:128},(_,i)=>({...evidence.rows[i%evidence.rows.length],id:`archive-${i}`,observed_round:0,mission_id:'archived-mission',source:'ARCHIVE',confidence:20,call_sign:'ARCHIVE',body:`港口旧档案${i}：${detailEvidence.signalStory.archiveLines[i%detailEvidence.signalStory.archiveLines.length]}`,tactical_clues:'[]',tactical_hint:''}));\n  const values = [...evidence.rows,...archive].map(row => {\n    const bounds = boundsFromCells(row.cells);\n    return `(${[\n    row.id, row.sector_id, row.cells, row.tactical_cells, row.tactical_hint, JSON.stringify(JSON.parse(row.tactical_clues || '[]').slice(0,1).map(({id,kind,text,basis})=>({id,kind,text,basis}))), manifest,\n      bounds.minX + bounds.width / 2, bounds.minY + bounds.height / 2, LEVELS[campaign.level - 1].enemyDoubleEvery, detailEvidence.keyword,\n      row.body, row.source, row.confidence, row.observed_round, row.mission_id, row.ship_class, row.call_sign, JSON.stringify(row.embedding),\n    ].map(value => typeof value === 'number' ? value : quote(value)).join(',')})`;\n  });\n  await db.exec('BEGIN');\n  try {\n    await db.exec('DELETE FROM intelligence');\n    await db.exec(`INSERT INTO intelligence VALUES ${values.join(',')}`);\n    await db.exec('DELETE FROM tactical_observations');\n    const detailValues=detailEvidence.rows.map(row=>`(${[row.id,row.sector_id,row.mission_id,row.observed_round,row.clue_id,row.kind,row.clue_text,row.body,row.source,JSON.stringify(row.embedding),row.payload_json||'{}'].map(value=>typeof value==='number'?value:quote(value)).join(',')})`);\n    await db.exec(`INSERT INTO tactical_observations VALUES ${detailValues.join(',')}`);\n    await db.exec('COMMIT');\n  } catch (error) { await db.exec('ROLLBACK'); throw error; }\n}\n\nasync function dealEvidence() {\n  const next = generateEvidence({fleet: state.enemy, level: campaign.level, round: state.round, seed: campaign.seed});\n  await writeEvidence(next);\n  deal = next;\n  cards.clear(); abilities.clear();\n}\n\nfunction packState() {\n  // 真实敌舰布局只由裁判保管；快照用固定种子及公开炮击记录重建。\n  const {enemy, enemySector, ...publicState} = state;\n  return clone(publicState);\n}\n\nasync function saveState() {\n  if (!tableNames) return;\n  await db.exec(`UPDATE ${tableNames.live} SET state_json=${quote(JSON.stringify(packState()))} WHERE id=1`);\n}\n\nasync function confirmDeployment() {\n  const check = validateFleet(state.player);\n  if (!check.ok) throw new Error(check.errors.join('，'));\n  state.phase = 'player'; state.deploymentConfirmed = true; state.briefingAccepted = false;\n  // 调整布阵后重建开局分支，不能把已通过的情报门槛带进回档快照。\n  state.reconLocked = false; state.queryUsed = false; state.resultRows = []; state.heat = []; state.mapPin = null;\n  state.hybridReady=false;state.detailComparisons=null;state.support={focus:[],submarine:[],safe:[],cells:[],protocols:[]};state.tacticPlans=[];state.lastTacticSql='';state.mapMarks={};state.relayDisabled=false;state.sweepRound=null;\n  state.lastReconSql = ''; state.lastSql = ''; state.lastDetailSql=''; state.lastDetailInput=null; state.detailRows=[]; state.acquiredDetailRows=[]; state.detailFeedback=''; detailSelection={sample:'',keyword:''};\n  state.reconChoiceId='';state.detailChoiceId='';state.rejectedReconChoices=[];state.rejectedDetailChoices=[];\n  cards.clear();abilities.clear();\n  state.activeSector = null; state.sectorKnowledge = {}; state.globalShots = {};\n  state.knowledge = createKnowledge(boardSize());\n  if (tableNames) {\n    await saveState();\n    const checkpoint = `checkpoint_edit_${campaign.id}_${campaign.level}_${++serial}`;\n    await createDynamicTable(checkpoint, `FORK TABLE ${tableNames.live} TO ${checkpoint}`, tableNames.live); tableNames.checkpoint = checkpoint;\n    setView(state.activeSector ? 'battle' : state.queryUsed ? 'theater' : 'intel');\n    notify('舰队已就位。'); return;\n  }\n  state.queryUsed = false;\n  const unique = `${campaign.id}_${campaign.level}_${++serial}`;\n  tableNames = {live: `live_${unique}`, checkpoint: `checkpoint_${unique}`, notes: `notes_work_${unique}`};\n  await createDynamicTable(tableNames.live, `CREATE TABLE ${tableNames.live} (id INT PRIMARY KEY, state_json LONGTEXT)`);\n  await db.exec(`INSERT INTO ${tableNames.live} VALUES (1,${quote(JSON.stringify(packState()))})`);\n  await createDynamicTable(tableNames.checkpoint, `FORK TABLE ${tableNames.live} TO ${tableNames.checkpoint}`, tableNames.live);\n  await createDynamicTable(tableNames.notes, `FORK TABLE ${campaign.notesTable} TO ${tableNames.notes}`, campaign.notesTable);\n  await dealEvidence();\n  view = 'intel';\n  notify('舰队部署完成。先读任务目标，再为每种检索选资料；对应能力会自动装配。');\n}\n\nasync function addNote(kind, message) {\n  const item = {id: `${campaign.id}-${campaign.level}-${++noteSerial}`, level: campaign.level, round: state.round, kind, message, previous: false};\n  notes.unshift(item);\n  await db.exec(`REPLACE INTO ${tableNames.notes} VALUES (${quote(item.id)},${item.level},${item.round},${quote(kind)},${quote(message)})`);\n}\n\nfunction currentPlan() {\n  return buildQuery({selectedCards: deal?.cards.filter(card => cards.has(card.id)) ?? [],\n    abilities: [...abilities], missionId: deal?.missionId ?? '', round: state?.round ?? 1});\n}\n\nfunction reconChoices() { return deal ? createReconChoices({deal,level:campaign.level}) : []; }\nfunction detailChoices() { return detailEvidence ? createDetailChoices({evidence:detailEvidence,seed:campaign.seed,level:campaign.level}) : []; }\nfunction reconTask() {return deal?createReconTask({deal,level:campaign.level,seed:campaign.seed}):null;}\nfunction detailTask() {return detailEvidence?createDetailTask({evidence:detailEvidence,level:campaign.level,seed:campaign.seed}):null;}\nfunction selectReconCard(id) {\n  if(busy||!state||state.queryUsed)return;\n  const task=reconTask(),group=task.groups.find(g=>g.choices.some(c=>c.id===id));if(!group)return;\n  const deselect=cards.has(id);\n  for(const card of group.choices)cards.delete(card.id);\n  if(deselect)abilities.delete(group.ability);else{cards.add(id);abilities.add(group.ability);}\n  render();\n}\nfunction selectDetailInput(kind,id) {\n  if(busy||!state||state.hybridReady)return;\n  const input=detailTask()?.groups.find(g=>g.kind===kind)?.choices.find(c=>c.id===id);if(!input)return;\n  if(kind==='echo')detailSelection.sample=detailSelection.sample===input.name?'':input.name;\n  else detailSelection.keyword=detailSelection.keyword===input.keyword?'':input.keyword;\n  render();\n}\n\nasync function runRecon() {\n  if (state.phase !== 'player' || !state.deploymentConfirmed || state.reconLocked) return;\n  const plan = currentPlan();\n  if (!plan.valid) { notify(plan.error, 'error'); return; }\n  const panel = document.querySelector('.query-station'); panel.classList.add('is-running');\n  try {\n    const result = await db.query(plan.sql);\n    state.lastSql = plan.sql; state.lastReconSql = plan.sql; state.lastMs = result.elapsedMs;\n    state.resultRows = result.rows;\n    const check = checkRecon(result.rows, {level: campaign.level, targetSector: state.enemySector, abilities: [...abilities]});\n    queryMetrics.push({level: campaign.level, round: state.round, sql: plan.sql, ms: result.elapsedMs, rows: result.rows.length, accepted: check.ok});\n    state.reconLocked = check.ok; state.queryUsed = check.ok;\n    state.heat = check.ok ? [...new Map(result.rows.flatMap(row => JSON.parse(row.cells)).map(cell => [key(cell), cell])).values()] : [];\n    await animate('scan', state.heat, 'theater', null, 450);\n    if (!check.ok) {\n      const mismatch=reconTask().groups.flatMap(group=>group.choices.filter(c=>cards.has(c.id)&&c.mismatch).map(c=>c.mismatch));\n      view='intel';notify(`${mismatch.join(' ')||check.reason} 请对照任务目标调整资料；不消耗炮弹或海战回合。`,'warning');\n      await saveState(); return;\n    }\n    state.proposedSector = result.rows[0].sector_id; state.mapPin = null;\n    await addNote('query', `SQL已确认目标海域，返回${result.rows.length}条观测和固定战术线索。`);\n    notify('定位查询成功。先看 SQL 返回了什么，再查回波与监听关键词获取细节。', 'hit');\n    await saveState(); setView('briefing');\n  } finally { panel.classList.remove('is-running'); }\n}\n\nfunction currentDetailPlan(mode) {\n  const sample=detailEvidence?.samples.find(item=>item.name===detailSelection.sample);\n  const selectedMode=mode || (detailSelection.sample && detailSelection.keyword?'hybrid':detailSelection.sample?'vector':'fulltext');\n  return buildDetailQuery({sectorId:state?.resultRows[0]?.sector_id,missionId:deal?.missionId,\n    vector:sample?.vector,keyword:detailSelection.keyword,mode:selectedMode});\n}\n\nasync function runDetailSearch() {\n  if(!state?.deploymentConfirmed || !state.reconLocked || state.activeSector)return;\n  const plan=currentDetailPlan();if(!plan.valid){notify(plan.error,'warning');return;}\n  const both=Boolean(detailSelection.sample && detailSelection.keyword);\n  let vectorRows=[],textRows=[];\n  if(both){vectorRows=(await db.query(currentDetailPlan('vector').sql)).rows;textRows=(await db.query(currentDetailPlan('fulltext').sql)).rows;}\n  const result=await db.query(plan.sql);\n  state.lastDetailSql=plan.sql;state.lastDetailInput=clone(detailSelection);state.detailMs=result.elapsedMs;state.detailRows=result.rows;\n  if(both){\n    state.detailComparisons={vector:vectorRows.length,fulltext:textRows.length,hybrid:result.rows.length};\n    const clues=result.rows.filter(row=>isExtraClueKind(row.kind));\n    const acquired=new Map((state.acquiredDetailRows||[]).map(row=>[row.clue_id,row]));\n    for(const row of clues)acquired.set(row.clue_id,{...clone(row),retrievalSql:plan.sql});\n    state.acquiredDetailRows=[...acquired.values()];\n    state.support=normalizeSupportRows(state.acquiredDetailRows,{size:boardSize(),level:campaign.level});\n    state.hybridReady=state.support.protocols.length>0;\n    if(state.hybridReady)state.detailFeedback=`混合检索确认${clues.length}条观测，战术手册和本关支援已就绪。`;\n    else {\n      const mismatch=detailTask().groups.flatMap(group=>group.choices.filter(c=>(group.kind==='echo'?c.name===detailSelection.sample:c.keyword===detailSelection.keyword)&&c.mismatch).map(c=>c.mismatch));\n      state.detailFeedback=`${mismatch.join(' ')||detailEvidence.signalStory.feedback.empty} 请对照侦察目标调整；不消耗炮弹或海战回合。`;\n\n    }\n  }else state.detailFeedback=`单项检索得到${result.rows.length}条候选。再点击另一份情报，组合全文与向量条件。`;\n  queryMetrics.push({level:campaign.level,round:state.round,kind:'detail',sql:plan.sql,rows:result.rows.length,ms:result.elapsedMs});\n  await addNote('query',state.detailFeedback);notify(state.detailFeedback,state.hybridReady?'hit':'info');await saveState();\n}\n\nasync function acceptBriefing() {\n  if(!state?.deploymentConfirmed || !state.reconLocked || state.activeSector)return;\n  if(!state.hybridReady)throw new Error('按侦察目标选择回波与监听资料，执行混合检索，再带线索出航。');\n  const row=state.resultRows[0];\n  state.mapPin={x:Number(row.map_x),y:Number(row.map_y)};\n  state.briefingAccepted=true;await saveState();setView('theater');\n}\n\nfunction resultTable(rows, fields) {\n  const table=element('table','query-result-table');\n  const head=table.createTHead().insertRow();\n  for(const [field,label] of fields) head.append(element('th','',label));\n  const body=table.createTBody();\n  for(const row of rows) {\n    const line=body.insertRow();\n    for(const [field] of fields) line.append(element('td','',row[field]===undefined?'':String(row[field])));\n  }\n  return table;\n}\n\nfunction renderBriefing() {\n  if(!$('briefing-sql'))return;\n  const mission=DETAIL_MISSIONS[(campaign?.level||1)-1],story=detailEvidence?.signalStory;\n  $('detail-mission-title').textContent=`混合侦察 · ${story?.title||mission[0]}`;\n  $('detail-mission-help').textContent=`${mission[1]}${story?` 监听员备注：${story.listen.text}`:''}`;\n  $('briefing-sql').textContent=state?.lastReconSql||'先执行定位 SQL。';\n  const sourceCards=(state?.resultRows||[]).map(row=>{\n    const card=element('article','briefing-source');\n    const report=row.body.split('不提供单舰格。').at(-1);\n    card.append(element('h4','',row.source),element('p','',report));return card;\n  });\n  $('briefing-rows').replaceChildren(...(sourceCards.length?sourceCards:[element('p','','尚未执行定位查询。')]));\n  const row=state?.resultRows[0],findings=[];\n  if(state?.reconLocked&&row){\n    findings.push(element('p','',`${state.resultRows.length}份报告指向同一海域${row.sector_id}。共同结论合并展示，观测依据见各站报告。`));\n    findings.push(element('p','',`大海图：${chartColumn(Math.floor(Number(row.map_x)))}${Math.floor(Number(row.map_y))+1}附近，出航前自动标记。`));\n    try{for(const clue of JSON.parse(row.tactical_clues||'[]'))findings.push(element('p','',clue.text));}catch{}\n  }\n  $('briefing-findings').replaceChildren(...findings);\n  const task=detailTask();\n  $('detail-match-objective').textContent=task?.goal||'定位后接收侦察任务。';\n  const groups=[];\n  for(const group of task?.groups||[]) {\n    const section=element('section','retrieval-group');section.dataset.detailKind=group.kind;\n    section.append(element('h4','retrieval-group-title',group.label));\n    const pair=element('div','retrieval-pair');\n    for(const input of group.choices){\n      const selected=group.kind==='echo'?detailSelection.sample===input.name:detailSelection.keyword===input.keyword;\n      const button=element('button',`detail-source-card${selected?' selected':''}`);button.type='button';button.dataset.detailInputId=input.id;button.dataset.detailKind=group.kind;\n      button.setAttribute('aria-pressed',String(selected));button.disabled=busy||!state?.reconLocked||state.hybridReady;\n      button.append(element('strong','',input.label),element('span','evidence-body',input.text),element('span','evidence-acquisition',`获取渠道：${input.acquisition}`));\n      button.onclick=()=>selectDetailInput(group.kind,input.id);pair.append(button);\n    }\n    section.append(pair);groups.push(section);\n  }\n  $('detail-choice-groups').replaceChildren(...groups);\n  const plan=currentDetailPlan(),both=Boolean(detailSelection.sample&&detailSelection.keyword);\n  $('detail-sql-preview').textContent=plan.valid?plan.sql:'-- 按侦察目标选择回波与监听词，实时组合 SQL。';\n  $('run-detail-search').disabled=busy||!state?.reconLocked||state.hybridReady||!plan.valid||!both;\n  $('run-detail-search').textContent=state?.hybridReady?'线索已取得':both?'执行混合检索 →':'先选择回波与监听资料';\n  $('detail-feedback').textContent=state?.detailFeedback||'对照侦察目标，分别选择回波与监听资料；选错可调整后重查。';\n  const nodes=[];\n  if(state?.detailComparisons){const c=state.detailComparisons;nodes.push(element('p','briefing-findings',`仅回波 ${c.vector} 条候选 → 仅监听 ${c.fulltext} 条候选 → 混合条件 ${c.hybrid} 条观测`));}\n  for(const item of state?.detailRows||[]){\n    const card=element('article','briefing-source');\n    card.append(element('h4','',item.source),element('p','',item.clue_text));\n    const distance=item.distance==null?'尚未比较回波':`回波距离 ${Number(item.distance).toFixed(3)} ≤ 0.42`;\n    card.append(element('p','section-help',`${state.lastDetailInput?.keyword?`监听词「${state.lastDetailInput.keyword}」命中记录；`:''}${distance}`));\n    const raw=element('p','section-help',`依据原文：${item.body.slice(0,160)}${item.body.length>160?'…':''}`);card.append(raw);nodes.push(card);\n  }\n  $('detail-result-list').replaceChildren(...nodes);\n  $('accept-briefing').disabled=busy||!state?.hybridReady;\n  $('accept-briefing').textContent=state?.hybridReady?`带${queriedClues().length}条SQL线索出航`:'完成混合检索后出航';\n}\n\nfunction selectedBounds(sector = state?.activeSector) {\n  const record = state?.resultRows.find(row => row.sector_id === sector);\n  return record ? boundsFromCells(record.cells) : sectorBounds(sector, boardSize());\n}\n\nfunction projectKnowledge(sector) {\n  const bounds = selectedBounds(sector), knowledge = createKnowledge(boardSize());\n  const inside = cell => cell.x >= bounds.minX && cell.x \u003c= bounds.maxX && cell.y >= bounds.minY && cell.y \u003c= bounds.maxY;\n  for (const observation of Object.values(state.globalShots)) {\n    if (!inside(observation)) continue;\n    recordShot(knowledge, {...observation, x: observation.x - bounds.minX, y: observation.y - bounds.minY,\n      sunkCells: observation.sunkCells.filter(inside).map(cell => ({x: cell.x - bounds.minX, y: cell.y - bounds.minY}))});\n  }\n  return knowledge;\n}\n\nfunction renderTheater() {\n  const valid = canEnterSea(state);\n  const row = valid ? state.resultRows[0] : null;\n  $('sector-choice').disabled = true;\n  $('engage-sector').disabled = busy || state?.phase !== 'player' || !valid || !state.mapPin || Boolean(state.activeSector);\n  $('engage-sector').textContent = state?.activeSector ? '已抵达交战海域' : '就是这里，出航！';\n  $('active-sector-name').textContent = state?.activeSector ? `A～${chartColumn(boardSize()-1)} / 1～${boardSize()}` : '尚未抵达';\n  $('theater-hint').textContent = valid ? 'seekdb 已自动定位目标海域，直接点击「就是这里，出航！」。' : '先完成情报检索，再定位出航。';\n  $('map-target-readout').textContent = row ? `SQL已定位：${chartColumn(Math.floor(Number(row.map_x)))}${Math.floor(Number(row.map_y))+1} 附近` : '参考坐标等待 seekdb 查询。';\n  $('map-coordinates').textContent = state?.mapPin ? `已根据查询结果自动标记：${chartColumn(Math.floor(state.mapPin.x))}${Math.floor(state.mapPin.y)+1}` : '等待查询结果自动定位。';\n}\n\nasync function engageSector(sector) {\n  if (state.phase !== 'player' || !canEnterSea(state) || state.activeSector) return;\n  if(!state.hybridReady)throw new Error('先完成两份情报的混合检索。');\n  const row=state.resultRows[0];\n  if(!Number.isFinite(Number(row.map_x)) || !Number.isFinite(Number(row.map_y))) throw new Error('查询结果缺少有效导航坐标，请重新检索。');\n  state.mapPin={x:Number(row.map_x),y:Number(row.map_y)};\n  state.activeSector = state.resultRows[0].sector_id; state.proposedSector = state.activeSector;\n  state.knowledge = projectKnowledge(state.activeSector); state.sectorKnowledge[state.activeSector] = state.knowledge;\n  targets = []; $('map-feedback').textContent = '';\n  await addNote('move', `完成海图定位，进入${boardSize()}×${boardSize()}战场。`);\n  await saveState(); notify('抵达！先看手册里的 SQL 线索，再选点或使用雷达。', 'hit'); setView('battle');\n}\n\nfunction drawTheater(now) {\n  const canvas = $('theater-canvas'), ctx = canvas.getContext('2d'), w=canvas.width, h=canvas.height;\n  const world=boardSize()*2.5, pad=28, cw=w-pad*2, ch=h-pad*2;\n  ctx.imageSmoothingEnabled=false; ctx.fillStyle='#17485f'; ctx.fillRect(0,0,w,h);\n  ctx.font='12px PixelChinese, monospace'; ctx.textAlign='center'; ctx.textBaseline='middle';\n  for(let i=0;i\u003c=world;i++) {\n    const x=pad+i/world*cw, y=pad+i/world*ch;\n    ctx.strokeStyle=i%2 ? '#21566c' : '#2d6377'; ctx.lineWidth=1;\n    ctx.beginPath();ctx.moveTo(x,pad);ctx.lineTo(x,h-pad);ctx.moveTo(pad,y);ctx.lineTo(w-pad,y);ctx.stroke();\n    if(i\u003cworld && (world\u003c=20 || i%2===0)) {\n      ctx.fillStyle='#ecf1dc';ctx.fillText(chartColumn(i),pad+(i+.5)/world*cw,13);\n      ctx.fillText(String(i+1),13,pad+(i+.5)/world*ch);\n    }\n  }\n  if(state?.reconLocked && state.resultRows[0]) {\n    // 背景只使用SQL返回的战场范围；不读取任何舰船格。\n    const row=state.resultRows[0], b=boundsFromCells(row.cells);\n    ctx.fillStyle='#65c7b925';ctx.fillRect(pad+b.minX/world*cw,pad+b.minY/world*ch,b.width/world*cw,b.height/world*ch);\n  }\n  if(state?.mapPin) {\n    const x=pad+state.mapPin.x/world*cw,y=pad+state.mapPin.y/world*ch;\n    ctx.fillStyle='#ffc888';ctx.fillRect(x-8,y-1,17,3);ctx.fillRect(x-1,y-8,3,17);\n    ctx.strokeStyle='#ffc888';ctx.strokeRect(x-6,y-6,13,13);\n  }\n  if(fx?.side==='theater') {ctx.fillStyle='#a4e5ce66';ctx.fillRect(pad+(now-fx.start)/fx.duration*cw,pad,3,ch);}\n}\n\nfunction requiredTargets() {\n  return state?.weapon === 'normal' ? ordinaryShots() : state?.weapon === 'dual' ? 2 : state?.weapon === 'triple' ? 3 : 1;\n}\nfunction predictedArea(anchor = targets[0]) {\n  if (!anchor || !state) return [];\n  if (['normal','dual','triple'].includes(state.weapon)) return [...targets];\n  if (state.weapon === 'radar') return [{x:anchor.x,y:anchor.y},{x:anchor.x+1,y:anchor.y},{x:anchor.x,y:anchor.y+1},{x:anchor.x+1,y:anchor.y+1}].filter(c=>c.x\u003cboardSize()&&c.y\u003cboardSize());\n  return weaponPatternAtAnchor(state.weapon, anchor, boardSize());\n}\n\nfunction weaponAvailable(id) {\n  if (id === 'normal') return true;\n  if (['radar','dual','triple'].includes(id)) return Boolean(state?.ammo[id] > 0);\n  if (id === 'piercing') return hasMedal('piercing') && !state.specialUsed.piercing;\n  if (id.startsWith('distributed')) return hasMedal('distributed') && !state.specialUsed.distributed\n    && (id !== 'distributed_ii' || hasMedal('ultimate'));\n  return false;\n}\n\nfunction weaponUnlocked(id) {\n  if(!state)return false;\n  if(id==='normal')return true;\n  if(['radar','dual','triple'].includes(id))return LEVELS[campaign.level-1][`${id}Charges`]>0;\n  if(id==='piercing')return hasMedal('piercing');\n  if(id==='distributed_i')return hasMedal('distributed');\n  if(id==='distributed_ii')return hasMedal('distributed')&&hasMedal('ultimate');\n  return false;\n}\n\nasync function weaponArea() {\n  if (state.weapon === 'normal') return [...targets];\n  if (['dual','triple'].includes(state.weapon)) {\n    if (!weaponAvailable(state.weapon)) throw new Error('本关该弹药已用尽');\n    state.ammo[state.weapon]--; return [...targets];\n  }\n  if (!weaponAvailable(state.weapon)) throw new Error('本关该武器尚未解锁或弹药已用尽');\n  const pattern = predictedArea();\n  const sql = `SELECT x,y FROM sea_cells\\nWHERE ${pattern.map(cell => `(x=${cell.x} AND y=${cell.y})`).join(' OR ')}\\nORDER BY x,y;`;\n  const result = await db.query(sql);\n  state.lastWeaponSql = sql;\n  notify(`${weaponName(state.weapon)}：${result.rows.length}个落点。`);\n  state.specialUsed[state.weapon === 'piercing' ? 'piercing' : 'distributed'] = true;\n  return result.rows.map(row => ({x: Number(row.x), y: Number(row.y)}));\n}\n\nasync function scanRadar() {\n  if (!weaponAvailable('radar')) throw new Error('本关雷达额度已用尽');\n  const area=predictedArea();\n  if(area.length!==4) throw new Error('雷达需要完整2×2区域，请向海图内侧选点');\n  const calibrated=hasProtocol('radar_filter');\n  const sql=`SELECT x,y,CASE WHEN jammed=1 AND ${calibrated?1:0}=0 THEN NULL ELSE occupied END AS occupied,CASE WHEN jammed=1 THEN NULL ELSE occupied END AS raw_occupied FROM radar_echoes\\nWHERE ${area.map(c=>`(x=${c.x} AND y=${c.y})`).join(' OR ')}\\nORDER BY y,x;`;\n  const result=await db.query(sql); state.lastWeaponSql=sql; state.ammo.radar--;\n  state.radarFindings=result.rows.map(row=>({x:Number(row.x),y:Number(row.y),occupied:row.occupied==null?null:Number(row.occupied),rawOccupied:row.raw_occupied==null?null:Number(row.raw_occupied)}));\n  state.lastRadarSql=sql;\n  for(const cell of state.radarFindings) state.radarKnowledge[key(cell)]={...cell,round:state.round};\n  await animate('scan',area,'enemy','radar',600);\n  const echoes=state.radarFindings.filter(c=>c.occupied===1);\n  const quiet=state.radarFindings.filter(c=>c.occupied===0);const unknown=state.radarFindings.filter(c=>c.occupied==null);\n  const text=`扫描四格：${echoes.length}格有回波${echoes.length?`（${echoes.map(coord).join('、')}）`:''}，${quiet.length}格无回波${unknown.length?`，${unknown.length}格受扰未知`:''}。`;\n  renderRadarReport();\n  if(hasProtocol('radar_sweep')&&enemyFirePlan(campaign.level,state.round).shots===2){state.sweepRound=state.round;notify('扫频命中装填窗口，本轮敌方副炮受抑制。');}\n  if(calibrated)notify(`混合检索滤波：本次恢复${state.radarFindings.filter(r=>r.rawOccupied==null&&r.occupied!=null).length}格受扰回波。`);\n  await addNote('radar',text);notify(text);targets=[];state.weapon='normal';await enemyResponse();\n}\n\nasync function setMapMarks(kind,cells=targets,source='manual'){\n  if(state?.phase!=='player'||!state.activeSector)return;\n  if(!['flag','question','clear'].includes(kind))throw new Error('请选择红旗、问号或清除标记。');\n  const chosen=cells.filter(c=>Number.isInteger(c.x)&&Number.isInteger(c.y)&&c.x>=0&&c.y>=0&&c.x\u003cboardSize()&&c.y\u003cboardSize()&&!state.knowledge.shots[key(c)]);\n  if(!chosen.length){notify('先选择一个尚未投弹的格子，再放置标记。');return;}\n  for(const cell of chosen){if(kind==='clear')delete state.mapMarks[key(cell)];else state.mapMarks[key(cell)]={...cell,kind,source};}\n  targets=[];await saveState();notify(`${kind==='flag'?'已插红旗排除':kind==='question'?'已标白色问号':'已清除标记'}：${chosen.map(coord).join('、')}。不消耗炮弹和回合。`);\n}\n\nfunction hasProtocol(code){return Boolean(state?.support?.protocols.some(p=>p.code===code));}\n\nasync function requestSupportPlan(){\n  const weapon=hasProtocol('radar_recommend')?'radar':state.weapon;\n  if(!['radar','distributed_i','distributed_ii','piercing'].includes(weapon))throw new Error('先选择雷达或多点武器，再进行战术推演。');\n  if(!weaponAvailable(weapon))throw new Error('该武器本关库存不足。');\n  await db.exec('DELETE FROM naval_tactic_cells');await db.exec('DELETE FROM naval_public_shots');\n  const cells=state.support.cells;\n  if(cells.length)await db.exec(`INSERT INTO naval_tactic_cells VALUES ${cells.map(c=>`(${quote(deal.missionId)},${quote(state.activeSector)},${c.x},${c.y},${quote(c.tag)})`).join(',')}`);\n  const shots=Object.values(state.knowledge.shots);\n  if(shots.length)await db.exec(`INSERT INTO naval_public_shots VALUES ${shots.map(c=>`(${quote(deal.missionId)},${quote(state.activeSector)},${c.x},${c.y},${quote(c.state)})`).join(',')}`);\n  const sql=planSql({weapon,size:boardSize(),missionId:deal.missionId,sectorId:state.activeSector,limit:2});\n  const result=await db.query(sql);state.lastTacticSql=sql;state.tacticPlans=result.rows.map(r=>({...r,weapon}));\n  await saveState();notify(`seekdb 已比较公开待查区域，返回${result.rows.length}个覆盖方案。`);\n}\n\n\nasync function fire() {\n  if (state.phase !== 'player') return;\n  if (!canEnterSea(state) || !state.activeSector) throw new Error('请先完成真实SQL检索和海图定位');\n  if (state.weapon === 'radar') {await scanRadar(); return;}\n  const expected = requiredTargets();\n  if (targets.length !== expected) throw new Error(`请先选择${expected}个攻击坐标`);\n  if (state.weapon === 'normal') {\n    const fired=new Set(state.shotHistory.filter(shot=>shot.side==='player').map(key));\n    if(targets.some(cell=>fired.has(key(cell)))) throw new Error('这个位置已经投过炸弹，请选择新坐标。');\n  }\n  const area = await weaponArea();\n  const check = validateSalvo(area, ['normal','dual','triple'].includes(state.weapon) ? expected : 9, boardSize());\n  if (!check.ok) throw new Error(check.errors.join('，'));\n  state.phase = 'attacking';\n\n  render();\n  await animate('launch', area, 'enemy', state.weapon, state.weapon === 'normal' ? 500 : 750);\n  for (const cell of area) {\n    const bounds = selectedBounds(), enemyBounds = sectorBounds(state.enemySector, boardSize());\n    const shotNumber = state.shotHistory.filter(item => item.side === 'player').length;\n    const aim = resolveAim({selectedBounds: bounds, targetBounds: enemyBounds, cell,\n      rng: createRng(`${campaign.seed}|aim|${campaign.level}|${state.round}|${shotNumber}|${state.activeSector}`)});\n    const receipt = {side: 'player', sector: state.activeSector, round: state.round, x: cell.x, y: cell.y, drift: aim.drift, kind: aim.drift ? 'drift' : 'pending'};\n    state.shotHistory.push(receipt);\n    if (aim.drift) {\n      state.levelScore -= 3;\n      await animate('shot', [cell], 'enemy', 'drift', 360);\n      notify(`我方 ${state.activeSector}·${coord(cell)}：打偏！火控定位偏差，不能据此排除该格。`, 'warning');\n      await addNote('shot', `${state.activeSector}·${coord(cell)} 打偏（不标记空格）`);\n      continue;\n    }\n    const result = aim.target ? applyShot(state.enemy, aim.target) : {valid: true, kind: 'miss',\n      cellCleared: true, cellHp: 0, shipId: null, sunkCells: [], defeated: false};\n    if (!result.valid) {receipt.kind = 'repeated'; continue;}\n    receipt.kind = result.kind;\n    if(result.kind==='sunk'&&hasProtocol('relay_target')&&result.sunkCells.length===state.support.protocols.find(p=>p.code==='relay_target').target_length){state.relayDisabled=true;notify('我方切断副炮中继！敌方后续双炮停止。','hit');}\n    const globalResult = {...result, x: bounds.minX + cell.x, y: bounds.minY + cell.y,\n      sunkCells: result.sunkCells.map(part => ({x: enemyBounds.minX + part.x, y: enemyBounds.minY + part.y}))};\n    state.globalShots[key(globalResult)] = globalResult;\n    if (result.kind === 'sunk') for (const part of globalResult.sunkCells) state.globalShots[key(part)] = {...globalResult, ...part};\n    state.knowledge = projectKnowledge(state.activeSector); state.sectorKnowledge[state.activeSector] = state.knowledge;\n    state.levelScore += result.kind === 'sunk' ? 130 : result.kind === 'hit' ? 45 : -3;\n    await animate('shot', [cell], 'enemy', result.kind, result.kind === 'sunk' ? 1000 : area.length > 2 ? 420 : 600);\n    notify(`我方 ${state.activeSector}·${coord(cell)}：${{miss: '落空', hit: '命中', sunk: '击沉敌舰'}[result.kind]}。`, result.kind === 'miss' ? 'info' : 'hit');\n    await addNote('shot', `${state.activeSector}·${coord(cell)} ${result.kind === 'miss' ? '落空' : result.kind === 'sunk' ? '击沉' : '命中'}`);\n    if (result.defeated) { await victory(); return; }\n  }\n  targets = []; state.weapon = 'normal';\n  await enemyResponse();\n}\n\nasync function enemyResponse() {\n  state.phase = 'enemy'; render();\n  const level = LEVELS[campaign.level - 1];\n  const count = supportEnemyPlan({level:campaign.level,round:state.round,relayDisabled:state.relayDisabled,sweepRound:state.sweepRound}).shots;\n  const shots = chooseEnemyShots(state.aiKnowledge, count, createRng(`${campaign.seed}|ai|${campaign.level}|${state.round}`), {pursuit: level.enemyPursuit});\n  if (count > 1) notify('敌军双炮齐射。', 'warning');\n\n  await animate('launch', shots, 'fleet', 'normal', 480);\n  for (const cell of shots) {\n    const result = applyShot(state.player, cell);\n    if (!result.valid) throw new Error('敌方选择了无效炮击格');\n    recordShot(state.aiKnowledge, result);\n    state.shotHistory.push({side: 'enemy', round: state.round, kind: result.kind, x: cell.x, y: cell.y});\n    if (result.kind !== 'miss') state.wasHit = true;\n    await animate('shot', [cell], 'fleet', result.kind, result.kind === 'sunk' ? 1000 : 600);\n    notify(`敌方 ${coord(cell)}：${result.kind === 'miss' ? '落空' : result.kind === 'sunk' ? '我方舰船沉没' : result.cellCleared ? '我方中弹' : '装甲受损，尚未击穿'}。`, result.kind === 'miss' ? 'info' : 'warning');\n    if (result.defeated) { await lose('我方舰队已覆灭。'); return; }\n  }\n\n  if (state.round >= LIMITS[campaign.level - 1]) { await lose('作战轮数耗尽，敌军完成封锁。'); return; }\n  state.round += 1; state.phase = 'player';\n  await saveState();\n}\n\nasync function victory() {\n  if(state.phase==='victory')return;\n  state.phase = 'victory'; view = 'result';\n  const level = LEVELS[campaign.level - 1];\n  campaign.score += Math.max(0, state.levelScore) + 500 + (LIMITS[campaign.level - 1] - state.round) * 12;\n  state.pendingRewards=[level.reward,...(level.extraRewards||[])].filter(Boolean);\n  state.rewardCards=getLevelRewards(campaign.level);state.rewardsConfirmed=false;\n  await db.exec(`MERGE TABLE ${tableNames.notes} INTO ${campaign.notesTable} STRATEGY THEIRS`);\n  campaign.summaryRows = (await db.query(`SELECT kind, COUNT(*) AS total FROM ${campaign.notesTable} GROUP BY kind ORDER BY kind`)).rows;\n  await saveState();\n  notify(`第${campaign.level}关胜利。${level.reward ? `获得“${MEDALS[level.reward][0]}”勋章。` : '六关战役完成。'}`, 'hit');\n  showResult(campaign.level === 6 ? '六海域突破 · 战役完成' : '海域肃清 · 请领取勋章与装备',\n    level.reward ? REWARD_PROMPT : `本次海图 ${campaign.seed}，战术评分 ${campaign.score}；数据库汇总战役笔记 ${campaign.summaryRows.reduce((sum, row) => sum + Number(row.total), 0)} 条。`,\n    campaign.level \u003c 6 ? '携勋章进入下一关' : '全新海图再出航');\n}\n\nasync function confirmRewards() {\n  if(state?.phase!=='victory' || state.rewardsConfirmed)return;\n  if(state.pendingRewards.includes('mysql')) {\n    const sql=\"INSERT INTO capabilities(owner,skill,every_n) SELECT 'player',skill,every_n FROM capabilities WHERE owner='enemy' AND skill='double_fire' ON DUPLICATE KEY UPDATE every_n=VALUES(every_n)\";\n    await db.exec(sql);state.lastSql=sql;\n  }\n  for(const reward of state.pendingRewards)if(!campaign.medals.includes(reward))campaign.medals.push(reward);\n  state.rewardsConfirmed=true;await saveState();\n  notify(campaign.level\u003c6?'奖励已领取！勋章和新装备在下一关生效。':'战果已确认，六海域战役完成。','hit');\n}\n\nasync function advanceFromResult() {\n  if(state?.phase==='victory' && !state.rewardsConfirmed) {notify('请先确认领取本关勋章与装备。','warning');return;}\n  if(state.phase==='defeat')await rewind();\n  else if(state.phase==='victory' && campaign.level\u003c6){campaign.level++;await prepareLevel();}\n  else await startCampaign();\n}\n\nfunction iconCanvas(icon,label) {\n  const canvas=element('canvas','pixel-item-icon');canvas.width=canvas.height=32;\n  canvas.dataset.pixelIcon=icon;canvas.setAttribute('role','img');canvas.setAttribute('aria-label',label);\n  return canvas;\n}\n\nfunction paintIcon(canvas,id,frame=0) {\n  if(canvas.width!==32)canvas.width=32;if(canvas.height!==32)canvas.height=32;\n  const ctx=canvas.getContext('2d');ctx.imageSmoothingEnabled=false;ctx.clearRect(0,0,32,32);\n  drawPixelIcon(ctx,id,(32-ICON_SIZE)/2,(32-ICON_SIZE)/2,1,frame);\n}\n\nfunction renderRewards() {\n  const gallery=$('reward-gallery');if(!gallery)return;\n  const won=state?.phase==='victory';gallery.hidden=!won;\n  const nodes=[];\n  // 同时处理旧OPFS胜利存档，避免页顶再次复述卡片中的效果。\n  if(won && campaign.level\u003c6)$('result-copy').textContent=REWARD_PROMPT;\n  if(won)for(const card of getRewardDisplayCards(state.rewardCards)) {\n    const item=element('article','reward-card');item.dataset.rewardKind=card.kind;item.dataset.rewardId=card.id;\n    item.append(iconCanvas(card.icon,`${card.title}像素图标`));\n    const text=element('div','reward-content');\n    text.append(element('span','reward-type',card.kind==='medal'?'获得勋章':card.kind==='weapon'?'解锁新武器':'解锁战术技能'),element('h5','',card.title));\n    for(const unlock of card.relatedUnlocks)text.append(element('p','reward-unlock',`解锁${unlock.kind==='weapon'?'新武器':'战术技能'}：${unlock.title}`));\n    if(card.description)text.append(element('p','reward-effect',`游戏效果：${card.description}`));\n    if(card.featureDescription){\n      text.append(element('h6','reward-feature-title',`seekdb 特性 · ${card.featureTitle}`),element('p','reward-feature',card.featureDescription));\n      const link=element('a','reward-feature-link','查看官方介绍 ↗');link.href=card.featureUrl;link.target='_blank';link.rel='noopener noreferrer';text.append(link);\n    }\n    if(card.pattern)text.append(element('p','reward-pattern',`${card.pattern.size}×${card.pattern.size}范围 · ${card.pattern.cells.length}点`));\n    item.append(text);nodes.push(item);\n  }\n  if(won && !nodes.length) {\n    const item=element('article','reward-card');item.append(iconCanvas('trophy','六海域通关奖杯'));\n    const summary=element('div','reward-content');summary.append(element('h5','','六海域突破'),element('p','',`本次战役共收获${campaign.medals.length}枚勋章。确认战果，开启新的海域。`));item.append(summary);nodes.push(item);\n  }\n  gallery.replaceChildren(...nodes);\n  $('confirm-rewards').hidden=!won;$('confirm-rewards').disabled=busy||!won||state.rewardsConfirmed;\n  $('confirm-rewards').textContent=state?.rewardsConfirmed?'已确认领取':campaign?.level===6?'确认战果':'确认领取勋章与装备';\n  $('reward-feedback').textContent=!won?'':state.rewardsConfirmed?'已领取，可以继续出航。':'请查看上方勋章、新武器与技能说明，再确认领取。';\n  $('next-level').disabled=busy||won&&!state.rewardsConfirmed;\n}\n\nasync function lose(reason) {\n  state.phase = canRewind() ? 'defeat' : 'gameover'; view = 'result';\n  await saveState();\n  notify(reason + (canRewind() ? '本关还可重开一次。' : '本轮战役结束。'), 'error');\n  showResult(canRewind() ? '舰队失守 · 尚有一次试错机会' : 'Game Over · 本轮战役结束',\n    reason + (canRewind() ? FORK_DESCRIPTION : '重新出航将清空本轮勋章，生成不同的第一关。'),\n    canRewind() ? '试错机会 · 重开本关' : '重开新游戏');\n}\n\nasync function rewind() {\n  if (!state?.deploymentConfirmed || !tableNames?.checkpoint) throw new Error('请先确认舰队部署，再使用试错机会。');\n  if (!canRewind() || !['player', 'defeat'].includes(state.phase)) throw new Error('本关没有可用的试错机会：尚未解锁、已经使用、仍在冷却或当前无法行动。');\n  await db.exec(`MERGE TABLE ${tableNames.notes} INTO ${campaign.notesTable} STRATEGY THEIRS`);\n  const merged = await db.query(`SELECT id,level_no,round_no,kind,body FROM ${campaign.notesTable} ORDER BY id`);\n  notes = merged.rows.map(row => ({id: row.id, level: Number(row.level_no), round: Number(row.round_no),\n    kind: row.kind, message: row.body, previous: true})).reverse();\n  const nextLive = `live_restore_${campaign.id}_${campaign.level}_${++serial}`;\n  const forkSql = `FORK TABLE ${tableNames.checkpoint} TO ${nextLive}`;\n  await createDynamicTable(nextLive, forkSql, tableNames.checkpoint);\n  const restored = await db.query(`SELECT state_json FROM ${nextLive} WHERE id=1`);\n  state = JSON.parse(restored.rows[0].state_json);\n  state.enemy = createEnemyFleet({level: campaign.level, seed: state.enemySeed});\n  state.enemySector = generateEvidence({fleet: state.enemy, level: campaign.level, round: 1, seed: campaign.seed}).truth.targetSector;\n  if (state.activeSector) state.knowledge = state.sectorKnowledge[state.activeSector];\n  state.phase = 'player'; view = 'intel'; tableNames.live = nextLive;\n  const nextNotes = `notes_after_${campaign.id}_${campaign.level}_${serial}`;\n  await createDynamicTable(nextNotes, `FORK TABLE ${campaign.notesTable} TO ${nextNotes}`, campaign.notesTable); tableNames.notes = nextNotes;\n  targets=[];detailSelection={sample:'',keyword:''};state.lastSql=forkSql;\n  await dealEvidence(); await saveState();\n  campaign.rewinds[campaign.level] = 1; campaign.lastForkUseLevel = campaign.level;\n  $('result-panel').hidden = true;\n  notify('时间线已重置。敌舰布局不变，前分支笔记已 Merge 保留；本关重开次数剩余 0。', 'warning');\n  window.scrollTo(0, 0);\n}\n\nfunction showResult(title, message, action) {\n  $('result-title').textContent = title; $('result-copy').textContent = message;\n  $('next-level').textContent = action;\n  $('retry-level').textContent = '重开新游戏';\n  view = 'result'; $('result-panel').hidden = false;\n  window.scrollTo(0, 0);\n}\n\nfunction renderCards() {\n  const host=$('evidence-list'),task=reconTask();\n  if(!task||state?.phase==='deploy'){host.replaceChildren(element('p','record-placeholder','确认部署后接收本关资料。'));return;}\n  host.replaceChildren(...task.groups.map(group=>{\n    const section=element('section','retrieval-group');section.dataset.reconKind=group.kind;\n    section.append(element('h4','retrie